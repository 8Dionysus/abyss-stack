{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/abyss-stack/main/schemas/runtime-gateway-cache-status.schema.json",
  "title": "abyss-stack runtime gateway cache status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_type",
    "schema_version",
    "status_id",
    "generated_at",
    "target_surface",
    "cache_key_strategy",
    "normalization_rules",
    "inflight_state",
    "ttl_window",
    "bypass_reason",
    "hit_state",
    "recent_decisions",
    "boundary"
  ],
  "properties": {
    "surface_type": {
      "type": "string",
      "const": "runtime_gateway_cache_status"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "status_id": {
      "type": "string",
      "minLength": 3
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_name",
        "status_scope",
        "module_ref"
      ],
      "properties": {
        "service_name": {
          "type": "string",
          "enum": [
            "langchain-api",
            "langchain-api-llamacpp"
          ]
        },
        "status_scope": {
          "type": "string",
          "enum": [
            "gateway-local",
            "sidecar-local",
            "custom"
          ]
        },
        "module_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cache_key_strategy": {
      "type": "string",
      "enum": [
        "normalized_request_signature",
        "body_plus_selected_headers",
        "disabled"
      ]
    },
    "normalization_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inflight_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deduplication_enabled",
        "replay_mode",
        "active_request_count"
      ],
      "properties": {
        "deduplication_enabled": {
          "type": "boolean"
        },
        "replay_mode": {
          "type": "string",
          "enum": [
            "coalesce_waiters",
            "replay_completed_only",
            "disabled"
          ]
        },
        "active_request_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ttl_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_ttl_seconds",
        "stale_after_seconds",
        "eviction_policy"
      ],
      "properties": {
        "completed_ttl_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "stale_after_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "eviction_policy": {
          "type": "string",
          "enum": [
            "ttl_only",
            "lru",
            "manual",
            "disabled"
          ]
        }
      }
    },
    "bypass_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "no_cache_header",
        "sensitive_request",
        "operator_bypass",
        "uncacheable_request"
      ]
    },
    "hit_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "hit_rate_1h",
        "last_decision_at"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "hit",
            "miss",
            "inflight_replay",
            "bypass"
          ]
        },
        "hit_rate_1h": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "last_decision_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "recent_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "decision",
          "cache_control",
          "bypass_reason"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 3
          },
          "decision": {
            "type": "string",
            "enum": [
              "hit",
              "miss",
              "inflight_replay",
              "bypass"
            ]
          },
          "cache_control": {
            "type": "string",
            "minLength": 1
          },
          "bypass_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "no_cache_header",
              "sensitive_request",
              "operator_bypass",
              "uncacheable_request"
            ]
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supports_runtime_claims_only",
        "does_not_prove"
      ],
      "properties": {
        "supports_runtime_claims_only": {
          "type": "boolean",
          "const": true
        },
        "does_not_prove": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
