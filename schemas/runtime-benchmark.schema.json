{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abyss-stack/schemas/runtime-benchmark.schema.json",
  "title": "abyss-stack runtime benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_type",
    "schema_version",
    "benchmark_id",
    "benchmark_family",
    "benchmark_label",
    "started_at_utc",
    "finished_at_utc",
    "runner",
    "system_under_test",
    "runtime_selection",
    "environment",
    "fixtures",
    "metrics",
    "evidence",
    "verdict_boundary"
  ],
  "properties": {
    "surface_type": {
      "type": "string",
      "const": "runtime_benchmark_manifest"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 3
    },
    "benchmark_family": {
      "type": "string",
      "enum": [
        "startup-load",
        "latency-single-turn",
        "throughput-stream",
        "memory-pressure",
        "context-stress",
        "availability-recovery",
        "profile-parity",
        "backend-parity"
      ]
    },
    "benchmark_label": {
      "type": "string",
      "minLength": 1
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "measurement_contract",
        "invocation_ref"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "measurement_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "warmup_runs",
            "measured_runs",
            "timeout_ms",
            "retry_policy"
          ],
          "properties": {
            "warmup_runs": {
              "type": "integer",
              "minimum": 0
            },
            "measured_runs": {
              "type": "integer",
              "minimum": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1
            },
            "retry_policy": {
              "type": "string",
              "minLength": 1
            },
            "streaming_enabled": {
              "type": "boolean"
            }
          }
        },
        "invocation_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "system_under_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_kind",
        "target_label",
        "serving_backend",
        "profile_class",
        "context_budget_class",
        "quantization_or_runtime_variant"
      ],
      "properties": {
        "target_kind": {
          "type": "string",
          "enum": [
            "local-model",
            "gateway-route",
            "backend-profile",
            "other"
          ]
        },
        "target_label": {
          "type": "string",
          "minLength": 1
        },
        "serving_backend": {
          "type": "string",
          "enum": [
            "ollama",
            "ovms",
            "litellm",
            "other"
          ]
        },
        "profile_class": {
          "type": "string",
          "enum": [
            "spark",
            "workhorse",
            "deep",
            "archive",
            "custom"
          ]
        },
        "context_budget_class": {
          "type": "string",
          "minLength": 1
        },
        "quantization_or_runtime_variant": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_type",
        "selection_name",
        "rendered_services_ref",
        "smoke_ref"
      ],
      "properties": {
        "selection_type": {
          "type": "string",
          "enum": [
            "profile",
            "preset",
            "profile-set",
            "custom"
          ]
        },
        "selection_name": {
          "type": "string",
          "minLength": 1
        },
        "rendered_services_ref": {
          "type": "string",
          "minLength": 1
        },
        "rendered_config_ref": {
          "type": "string",
          "minLength": 1
        },
        "smoke_ref": {
          "type": "string",
          "minLength": 1
        },
        "internal_probe_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "kernel_or_runtime",
        "cpu_model",
        "system_ram_gb",
        "accelerators",
        "vault_mounted",
        "network_posture"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "kernel_or_runtime": {
          "type": "string",
          "minLength": 1
        },
        "cpu_model": {
          "type": "string",
          "minLength": 1
        },
        "system_ram_gb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "accelerators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "label"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "cpu-only",
                  "gpu",
                  "npu",
                  "vpu",
                  "other"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "memory_gb": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "vault_mounted": {
          "type": "boolean"
        },
        "network_posture": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_family",
        "case_count",
        "input_shape",
        "token_budget_notes"
      ],
      "properties": {
        "fixture_family": {
          "type": "string",
          "minLength": 1
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "input_shape": {
          "type": "string",
          "minLength": 1
        },
        "token_budget_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_contract",
        "summary"
      ],
      "properties": {
        "unit_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latency_unit",
            "throughput_unit",
            "memory_unit"
          ],
          "properties": {
            "latency_unit": {
              "type": "string",
              "const": "ms"
            },
            "throughput_unit": {
              "type": "string",
              "const": "tokens_per_second"
            },
            "memory_unit": {
              "type": "string",
              "const": "gb"
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "success_rate"
          ],
          "properties": {
            "startup_ms": {
              "type": "number",
              "minimum": 0
            },
            "first_token_ms_p50": {
              "type": "number",
              "minimum": 0
            },
            "first_token_ms_p95": {
              "type": "number",
              "minimum": 0
            },
            "completion_ms_p50": {
              "type": "number",
              "minimum": 0
            },
            "completion_ms_p95": {
              "type": "number",
              "minimum": 0
            },
            "tokens_per_second_p50": {
              "type": "number",
              "minimum": 0
            },
            "tokens_per_second_p95": {
              "type": "number",
              "minimum": 0
            },
            "peak_ram_gb": {
              "type": "number",
              "minimum": 0
            },
            "peak_vram_gb": {
              "type": "number",
              "minimum": 0
            },
            "max_stable_context_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "restart_success_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "success_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "error_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "metric_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_ref",
        "notes_ref",
        "raw_artifact_refs"
      ],
      "properties": {
        "summary_ref": {
          "type": "string",
          "minLength": 1
        },
        "notes_ref": {
          "type": "string",
          "minLength": 1
        },
        "raw_artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "plot_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "comparison_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supports_runtime_claims_only",
        "does_not_prove"
      ],
      "properties": {
        "supports_runtime_claims_only": {
          "type": "boolean",
          "const": true
        },
        "does_not_prove": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
