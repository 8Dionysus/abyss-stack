{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa.invalid/abyss-stack/schemas/runtime-a2a-return-closeout-dry-run.schema.json",
  "title": "abyss-stack runtime A2A return closeout dry-run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "capture_mode",
    "dry_run",
    "live_automation",
    "exported_at",
    "exported_by",
    "record_id",
    "title",
    "summary",
    "closeout_id",
    "session_ref",
    "request_kind",
    "source_input_ref",
    "source_input_sha256",
    "reviewed",
    "reviewed_artifact_path",
    "a2a_child",
    "return_plan",
    "checkpoint_bridge_plan",
    "runtime_receipt_candidate",
    "memo_export_candidates",
    "eval_export_candidates",
    "contract_refs",
    "boundary_notes",
    "candidate_payload"
  ],
  "properties": {
    "artifact_kind": {
      "const": "aoa.runtime-a2a-return-closeout-dry-run"
    },
    "schema_version": {
      "const": "1"
    },
    "capture_mode": {
      "const": "private"
    },
    "dry_run": {
      "const": true
    },
    "live_automation": {
      "const": false
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "exported_by": {
      "const": "scripts/aoa-a2a-return-closeout-dry-run"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "closeout_id": {
      "type": "string",
      "minLength": 1
    },
    "session_ref": {
      "type": ["string", "null"]
    },
    "request_kind": {
      "const": "a2a_wave5_closeout_request"
    },
    "source_input_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewed": {
      "const": true
    },
    "reviewed_artifact_path": {
      "type": ["string", "null"]
    },
    "a2a_child": {
      "type": "object"
    },
    "return_plan": {
      "type": "object"
    },
    "checkpoint_bridge_plan": {
      "type": "object"
    },
    "runtime_receipt_candidate": {
      "type": "object"
    },
    "memo_export_candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "eval_export_candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "boundary_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidate_payload": {
      "type": "object"
    }
  }
}
