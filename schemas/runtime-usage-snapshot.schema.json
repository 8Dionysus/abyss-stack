{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/abyss-stack/main/schemas/runtime-usage-snapshot.schema.json",
  "title": "abyss-stack runtime usage snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_type",
    "schema_version",
    "snapshot_id",
    "generated_at",
    "target_surface",
    "policy_mode",
    "request_window",
    "session_window",
    "hourly_window",
    "daily_window",
    "degrade_state",
    "strict_stop",
    "baseline_cost_estimate",
    "savings_estimate",
    "reset_at",
    "boundary"
  ],
  "properties": {
    "surface_type": {
      "type": "string",
      "const": "runtime_usage_snapshot"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 3
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_class",
        "service_name",
        "module_ref"
      ],
      "properties": {
        "profile_class": {
          "type": "string",
          "enum": [
            "spark",
            "workhorse",
            "deep",
            "archive",
            "custom"
          ]
        },
        "service_name": {
          "type": "string",
          "enum": [
            "langchain-api",
            "langchain-api-llamacpp"
          ]
        },
        "module_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy_mode": {
      "type": "string",
      "enum": [
        "observe_only",
        "soft_cap",
        "graceful_degrade",
        "strict_stop"
      ]
    },
    "request_window": {
      "$ref": "#/$defs/window"
    },
    "session_window": {
      "$ref": "#/$defs/window"
    },
    "hourly_window": {
      "$ref": "#/$defs/window"
    },
    "daily_window": {
      "$ref": "#/$defs/window"
    },
    "degrade_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "mode",
        "reason"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "graceful_degrade",
            "strict_stop"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "strict_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "trigger_window",
        "reason"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "trigger_window": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "request",
            "session",
            "hourly",
            "daily"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "baseline_cost_estimate": {
      "$ref": "#/$defs/costEstimate"
    },
    "savings_estimate": {
      "$ref": "#/$defs/costEstimate"
    },
    "reset_at": {
      "type": "string",
      "format": "date-time"
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supports_runtime_claims_only",
        "does_not_prove"
      ],
      "properties": {
        "supports_runtime_claims_only": {
          "type": "boolean",
          "const": true
        },
        "does_not_prove": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_label",
        "limit_units",
        "used_units",
        "remaining_units"
      ],
      "properties": {
        "window_label": {
          "type": "string",
          "minLength": 1
        },
        "limit_units": {
          "type": "integer",
          "minimum": 0
        },
        "used_units": {
          "type": "integer",
          "minimum": 0
        },
        "remaining_units": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "costEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "value_units",
        "comparison_basis"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "const": "normalized_cost_units"
        },
        "value_units": {
          "type": "integer",
          "minimum": 0
        },
        "comparison_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
