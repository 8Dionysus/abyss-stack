{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/abyss-stack/main/schemas/runtime-governed-execution-canary-catalog.schema.json",
  "title": "abyss-stack governed execution canary catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_type",
    "schema_version",
    "catalog_id",
    "canaries"
  ],
  "properties": {
    "surface_type": {
      "type": "string",
      "const": "runtime_governed_execution_canary_catalog"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "canaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canary_id",
          "target_id",
          "title",
          "goal",
          "playbook_id",
          "task_class",
          "profile_class"
        ],
        "properties": {
          "canary_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "target_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "playbook_id": {
            "type": "string",
            "pattern": "^AOA-P-[0-9]{4}$"
          },
          "task_class": {
            "type": "string",
            "enum": [
              "docs_only",
              "policy_surface",
              "validation_tightening",
              "governed_lane",
              "generated_surface"
            ]
          },
          "profile_class": {
            "type": "string",
            "enum": [
              "spark",
              "workhorse",
              "deep",
              "archive"
            ]
          },
          "memo": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  }
}
