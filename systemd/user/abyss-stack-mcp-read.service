[Unit]
Description=abyss-stack MCP read observation plane
Documentation=file:///srv/AbyssOS/abyss-stack/Configs/mcp/services/abyss-stack-mcp/README.md
Conflicts=abyss-stack-mcp-read-bootstrap.service
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.source-projection.lock
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-provision.lock
ConditionPathExists=/srv/AbyssOS/abyss-stack/Logs/mcp/audit/policy-read.jsonl
ConditionPathExists=/srv/AbyssOS/abyss-stack/Logs/mcp/observations/current.json
ConditionPathExists=/srv/AbyssOS/.aoa/organ-access/organ-registry.v2.source.json
ConditionPathExists=/srv/AbyssOS/abyss-stack/Logs/mcp/admission/managed-contours.json
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/srv/AbyssOS/abyss-stack/Configs/mcp/services/abyss-stack-mcp
Environment=ABYSS_STACK_MCP_POLICY_FAMILY=read
Environment=ABYSS_STACK_MCP_OBSERVATION_PATH=/srv/AbyssOS/abyss-stack/Logs/mcp/observations/current.json
Environment=ABYSS_STACK_ORCHESTRATION_ROOT=/srv/AbyssOS/abyss-stack/Logs/mcp/cross-organ-orchestrations
Environment=AOA_MCP_TRANSPORT=streamable-http
Environment=AOA_MCP_HOST=127.0.0.1
Environment=AOA_MCP_PORT=5431
Environment=ABYSS_STACK_MCP_REQUIRE_AUTH_MANIFEST=1
Environment=ABYSS_STACK_MCP_AUDIT_JOURNAL_PATH=/srv/AbyssOS/abyss-stack/Logs/mcp/audit/policy-read.jsonl
Environment=ABYSS_STACK_MCP_REQUIRE_AUDIT_JOURNAL=1
Environment=ABYSS_STACK_MCP_TASKS_ENABLED=1
Environment=ABYSS_STACK_MCP_TASK_ROOT=/srv/AbyssOS/abyss-stack/Logs/mcp/tasks/abyss-stack-read
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONHOME=
Environment=PYTHONPATH=
LoadCredential=abyss-stack-mcp-read-bearer-token:/srv/AbyssOS/abyss-stack/Secrets/Configs/abyss-stack-mcp-read-bearer-token
LoadCredential=abyss-stack-mcp-auth-manifest.json:/srv/AbyssOS/abyss-stack/Secrets/Configs/abyss-stack-mcp-auth-manifest.json
ExecCondition=/usr/bin/test -x /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python
ExecCondition=/srv/AbyssOS/abyss-stack/Configs/scripts/aoa-install-systemd --verify-abyss-stack-mcp-runtime=read
ExecCondition=/usr/bin/flock --shared --no-fork /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-provision.lock /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python -I -B -m abyss_stack_mcp.preflight --catalog /srv/AbyssOS/abyss-stack/Logs/mcp/admission/managed-contours.json --binding-id abyss-stack-read
ExecStart=/usr/bin/flock --shared --no-fork /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.source-projection.lock /usr/bin/flock --shared --no-fork /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-provision.lock /usr/bin/env /srv/AbyssOS/abyss-stack/Configs/scripts/aoa-install-systemd --launch-verified-abyss-stack-mcp=read
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/AbyssOS/abyss-stack/Logs/mcp/audit/policy-read.jsonl /srv/AbyssOS/abyss-stack/Logs/mcp/tasks/abyss-stack-read
InaccessiblePaths=/srv/AbyssOS/abyss-stack/Logs/mcp/audit/policy-candidate.jsonl
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=default.target
