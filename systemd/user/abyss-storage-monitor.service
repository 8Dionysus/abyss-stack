[Unit]
Description=Abyss Machine read-only storage monitor
Documentation=file:///etc/abyss-machine/AGENTS.md
Documentation=file:///var/lib/abyss-machine/storage/AGENTS.md

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
TimeoutStartSec=3min
ExecStart=/usr/local/bin/abyss-machine resource launch --class medium --kind indexing --unattended --timeout 110 --memory-demand-mib 2048 --demand-key abyss-machine:storage-monitor:hourly --demand-owner abyss-machine-storage --estimate-source measured-systemd-unit-p99 --estimate-confidence high --success-on-block --no-thermal-sample --json -- /usr/local/bin/abyss-machine storage monitor --json
StandardOutput=null
StandardError=journal
