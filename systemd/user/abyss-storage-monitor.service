[Unit]
Description=Abyss Machine read-only storage monitor
Documentation=file:///etc/abyss-machine/AGENTS.md
Documentation=file:///var/lib/abyss-machine/storage/AGENTS.md

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
TimeoutStartSec=2min
ExecStart=/usr/local/bin/abyss-machine storage monitor --json
StandardOutput=null
StandardError=journal
