[Unit]
Description=Abyss Gemma4 Spark resident monitor tick
Documentation=file:/etc/abyss-machine/AGENTS.md
Documentation=file:/var/lib/abyss-machine/ai/llm/AGENTS.md

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
TimeoutStartSec=45s
ExecStart=/srv/abyss-machine/tools/abyss-gemma4-spark-resident monitor --json
StandardOutput=null
StandardError=journal
