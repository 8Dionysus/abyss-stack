[Unit]
Description=Abyss Machine topology audit
Documentation=file:///etc/abyss-machine/AGENTS.md
Documentation=file:///etc/abyss-machine/TOPOLOGY.md
Documentation=file:///var/lib/abyss-machine/topology/AGENTS.md

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
TimeoutStartSec=90s
ExecStart=/usr/local/bin/abyss-machine topology audit --json
StandardOutput=null
StandardError=journal
