[Unit]
Description=Abyss Gemma4 Spark resident useful jobs tick
Documentation=file:/etc/abyss-machine/AGENTS.md
Documentation=file:/var/lib/abyss-machine/ai/llm/AGENTS.md

[Service]
Type=oneshot
Nice=12
IOSchedulingClass=idle
CPUWeight=15
IOWeight=15
TimeoutStartSec=12min
ExecStart=/usr/local/bin/abyss-machine resource launch --class medium --kind agent --unattended --timeout 600 --success-on-block --no-thermal-sample --json -- /srv/abyss-machine/tools/abyss-gemma4-spark-resident jobs --limit 4 --json
StandardOutput=null
StandardError=journal
