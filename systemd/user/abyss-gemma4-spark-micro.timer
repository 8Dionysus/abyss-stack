[Unit]
Description=Run Abyss Gemma4 Spark resident micro work frequently
Documentation=file:/etc/abyss-machine/AGENTS.md
Documentation=file:/var/lib/abyss-machine/ai/llm/AGENTS.md

[Timer]
OnBootSec=8min
OnUnitActiveSec=12min
AccuracySec=2min
RandomizedDelaySec=90s
Persistent=true
Unit=abyss-gemma4-spark-micro.service

[Install]
WantedBy=timers.target
