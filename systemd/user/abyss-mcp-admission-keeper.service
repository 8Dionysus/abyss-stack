[Unit]
Description=Refresh OS Abyss MCP admission state without issuing owner authority
Documentation=file:///srv/AbyssOS/abyss-stack/Configs/mcp/services/abyss-stack-mcp/README.md
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python
ConditionPathExists=/srv/AbyssOS/.aoa/organ-access/organ-registry.v2.source.json
ConditionPathExists=/srv/AbyssOS/abyss-stack/Logs/mcp/deployments/latest.json
ConditionPathExists=/srv/AbyssOS/abyss-stack/Logs/mcp/canaries/latest

[Service]
Type=oneshot
WorkingDirectory=/srv/AbyssOS/abyss-stack/Configs/mcp/services/abyss-stack-mcp
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONHOME=
Environment=PYTHONPATH=
ExecStart=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python -I -B -m abyss_stack_mcp.admission_automation --registry /srv/AbyssOS/.aoa/organ-access/organ-registry.v2.source.json --deployment-manifest /srv/AbyssOS/abyss-stack/Logs/mcp/deployments/latest.json --runtime-targets /srv/AbyssOS/abyss-stack/Configs/mcp/services/abyss-stack-mcp/src/abyss_stack_mcp/runtime-targets.v1.json --canary-root /srv/AbyssOS/abyss-stack/Logs/mcp/canaries/latest --deployed-root /srv/AbyssOS/abyss-stack --output-root /srv/AbyssOS/abyss-stack/Logs/mcp/admission
Nice=10
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
TimeoutStartSec=180s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/AbyssOS/abyss-stack/Logs/mcp/admission
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077
StandardOutput=journal
StandardError=journal
