[Unit]
Description=Periodic Abyss nervous-system local index rebuild
Documentation=file:///etc/abyss-machine/AGENTS.md
Documentation=file:///var/lib/abyss-machine/nervous/AGENTS.md

[Timer]
OnBootSec=5min
OnUnitActiveSec=45min
AccuracySec=5min
RandomizedDelaySec=3min
Persistent=true
Unit=abyss-nervous-index-build.service

[Install]
WantedBy=timers.target
