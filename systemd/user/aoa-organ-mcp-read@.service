[Unit]
Description=AoA owner-bounded MCP read contour (%i)
Documentation=file:///srv/AbyssOS/abyss-stack/Configs/mcp/services/README.md
PartOf=aoa-mcp-http.service
Conflicts=aoa-organ-mcp-read-bootstrap@%i.service
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-provision.lock
ConditionPathExists=/srv/AbyssOS/.aoa/organ-access/organ-registry.v2.source.json
ConditionPathExists=/srv/AbyssOS/abyss-stack/Logs/mcp/admission/managed-contours.json
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/srv/AbyssOS
Environment=AOA_WORKSPACE_ROOT=/srv/AbyssOS
Environment=AOA_ABYSS_STACK_ROOT=/srv/AbyssOS/abyss-stack
Environment=AOA_KAG_ARTIFACT_ROOT=/srv/AbyssOS/abyss-stack/Knowledge/kag/repo-self/cas
Environment=AOA_MCP_TRANSPORT=streamable-http
Environment=AOA_MCP_HOST=127.0.0.1
Environment=AOA_MCP_POLICY_FAMILY=read
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=%i-mcp-read-bearer-token:/srv/AbyssOS/abyss-stack/Secrets/Configs/%i-mcp-read-bearer-token
ExecCondition=/usr/bin/flock --shared --no-fork /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-provision.lock /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python -I -B -m abyss_stack_mcp.preflight --catalog /srv/AbyssOS/abyss-stack/Logs/mcp/admission/managed-contours.json --binding-id %i-read
ExecStart=/usr/bin/flock --shared --no-fork /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-provision.lock /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python -I -B -m abyss_stack_mcp.process_launcher --executable /srv/AbyssOS/.codex/bin/%i-mcp-server.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=default.target
