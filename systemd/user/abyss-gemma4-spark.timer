[Unit]
Description=Ensure Abyss Gemma4 Spark resident candidate is started when gates allow
Documentation=file:/etc/abyss-machine/AGENTS.md
Documentation=file:/var/lib/abyss-machine/ai/llm/AGENTS.md

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true
Unit=abyss-gemma4-spark.service

[Install]
WantedBy=timers.target
