[Unit]
Description=AoA memo MCP candidate-only contour
Documentation=file:///srv/AbyssOS/abyss-stack/Configs/mcp/services/aoa-memo-mcp/README.md
PartOf=aoa-mcp-http.service
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-operation.lock
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-provision.lock
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/srv/AbyssOS
Environment=AOA_WORKSPACE_ROOT=/srv/AbyssOS
Environment=AOA_ABYSS_STACK_ROOT=/srv/AbyssOS/abyss-stack/Configs
Environment=AOA_MCP_TRANSPORT=streamable-http
Environment=AOA_MCP_HOST=127.0.0.1
Environment=AOA_MCP_PORT=5434
Environment=AOA_MCP_POLICY_FAMILY=candidate
Environment="AOA_MEMO_MCP_CANDIDATE_ROOTS=/srv/AbyssOS/Agents-of-Abyss/memo:/srv/AbyssOS/Tree-of-Sophia/memo:/srv/AbyssOS/abyss-stack/Configs/memo:/srv/AbyssOS/aoa-agents/memo:/srv/AbyssOS/aoa-evals/memo:/srv/AbyssOS/aoa-playbooks/memo:/srv/AbyssOS/aoa-techniques/memo:/var/lib/abyss-machine/memo"
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONHOME=
Environment=PYTHONPATH=
LoadCredential=aoa-memo-mcp-candidate-bearer-token:/srv/AbyssOS/abyss-stack/Secrets/Configs/aoa-memo-mcp-candidate-bearer-token
ExecStart=/usr/bin/flock --shared --no-fork /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-operation.lock /usr/bin/flock --shared --no-fork /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-provision.lock /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python -I -B -m abyss_stack_mcp.process_launcher --executable /srv/AbyssOS/.codex/bin/aoa-memo-mcp-server.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/srv/AbyssOS/Agents-of-Abyss/memo/candidates
ReadWritePaths=-/srv/AbyssOS/Agents-of-Abyss/memo/exports
ReadWritePaths=-/srv/AbyssOS/Agents-of-Abyss/memo/receipts
ReadWritePaths=-/srv/AbyssOS/Agents-of-Abyss/memo/INDEX.md
ReadWritePaths=-/srv/AbyssOS/Agents-of-Abyss/memo/index.min.json
ReadWritePaths=-/srv/AbyssOS/Tree-of-Sophia/memo/candidates
ReadWritePaths=-/srv/AbyssOS/Tree-of-Sophia/memo/exports
ReadWritePaths=-/srv/AbyssOS/Tree-of-Sophia/memo/receipts
ReadWritePaths=-/srv/AbyssOS/Tree-of-Sophia/memo/INDEX.md
ReadWritePaths=-/srv/AbyssOS/Tree-of-Sophia/memo/index.min.json
ReadWritePaths=-/srv/AbyssOS/abyss-stack/Configs/memo/candidates
ReadWritePaths=-/srv/AbyssOS/abyss-stack/Configs/memo/exports
ReadWritePaths=-/srv/AbyssOS/abyss-stack/Configs/memo/receipts
ReadWritePaths=-/srv/AbyssOS/abyss-stack/Configs/memo/INDEX.md
ReadWritePaths=-/srv/AbyssOS/abyss-stack/Configs/memo/index.min.json
ReadWritePaths=-/srv/AbyssOS/aoa-agents/memo/candidates
ReadWritePaths=-/srv/AbyssOS/aoa-agents/memo/exports
ReadWritePaths=-/srv/AbyssOS/aoa-agents/memo/receipts
ReadWritePaths=-/srv/AbyssOS/aoa-agents/memo/INDEX.md
ReadWritePaths=-/srv/AbyssOS/aoa-agents/memo/index.min.json
ReadWritePaths=-/srv/AbyssOS/aoa-evals/memo/candidates
ReadWritePaths=-/srv/AbyssOS/aoa-evals/memo/exports
ReadWritePaths=-/srv/AbyssOS/aoa-evals/memo/receipts
ReadWritePaths=-/srv/AbyssOS/aoa-evals/memo/INDEX.md
ReadWritePaths=-/srv/AbyssOS/aoa-evals/memo/index.min.json
ReadWritePaths=-/srv/AbyssOS/aoa-playbooks/memo/candidates
ReadWritePaths=-/srv/AbyssOS/aoa-playbooks/memo/exports
ReadWritePaths=-/srv/AbyssOS/aoa-playbooks/memo/receipts
ReadWritePaths=-/srv/AbyssOS/aoa-playbooks/memo/INDEX.md
ReadWritePaths=-/srv/AbyssOS/aoa-playbooks/memo/index.min.json
ReadWritePaths=-/srv/AbyssOS/aoa-techniques/memo/candidates
ReadWritePaths=-/srv/AbyssOS/aoa-techniques/memo/exports
ReadWritePaths=-/srv/AbyssOS/aoa-techniques/memo/receipts
ReadWritePaths=-/srv/AbyssOS/aoa-techniques/memo/INDEX.md
ReadWritePaths=-/srv/AbyssOS/aoa-techniques/memo/index.min.json
ReadWritePaths=-/var/lib/abyss-machine/memo/candidates
ReadWritePaths=-/var/lib/abyss-machine/memo/exports
ReadWritePaths=-/var/lib/abyss-machine/memo/receipts
ReadWritePaths=-/var/lib/abyss-machine/memo/INDEX.md
ReadWritePaths=-/var/lib/abyss-machine/memo/index.min.json
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=default.target
