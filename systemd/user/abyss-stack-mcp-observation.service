[Unit]
Description=Produce the bounded abyss-stack MCP runtime observation
Documentation=file:///srv/AbyssOS/abyss-stack/Configs/mcp/services/abyss-stack-mcp/README.md
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-operation.lock
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-provision.lock
ConditionPathExists=/srv/AbyssOS/abyss-stack/Logs/mcp/deployments/latest.json
ConditionPathExists=/srv/AbyssOS/.aoa/organ-access/organ-registry.v2.source.json
ConditionPathIsDirectory=/srv/AbyssOS/abyss-stack/Logs/mcp/observations

[Service]
Type=oneshot
WorkingDirectory=/srv/AbyssOS/abyss-stack/Configs/mcp/services/abyss-stack-mcp
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONHOME=
Environment=PYTHONPATH=
ExecStart=/usr/bin/flock --shared --no-fork /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-operation.lock /usr/bin/flock --shared --no-fork /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-provision.lock /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python -I -B -m abyss_stack_mcp.observation --deployment-manifest /srv/AbyssOS/abyss-stack/Logs/mcp/deployments/latest.json --registry /srv/AbyssOS/.aoa/organ-access/organ-registry.v2.source.json --output /srv/AbyssOS/abyss-stack/Logs/mcp/observations/current.json --overlay /srv/AbyssOS/abyss-stack/Logs/mcp/observations/evidence-overlay.json --ttl-seconds 300
Nice=10
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
TimeoutStartSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/AbyssOS/abyss-stack/Logs/mcp/observations
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077
StandardOutput=journal
StandardError=journal
