[Unit]
Description=AoA evals MCP candidate-only local-port contour
Documentation=file:///srv/AbyssOS/abyss-stack/Configs/mcp/services/aoa-evals-mcp/README.md
PartOf=aoa-mcp-http.service
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-operation.lock
ConditionPathExists=/srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-provision.lock
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/srv/AbyssOS
Environment=AOA_WORKSPACE_ROOT=/srv/AbyssOS
Environment=AOA_EVALS_ROOT=/srv/AbyssOS/aoa-evals
Environment=AOA_ABYSS_STACK_ROOT=/srv/AbyssOS/abyss-stack/Configs
Environment=AOA_MCP_TRANSPORT=streamable-http
Environment=AOA_MCP_HOST=127.0.0.1
Environment=AOA_MCP_PORT=5435
Environment=AOA_MCP_POLICY_FAMILY=candidate
Environment="AOA_EVALS_MCP_CANDIDATE_ROOTS=/srv/AbyssOS/8Dionysus/evals:/srv/AbyssOS/Agents-of-Abyss/evals:/srv/AbyssOS/Tree-of-Sophia/evals:/srv/AbyssOS/aoa-agents/evals:/srv/AbyssOS/aoa-kag/evals:/srv/AbyssOS/aoa-memo/evals:/srv/AbyssOS/aoa-playbooks/evals:/srv/AbyssOS/aoa-sdk/evals:/srv/AbyssOS/aoa-skills/evals:/srv/AbyssOS/aoa-stats/evals:/srv/AbyssOS/aoa-techniques/evals:/srv/AbyssOS/connectors/aoa-4pda-connector/evals:/srv/AbyssOS/connectors/aoa-course-connector/evals:/srv/AbyssOS/connectors/aoa-discord-connector/evals:/srv/AbyssOS/connectors/aoa-stackoverflow-connector/evals:/srv/AbyssOS/connectors/aoa-telegram-connector/evals:/srv/AbyssOS/connectors/aoa-xda-connector/evals"
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONHOME=
Environment=PYTHONPATH=
LoadCredential=aoa-evals-mcp-candidate-bearer-token:/srv/AbyssOS/abyss-stack/Secrets/Configs/aoa-evals-mcp-candidate-bearer-token
ExecStart=/usr/bin/flock --shared --no-fork /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-operation.lock /usr/bin/flock --shared --no-fork /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/.runtime-provision.lock /srv/AbyssOS/abyss-stack/Services/abyss-stack-mcp/venv/bin/python -I -B -m abyss_stack_mcp.process_launcher --executable /srv/AbyssOS/.codex/bin/aoa-evals-mcp-server.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
