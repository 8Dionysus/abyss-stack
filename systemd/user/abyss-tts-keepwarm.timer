[Unit]
Description=Keep Abyss TTS warm without restarting protected services
Documentation=file:///etc/abyss-machine/AGENTS.md
Documentation=file:///var/lib/abyss-machine/memory/AGENTS.md

[Timer]
OnBootSec=12min
OnUnitActiveSec=20min
AccuracySec=5min
RandomizedDelaySec=2min
Persistent=false
Unit=abyss-tts-keepwarm.service

[Install]
WantedBy=timers.target
