[Unit]
Description=Guarded repair of the measured abyss-stack MCP runtime
Documentation=file:///srv/AbyssOS/abyss-stack/Configs/mcp/services/abyss-stack-mcp/README.md
ConditionPathExists=/srv/AbyssOS/abyss-stack/Configs/mcp/services/abyss-stack-mcp/requirements.lock
ConditionPathExists=/srv/AbyssOS/abyss-stack/Secrets/Configs/abyss-stack-mcp-runtime-auto-repair.enabled
ConditionPathExists=/usr/bin/python3

[Service]
Type=oneshot
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PIP_NO_CACHE_DIR=1
ExecStart=/srv/AbyssOS/abyss-stack/Configs/scripts/aoa-install-systemd --repair-abyss-stack-mcp-runtime
TimeoutStartSec=10min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/AbyssOS/abyss-stack/Services /srv/AbyssOS/abyss-stack/Logs/mcp
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
