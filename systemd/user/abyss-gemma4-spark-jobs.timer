[Unit]
Description=Run Abyss Gemma4 Spark resident useful jobs periodically
Documentation=file:/etc/abyss-machine/AGENTS.md
Documentation=file:/var/lib/abyss-machine/ai/llm/AGENTS.md

[Timer]
OnBootSec=20min
OnUnitActiveSec=2h
AccuracySec=5min
RandomizedDelaySec=20min
Persistent=true
Unit=abyss-gemma4-spark-jobs.service

[Install]
WantedBy=timers.target
