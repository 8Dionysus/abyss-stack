[Unit]
Description=Abyss nervous-system local index rebuild
Documentation=file:///etc/abyss-machine/AGENTS.md
Documentation=file:///var/lib/abyss-machine/nervous/AGENTS.md

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
CPUWeight=30
IOWeight=20
MemoryHigh=512M
TimeoutStartSec=360s
Environment=ABYSS_NERVOUS_INDEX_TRIGGER=timer
ExecStart=/usr/local/bin/abyss-machine resource launch --class medium --kind indexing --unattended --timeout 300 --success-on-block --json -- /usr/local/bin/abyss-machine nervous index-build --json
StandardOutput=null
StandardError=journal
