[Unit]
Description=Abyss Gemma4 Spark resident micro work tick
Documentation=file:///etc/abyss-machine/AGENTS.md
Documentation=file:///var/lib/abyss-machine/ai/llm/AGENTS.md

[Service]
Type=oneshot
Nice=12
IOSchedulingClass=idle
CPUWeight=12
IOWeight=12
MemoryHigh=512M
TimeoutStartSec=6min
Environment=ABYSS_GEMMA4_SPARK_SERVING_OWNER=abyss-stack
Environment=ABYSS_GEMMA4_SPARK_BASE_URL=http://127.0.0.1:11435
Environment=ABYSS_GEMMA4_SPARK_ALLOW_LOCAL_FALLBACK=0
ExecStart=/usr/local/bin/abyss-machine resource launch --class light --kind agent --unattended --timeout 300 --success-on-block --no-thermal-sample --json -- /srv/abyss-machine/tools/abyss-gemma4-spark-resident micro --limit 4 --json
StandardOutput=null
StandardError=journal
