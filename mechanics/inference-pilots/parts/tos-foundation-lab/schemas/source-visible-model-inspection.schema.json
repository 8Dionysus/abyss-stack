{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abyss-stack/mechanics/inference-pilots/tos-foundation-lab/source-visible-model-inspection.schema.json",
  "title": "Tree of Sophia source-visible non-human inspection receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inspection_id",
    "run_id",
    "experiment_id",
    "variant",
    "sample_id",
    "source_anchor_ref",
    "output_ref",
    "output_sha256",
    "source_visible",
    "maker",
    "inspection_scope",
    "observations",
    "decision",
    "inspected_at_utc",
    "review_authority",
    "promotion_authorized"
  ],
  "properties": {
    "schema_version": {"const": "tos_source_visible_model_inspection_v1"},
    "inspection_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "variant": {"enum": ["A", "B", "C"]},
    "sample_id": {"type": "string", "minLength": 1},
    "source_anchor_ref": {"type": "string", "minLength": 1},
    "output_ref": {"type": "string", "minLength": 1},
    "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_visible": {"const": true},
    "maker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maker_type", "agent_ref", "method"],
      "properties": {
        "maker_type": {"const": "model"},
        "agent_ref": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "inspection_scope": {"enum": ["bounded", "exhaustive"]},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "severity", "evidence", "origin"],
        "properties": {
          "category": {
            "enum": [
              "omission",
              "addition",
              "substitution",
              "reading-order",
              "anchor",
              "source-witness-contamination",
              "method-boundary",
              "uncertainty"
            ]
          },
          "severity": {"enum": ["minor", "major", "catastrophic", "uncertain"]},
          "evidence": {"type": "string", "minLength": 1},
          "origin": {"enum": ["method-introduced", "inherited-from-source-item", "unresolved"]}
        }
      }
    },
    "decision": {"enum": ["reject", "accept-with-limits", "uncertain", "abstain"]},
    "inspected_at_utc": {"type": "string", "format": "date-time"},
    "review_authority": {"const": "advisory-nonhuman"},
    "promotion_authorized": {"const": false}
  }
}
