{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abyss-stack/mechanics/inference-pilots/tos-foundation-lab/run-receipt.schema.json",
  "title": "Tree of Sophia foundation laboratory run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "variant",
    "experiment_spec_sha256",
    "status",
    "started_at_utc",
    "finished_at_utc",
    "preflight_ref",
    "source_refs",
    "sample_ids",
    "method_revision",
    "invocation_ref",
    "artifact_refs",
    "metric_refs",
    "manual_review_refs",
    "model_inspection_refs",
    "errors",
    "retention_decision",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"const": "tos_foundation_lab_run_receipt_v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "experiment_id": {"type": "string", "pattern": "^tos-[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$"},
    "variant": {"enum": ["A", "B", "C"]},
    "experiment_spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["prepared", "running", "completed", "completed-with-warnings", "failed", "stopped", "not-run", "awaiting-human-input", "awaiting-manual-review", "superseded"]},
    "started_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "finished_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "preflight_ref": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sample_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "method_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "runtime", "model", "artifact_digest"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "runtime": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "artifact_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "invocation_ref": {"type": ["string", "null"]},
    "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "metric_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "manual_review_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "model_inspection_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "retention_decision": {"enum": ["pending", "retain", "retain-metadata-only", "delete-after-review", "rejected-candidate"]},
    "authority_boundary": {"const": "runtime evidence only; no source, translation, semantic, rights, or canon promotion without Tree of Sophia human review"}
  }
}
