{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abyss-stack/mechanics/inference-pilots/tos-foundation-lab/runtime-manifest.schema.json",
  "title": "Tree of Sophia isolated laboratory runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_id",
    "experiment_id",
    "variant",
    "status",
    "created_at_utc",
    "runtime_root",
    "commands",
    "environment",
    "software",
    "artifacts",
    "artifact_set_sha256",
    "runtime_bytes",
    "licenses",
    "source_receipt_refs",
    "removal_route",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"const": "tos_foundation_lab_runtime_manifest_v1"},
    "runtime_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^tos-[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$"
    },
    "variant": {"enum": ["A", "B", "C"]},
    "status": {"const": "verified"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "runtime_root": {
      "type": "string",
      "pattern": "^/srv/abyss-machine/runtimes/tree-of-sophia-foundation-lab/[A-Za-z0-9._/-]+$"
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]*$"},
      "additionalProperties": {
        "type": "string",
        "pattern": "^/srv/abyss-machine/runtimes/tree-of-sophia-foundation-lab/"
      }
    },
    "environment": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]*$"},
      "additionalProperties": {"type": "string"}
    },
    "software": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "source_url", "source_sha256", "license"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "license": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "kind", "sha256", "bytes", "role"],
        "properties": {
          "relative_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "kind": {"enum": ["file", "symlink"]},
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifact_set_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_bytes": {"type": "integer", "minimum": 1},
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "spdx", "evidence_ref"],
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "spdx": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_receipt_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "removal_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "requires_operator_confirmation"],
      "properties": {
        "kind": {"const": "delete-exact-runtime-tree-after-retention-review"},
        "target": {
          "type": "string",
          "pattern": "^/srv/abyss-machine/runtimes/tree-of-sophia-foundation-lab/"
        },
        "requires_operator_confirmation": {"const": true}
      }
    },
    "authority_boundary": {
      "const": "runtime identity and fixity only; no software quality, source-text, or promotion verdict"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
