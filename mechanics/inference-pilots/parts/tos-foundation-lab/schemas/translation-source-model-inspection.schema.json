{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abyss-stack/mechanics/inference-pilots/tos-foundation-lab/translation-source-model-inspection.schema.json",
  "title": "Tree of Sophia pre-translation source selector model inspection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inspection_id",
    "experiment_id",
    "stage",
    "source_packet",
    "selector_method",
    "source_visible",
    "inspection_scope",
    "maker",
    "visual_review",
    "records",
    "summary",
    "translation_lanes",
    "recognized_comparator_visibility",
    "next_method_requirements",
    "inspected_at_utc",
    "review_authority",
    "promotion_authorized",
    "human_source_acceptance_count"
  ],
  "properties": {
    "$schema": {
      "const": "https://abyss-stack/mechanics/inference-pilots/tos-foundation-lab/translation-source-model-inspection.schema.json"
    },
    "schema_version": {"const": "tos_translation_source_model_inspection_v1"},
    "inspection_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "experiment_id": {"const": "tos-translation-foundation-v1"},
    "stage": {"const": "source-preparation"},
    "source_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "manifest_sha256",
        "candidate_set_sha256",
        "sample_plan_sha256"
      ],
      "properties": {
        "packet_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_set_sha256": {"$ref": "#/$defs/sha256"},
        "sample_plan_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "selector_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_scheme", "implementation"],
      "properties": {
        "plan_scheme": {"const": "tos-local-sentence-segmentation-v1"},
        "implementation": {
          "const": "first-body-p punctuation-boundary software proposal"
        }
      }
    },
    "source_visible": {"const": true},
    "inspection_scope": {"const": "exhaustive"},
    "maker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maker_type", "agent_ref", "method"],
      "properties": {
        "maker_type": {"const": "model"},
        "agent_ref": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "visual_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_witness_sha256",
        "render_method",
        "render_dpi",
        "expected_page_count",
        "inspected_page_count",
        "page_file_count_confirmed_manually"
      ],
      "properties": {
        "visual_witness_sha256": {"$ref": "#/$defs/sha256"},
        "render_method": {"const": "pdftoppm-full-page-png-rgb"},
        "render_dpi": {"const": 180},
        "expected_page_count": {"const": 30},
        "inspected_page_count": {"const": 30},
        "page_file_count_confirmed_manually": {"const": true}
      }
    },
    "records": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/record"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count",
        "decision_counts",
        "failure_mode_counts",
        "overall_result",
        "method_disposition"
      ],
      "properties": {
        "record_count": {"const": 30},
        "decision_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accept_with_limits", "reject", "uncertain", "abstain"],
          "properties": {
            "accept_with_limits": {"type": "integer", "minimum": 0},
            "reject": {"type": "integer", "minimum": 0},
            "uncertain": {"type": "integer", "minimum": 0},
            "abstain": {"type": "integer", "minimum": 0}
          }
        },
        "failure_mode_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading_selected",
            "page_start_tail",
            "ocr_contamination",
            "boundary_uncertain",
            "usable_only_with_limits"
          ],
          "properties": {
            "heading_selected": {"type": "integer", "minimum": 0},
            "page_start_tail": {"type": "integer", "minimum": 0},
            "ocr_contamination": {"type": "integer", "minimum": 0},
            "boundary_uncertain": {"type": "integer", "minimum": 0},
            "usable_only_with_limits": {"type": "integer", "minimum": 0}
          }
        },
        "overall_result": {"const": "reject-selector-method"},
        "method_disposition": {
          "const": "retain-v1-as-negative-baseline-and-design-v2"
        }
      }
    },
    "translation_lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_only", "ai_only", "ai_human"],
      "properties": {
        "human_only": {"const": "awaiting-real-human-source-input"},
        "ai_only": {"const": "blocked-pending-human-source-acceptance"},
        "ai_human": {"const": "blocked-pending-independent-drafts"}
      }
    },
    "recognized_comparator_visibility": {"const": "sealed"},
    "next_method_requirements": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "classify-layout-role-before-sentence-selection",
          "inspect-previous-current-next-page-context",
          "select-first-prose-after-heading-on-openings",
          "perform-diplomatic-transcription-after-source-review",
          "supersede-v1-without-rewriting-negative-baseline"
        ]
      },
      "allOf": [
        {"contains": {"const": "classify-layout-role-before-sentence-selection"}},
        {"contains": {"const": "inspect-previous-current-next-page-context"}},
        {"contains": {"const": "select-first-prose-after-heading-on-openings"}},
        {"contains": {"const": "perform-diplomatic-transcription-after-source-review"}},
        {"contains": {"const": "supersede-v1-without-rewriting-negative-baseline"}}
      ]
    },
    "inspected_at_utc": {"type": "string", "format": "date-time"},
    "review_authority": {"const": "advisory-nonhuman"},
    "promotion_authorized": {"const": false},
    "human_source_acceptance_count": {"const": 0}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragment_id",
        "source_anchor_ref",
        "visual_pdf_page",
        "sentence_candidate_ref",
        "sentence_candidate_sha256",
        "decision",
        "signals",
        "rationale",
        "human_source_acceptance"
      ],
      "properties": {
        "fragment_id": {
          "type": "string",
          "pattern": "^tos-translation-fragment-[0-9]{3}$"
        },
        "source_anchor_ref": {"type": "string", "minLength": 1},
        "visual_pdf_page": {"type": "integer", "minimum": 1},
        "sentence_candidate_ref": {
          "type": "string",
          "pattern": "^derived/sentence-candidates/tos-translation-fragment-[0-9]{3}\\.txt$"
        },
        "sentence_candidate_sha256": {"$ref": "#/$defs/sha256"},
        "decision": {
          "enum": ["accept-with-limits", "reject", "uncertain", "abstain"]
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "visual-page-correspondence-observed",
              "sentence-boundary-visually-plausible",
              "page-start-boundary-unverified",
              "heading-selected",
              "page-start-tail",
              "ocr-contamination",
              "transcription-uncertain"
            ]
          }
        },
        "rationale": {"type": "string", "minLength": 1},
        "human_source_acceptance": {"const": false}
      }
    }
  }
}
