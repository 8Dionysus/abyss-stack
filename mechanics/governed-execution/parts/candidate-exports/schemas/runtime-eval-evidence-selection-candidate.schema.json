{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa.invalid/abyss-stack/mechanics/governed-execution/parts/candidate-exports/schemas/runtime-eval-evidence-selection-candidate.schema.json",
  "title": "abyss-stack runtime eval evidence selection candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "capture_mode",
    "exported_at",
    "exported_by",
    "record_id",
    "title",
    "summary",
    "selection_id",
    "source_input_ref",
    "source_input_sha256",
    "aoa_evals_contract_refs",
    "candidate_payload"
  ],
  "properties": {
    "artifact_kind": {
      "const": "aoa.runtime-eval-evidence-selection-candidate"
    },
    "schema_version": {
      "const": "1"
    },
    "capture_mode": {
      "const": "private"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "exported_by": {
      "const": "scripts/aoa-export-runtime-evidence-selection"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "selection_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 3
    },
    "source_input_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "aoa_evals_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidate_payload": {
      "type": "object"
    }
  }
}
