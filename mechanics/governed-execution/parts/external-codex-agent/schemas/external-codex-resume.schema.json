{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/abyss-stack/main/mechanics/governed-execution/parts/external-codex-agent/schemas/external-codex-resume.schema.json",
  "title": "Exact external Codex resume request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "thread_id", "after_event_sequence", "reason", "instruction"],
  "properties": {
    "schema_version": {"const": "abyss_stack_external_codex_resume_v1"},
    "session_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "after_event_sequence": {"type": "integer", "minimum": 0},
    "reason": {"enum": ["checkpoint_continue", "process_death_recovery", "bounded_repair", "review_followup"]},
    "instruction": {"type": "string", "minLength": 1},
    "previous_result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceInput"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provenanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_repo",
        "artifact_ref",
        "source_ref",
        "artifact_digest",
        "schema_ref",
        "schema_version"
      ],
      "properties": {
        "owner_repo": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1}
      }
    },
    "evidenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "utf8_content", "provenance"],
      "properties": {
        "input_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 96
        },
        "utf8_content": {"type": "string"},
        "provenance": {"$ref": "#/$defs/provenanceRef"}
      }
    }
  }
}
