{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/abyss-stack/main/mechanics/governed-execution/parts/external-codex-agent/schemas/external-codex-result-evidence-closure.schema.json",
  "title": "Preserved evidence closure for one resumed external Codex result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_result_ref", "preserved_evidence"],
  "properties": {
    "schema_version": {"const": "abyss_stack_external_codex_result_evidence_closure_v1"},
    "source_result_ref": {"$ref": "#/$defs/evidenceRef"},
    "preserved_evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "snapshot_ref"],
        "properties": {
          "source_ref": {"$ref": "#/$defs/evidenceRef"},
          "snapshot_ref": {"$ref": "#/$defs/evidenceRef"}
        }
      }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_repo", "artifact_ref", "artifact_digest"],
      "properties": {
        "owner_repo": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
