{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abyss.local/schemas/external-codex-goal-lifecycle-attempt.schema.json",
  "title": "Abyss external Codex Goal lifecycle attempt reservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "state", "attempt_id", "attempt_ref", "reserved_at",
    "correlation_id", "idempotency_key", "goal_ref", "request_ref",
    "decision_ref", "expected_state", "desired_state", "owner_ref",
    "owner_sha256", "owner", "transport", "precondition"
  ],
  "properties": {
    "schema_version": {"const": "abyss_stack_external_codex_goal_lifecycle_attempt_v1"},
    "state": {"enum": ["reserved", "dispatched", "proof_recorded"]},
    "attempt_id": {"type": "string", "minLength": 1},
    "attempt_ref": {"type": "string", "minLength": 1},
    "reserved_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "goal_ref": {"$ref": "#/$defs/contentRef"},
    "request_ref": {"$ref": "#/$defs/contentRef"},
    "decision_ref": {"$ref": "#/$defs/contentRef"},
    "expected_state": {"type": "string", "minLength": 1},
    "desired_state": {"type": "string", "minLength": 1},
    "owner_ref": {"type": "string", "minLength": 1},
    "owner_sha256": {"$ref": "#/$defs/digest"},
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_id", "owner_repo", "goal_id", "thread_id", "runtime", "transport_posture", "acceptance_posture"],
      "properties": {
        "owner_id": {"type": "string", "minLength": 1},
        "owner_repo": {"type": "string", "minLength": 1},
        "goal_id": {"type": "string", "minLength": 1},
        "thread_id": {"type": "string", "minLength": 1},
        "runtime": {"const": "codex"},
        "transport_posture": {"type": "string", "minLength": 1},
        "acceptance_posture": {"type": "string", "minLength": 1}
      }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "endpoint"],
      "properties": {
        "kind": {"const": "codex_app_server_websocket_unix"},
        "endpoint": {"type": "string", "minLength": 1}
      }
    },
    "precondition": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_state", "goal_get", "goal_get_response", "goal_get_summary_sha256", "goal_response_sha256"],
      "properties": {
        "observed_state": {"type": "string", "minLength": 1},
        "goal_get": {"type": "object"},
        "goal_get_response": {"type": "object"},
        "goal_get_summary_sha256": {"$ref": "#/$defs/digest"},
        "goal_response_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "mutation_reserved": {"$ref": "#/$defs/mutation"},
    "mutation_dispatched": {"$ref": "#/$defs/mutation"},
    "goal_response": {"type": "object"},
    "post_read_response": {"type": "object"},
    "transition_request": {"type": "object"},
    "transition_proof": {
      "anyOf": [
        {"$ref": "#/$defs/transitionProof"},
        {"$ref": "#/$defs/legacyTransitionProof"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {"enum": ["dispatched", "proof_recorded"]}
        }
      },
      "then": {"required": ["mutation_reserved", "mutation_dispatched"]}
    },
    {
      "if": {
        "properties": {
          "state": {"const": "proof_recorded"},
          "transition_proof": {
            "properties": {
              "schema_version": {
                "const": "abyss_stack_external_codex_goal_transition_v2"
              }
            }
          }
        },
        "required": ["state", "transition_proof"]
      },
      "then": {
        "required": ["post_read_response", "transition_request", "transition_proof"]
      }
    },
    {
      "if": {
        "properties": {
          "state": {"const": "proof_recorded"},
          "transition_proof": {
            "properties": {
              "schema_version": {
                "const": "abyss_stack_external_codex_goal_transition_v1"
              }
            }
          }
        },
        "required": ["state", "transition_proof"]
      },
      "then": {
        "required": ["goal_response", "transition_request", "transition_proof"]
      }
    },
    {
      "if": {
        "properties": {"state": {"const": "reserved"}}
      },
      "then": {"not": {"required": ["mutation_dispatched"]}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contentRef": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "owner_repo", "schema_version", "digest"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "owner_repo": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "method", "request_id", "params", "params_sha256", "request_sha256"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "method": {"const": "thread/goal/set"},
        "request_id": {"type": "integer", "minimum": 1},
        "params": {"type": "object"},
        "params_sha256": {"$ref": "#/$defs/digest"},
        "request_sha256": {"$ref": "#/$defs/digest"},
        "reserved_at": {"type": "string", "format": "date-time"},
        "issued_at": {"type": "string", "format": "date-time"}
      }
    },
    "transitionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "method", "thread_id", "from_status",
        "to_status", "precondition_sha256", "request_id", "request_sha256",
        "goal_response_sha256", "post_read_response_sha256", "response_available"
      ],
      "properties": {
        "schema_version": {"const": "abyss_stack_external_codex_goal_transition_v2"},
        "kind": {"enum": ["request_response_post_read", "dispatch_reconciled_post_read"]},
        "method": {"const": "thread/goal/set"},
        "thread_id": {"type": "string", "minLength": 1},
        "from_status": {"type": "string", "minLength": 1},
        "to_status": {"type": "string", "minLength": 1},
        "precondition_sha256": {"$ref": "#/$defs/digest"},
        "request_id": {"type": "integer", "minimum": 1},
        "request_sha256": {"$ref": "#/$defs/digest"},
        "goal_response_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "post_read_response_sha256": {"$ref": "#/$defs/digest"},
        "response_available": {"type": "boolean"}
      }
    },
    "legacyTransitionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "method", "thread_id", "from_status",
        "to_status", "precondition_sha256", "request_id", "request_sha256",
        "goal_response_sha256"
      ],
      "properties": {
        "schema_version": {"const": "abyss_stack_external_codex_goal_transition_v1"},
        "kind": {"const": "server_compare_and_set"},
        "method": {"const": "thread/goal/set"},
        "thread_id": {"type": "string", "minLength": 1},
        "from_status": {"type": "string", "minLength": 1},
        "to_status": {"type": "string", "minLength": 1},
        "precondition_sha256": {"$ref": "#/$defs/digest"},
        "request_id": {"type": "integer", "minimum": 1},
        "request_sha256": {"$ref": "#/$defs/digest"},
        "goal_response_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
