{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abyss.local/stack/external-codex-reentry-state.schema.json",
  "title": "External Codex parent yield and re-entry runtime state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reentry_id",
    "status",
    "created_at",
    "updated_at",
    "obligation_ref",
    "parent_thread_id",
    "continuation_id",
    "child_task_id",
    "child_incarnation_id",
    "expected_wake",
    "turns",
    "events_ref",
    "child_result_ref",
    "wake_evaluation",
    "reentry_result_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "abyss_stack_external_codex_reentry_state_v1"
    },
    "reentry_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["waiting", "reentering", "filtered", "reentered", "failed"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "obligation_ref": {"$ref": "#/$defs/artifactRef"},
    "parent_thread_id": {"type": "string", "minLength": 1},
    "continuation_id": {"type": "string", "minLength": 1},
    "child_task_id": {"type": "string", "minLength": 1},
    "child_incarnation_id": {"type": "string", "minLength": 1},
    "expected_wake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "event_kind", "action"],
      "properties": {
        "condition_id": {"type": "string", "minLength": 1},
        "event_kind": {"type": "string", "minLength": 1},
        "action": {"const": "wake_parent"}
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "started_at",
          "finished_at",
          "exit_code",
          "thread_id",
          "events_ref",
          "output_ref",
          "usage"
        ],
        "properties": {
          "kind": {"enum": ["yield", "reentry"]},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "exit_code": {"type": "integer"},
          "thread_id": {"type": "string", "minLength": 1},
          "events_ref": {"$ref": "#/$defs/artifactRef"},
          "output_ref": {"$ref": "#/$defs/artifactRef"},
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_tokens", "cached_input_tokens", "output_tokens"],
            "properties": {
              "input_tokens": {"type": "integer", "minimum": 0},
              "cached_input_tokens": {"type": "integer", "minimum": 0},
              "output_tokens": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "events_ref": {"$ref": "#/$defs/artifactRef"},
    "child_result_ref": {
      "anyOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]
    },
    "wake_evaluation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_kind", "condition_id", "action", "wake_parent", "reason"],
          "properties": {
            "event_kind": {"type": "string"},
            "condition_id": {"type": ["string", "null"]},
            "action": {"type": "string"},
            "wake_parent": {"type": "boolean"},
            "reason": {"type": "string"}
          }
        },
        {"type": "null"}
      ]
    },
    "reentry_result_ref": {
      "anyOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_repo", "artifact_ref", "artifact_digest"],
      "properties": {
        "owner_repo": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "pattern": "^/"},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
