{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/abyss-stack/main/mechanics/governed-execution/parts/external-codex-agent/schemas/external-codex-legacy-owner-migration-catalog.schema.json",
  "title": "Release-bound legacy owner admission migration catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "captured_at", "entries"],
  "properties": {
    "schema_version": {
      "const": "abyss_stack_external_codex_legacy_owner_migration_catalog_v1"
    },
    "catalog_id": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "launch_id",
          "launch_digest",
          "owner_admission_digest",
          "owner_request_ref"
        ],
        "properties": {
          "session_id": {"type": "string", "minLength": 1},
          "launch_id": {"type": "string", "minLength": 1},
          "launch_digest": {"$ref": "#/$defs/digest"},
          "owner_admission_digest": {"$ref": "#/$defs/digest"},
          "owner_request_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
