{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/abyss-stack/main/mechanics/governed-execution/parts/external-codex-agent/schemas/external-codex-capability-classes.schema.json",
  "title": "Owner-authored external Codex capability-class registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "classes", "unknown"],
  "properties": {
    "$schema": {
      "const": "schemas/external-codex-capability-classes.schema.json"
    },
    "schema_version": {
      "const": "abyss_stack_codex_capability_class_registry_v1"
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/classDefinition"},
      "allOf": [
        {
          "contains": {
            "properties": {
              "capability_class": {"const": "session_continuity"},
              "projection": {"const": "shared_link"},
              "grantable": {"const": false}
            },
            "required": ["capability_class", "projection", "grantable"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "capability_class": {"const": "actor_tooling"},
              "projection": {"const": "shared_link"},
              "grantable": {"const": false}
            },
            "required": ["capability_class", "projection", "grantable"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "capability_class": {"const": "operator_control"},
              "projection": {"const": "denied"},
              "grantable": {"const": true}
            },
            "required": ["capability_class", "projection", "grantable"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "unknown": {"$ref": "#/$defs/unknownDefinition"}
  },
  "$defs": {
    "entryName": {
      "type": "string",
      "pattern": "^(?!\\.\\.?$)[^/]+$",
      "minLength": 1
    },
    "classDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_class", "projection", "grantable", "entries"],
      "properties": {
        "capability_class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "not": {"const": "unknown"}
        },
        "projection": {"enum": ["shared_link", "denied"]},
        "grantable": {"type": "boolean"},
        "entries": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/entryName"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capability_class": {"const": "session_continuity"}
            },
            "required": ["capability_class"]
          },
          "then": {
            "properties": {
              "projection": {"const": "shared_link"},
              "grantable": {"const": false}
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability_class": {"const": "actor_tooling"}
            },
            "required": ["capability_class"]
          },
          "then": {
            "properties": {
              "projection": {"const": "shared_link"},
              "grantable": {"const": false}
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability_class": {"const": "operator_control"}
            },
            "required": ["capability_class"]
          },
          "then": {
            "properties": {
              "projection": {"const": "denied"},
              "grantable": {"const": true}
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability_class": {
                "not": {
                  "enum": [
                    "session_continuity",
                    "actor_tooling",
                    "operator_control"
                  ]
                }
              }
            },
            "required": ["capability_class"]
          },
          "then": {
            "properties": {
              "projection": {"const": "denied"},
              "grantable": {"const": false}
            }
          }
        }
      ]
    },
    "unknownDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_class", "projection", "grantable"],
      "properties": {
        "capability_class": {"const": "unknown"},
        "projection": {"const": "denied"},
        "grantable": {"const": true}
      }
    }
  }
}
