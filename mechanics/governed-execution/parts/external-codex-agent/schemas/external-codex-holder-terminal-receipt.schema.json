{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/abyss-stack/main/mechanics/governed-execution/parts/external-codex-agent/schemas/external-codex-holder-terminal-receipt.schema.json",
  "title": "Visible responsibility-holder terminal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_ref", "created_at", "lifecycle_role", "boot_id", "holder", "runtime", "terminal"],
  "properties": {
    "schema_version": {"const": "abyss_stack_visible_incarnation_holder_terminal_v1"},
    "receipt_ref": {"type": "string", "pattern": "^/"},
    "created_at": {"type": "string", "format": "date-time"},
    "lifecycle_role": {"const": "responsibility_holder"},
    "boot_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "holder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "start_ticks", "parent_pid", "parent_start_ticks", "parent_comm", "argv", "argv_digest"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "start_ticks": {"type": "integer", "minimum": 1},
        "parent_pid": {"type": "integer", "minimum": 1},
        "parent_start_ticks": {"type": "integer", "minimum": 1},
        "parent_comm": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "argv_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex_executable", "codex_executable_digest", "incarnation_manifest", "incarnation_manifest_digest", "model", "reasoning_effort", "ambient_codex_home", "incarnation_codex_home"],
      "properties": {
        "codex_executable": {"type": "string", "pattern": "^/"},
        "codex_executable_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "codex_companion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "digest", "relation", "package_relative"],
          "properties": {
            "path": {"type": "string", "pattern": "^/"},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "relation": {"const": "adjacent_immutable_package"},
            "package_relative": {"type": "string", "minLength": 1}
          }
        },
        "incarnation_manifest": {"type": "string", "pattern": "^/"},
        "incarnation_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "incarnation_manifest_snapshot_b64": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"type": "string", "minLength": 1},
        "ambient_codex_home": {"type": "string", "pattern": "^/"},
        "incarnation_codex_home": {"type": "string", "pattern": "^/"}
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "required_comm", "pid", "start_ticks", "argv", "window_id", "dedicated"],
      "properties": {
        "binding": {"const": "kitty_ancestor_at_exec"},
        "required_comm": {"const": "kitty"},
        "pid": {"type": "integer", "minimum": 1},
        "start_ticks": {"type": "integer", "minimum": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "window_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "tty": {"type": "string", "pattern": "^/dev/(pts/[0-9]+|tty[0-9]+)$"},
        "title": {"type": "string"},
        "control_socket": {"$ref": "#/$defs/controlSocket"},
        "dedicated": {"const": true}
      }
    },
    "binding": {"$ref": "#/$defs/terminalBinding"}
  },
  "$defs": {
    "controlSocket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "path", "mode", "device", "inode"],
      "properties": {
        "address": {"type": "string", "pattern": "^unix:/"},
        "path": {"type": "string", "pattern": "^/"},
        "mode": {"type": "integer", "minimum": 0, "maximum": 511},
        "device": {"type": "integer", "minimum": 1},
        "inode": {"type": "integer", "minimum": 1}
      }
    },
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "start_ticks"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "start_ticks": {"type": "integer", "minimum": 1}
      }
    },
    "terminalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "boot_id",
        "goal_ref",
        "actor_ref",
        "incarnation_ref",
        "session_ref",
        "runtime_state_root",
        "closeout_route",
        "holder",
        "terminal",
        "remote_control",
        "dedicated"
      ],
      "properties": {
        "schema_version": {"const": "abyss_stack_visible_terminal_binding_v1"},
        "boot_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "goal_ref": {"type": "string", "minLength": 1},
        "actor_ref": {"type": "string", "minLength": 1},
        "incarnation_ref": {"type": "string", "minLength": 1},
        "session_ref": {"type": "string", "minLength": 1},
        "runtime_state_root": {"type": "string", "pattern": "^/"},
        "closeout_route": {"type": "string", "pattern": "^/"},
        "holder": {"$ref": "#/$defs/processIdentity"},
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pid",
            "start_ticks",
            "window_id",
            "tty",
            "title",
            "control_socket"
          ],
          "properties": {
            "pid": {"type": "integer", "minimum": 1},
            "start_ticks": {"type": "integer", "minimum": 1},
            "window_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
            "tty": {"type": "string", "pattern": "^/dev/(pts/[0-9]+|tty[0-9]+)$"},
            "title": {"type": "string"},
            "control_socket": {"$ref": "#/$defs/controlSocket"}
          }
        },
        "remote_control": {"const": "socket-only"},
        "dedicated": {"const": true},
        "source_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "pattern": "^/"},
            "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      }
    }
  }
}
