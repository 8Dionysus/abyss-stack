{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/abyss-stack/main/mechanics/governed-execution/parts/external-codex-agent/schemas/external-codex-continuity-capsule-reinjection.schema.json",
  "title": "Exact provider-neutral continuity capsule reinjection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capsule_ref", "capsule_digest", "portable_view", "private_view"],
  "properties": {
    "schema_version": {"const": "continuity_capsule_reinjection_v1"},
    "capsule_ref": {"$ref": "#/$defs/capsuleRef"},
    "capsule_digest": {"$ref": "#/$defs/digest"},
    "portable_view": {"$ref": "#/$defs/portableView"},
    "private_view": {"$ref": "#/$defs/privateView"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capsuleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "owner_repo", "schema_version", "digest"],
      "properties": {
        "object_id": {"type": "string", "pattern": "^continuity-capsule:.+"},
        "owner_repo": {"const": "aoa-session-memory"},
        "schema_version": {"const": "continuity_capsule_v1"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capsule_id",
        "goal",
        "constraints",
        "completed",
        "current_work",
        "blockers",
        "exact_decisions",
        "open_obligations",
        "evidence_refs",
        "omissions_uncertainty"
      ],
      "properties": {
        "capsule_id": {"type": "string", "minLength": 1},
        "goal": {"type": "object"},
        "constraints": {"$ref": "#/$defs/stringList"},
        "completed": {"$ref": "#/$defs/stringList"},
        "current_work": {"$ref": "#/$defs/stringList"},
        "blockers": {"$ref": "#/$defs/stringList"},
        "exact_decisions": {"$ref": "#/$defs/stringList"},
        "open_obligations": {"$ref": "#/$defs/stringList"},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "object", "minProperties": 1}
        },
        "omissions_uncertainty": {"type": "object"}
      }
    },
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "sourceWatermark": {
      "type": "object",
      "required": ["source_ref", "source_digest", "generation", "observed_at"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"},
        "generation": {"type": "integer", "minimum": 0},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "compactionEvent": {
      "type": "object",
      "required": ["event_ref", "session_id", "sequence", "occurred_at", "kind"],
      "properties": {
        "event_ref": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0},
        "occurred_at": {"type": "string", "format": "date-time"},
        "kind": {"const": "compaction"}
      }
    },
    "protectedTailPosture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "portable_tail_policy", "private_tail_digest", "private_tail_bytes"],
      "properties": {
        "mode": {"const": "verbatim_private_tail"},
        "portable_tail_policy": {"const": "omitted"},
        "private_tail_digest": {"$ref": "#/$defs/digest"},
        "private_tail_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "portableView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "view",
        "capsule_ref",
        "capsule_digest",
        "content",
        "source_watermark",
        "compaction_event",
        "protected_tail_posture",
        "view_digest"
      ],
      "properties": {
        "schema_version": {"const": "continuity_capsule_materialization_v1"},
        "view": {"const": "portable"},
        "capsule_ref": {"$ref": "#/$defs/capsuleRef"},
        "capsule_digest": {"$ref": "#/$defs/digest"},
        "content": {"$ref": "#/$defs/content"},
        "source_watermark": {"$ref": "#/$defs/sourceWatermark"},
        "compaction_event": {"$ref": "#/$defs/compactionEvent"},
        "protected_tail_posture": {"$ref": "#/$defs/protectedTailPosture"},
        "view_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "privateView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "view",
        "capsule_ref",
        "capsule_digest",
        "content",
        "source_watermark",
        "compaction_event",
        "protected_tail_posture",
        "view_digest",
        "protected_tail"
      ],
      "properties": {
        "schema_version": {"const": "continuity_capsule_materialization_v1"},
        "view": {"const": "private"},
        "capsule_ref": {"$ref": "#/$defs/capsuleRef"},
        "capsule_digest": {"$ref": "#/$defs/digest"},
        "content": {"$ref": "#/$defs/content"},
        "source_watermark": {"$ref": "#/$defs/sourceWatermark"},
        "compaction_event": {"$ref": "#/$defs/compactionEvent"},
        "protected_tail_posture": {"$ref": "#/$defs/protectedTailPosture"},
        "view_digest": {"$ref": "#/$defs/digest"},
        "protected_tail": {"type": "string"}
      }
    }
  }
}
