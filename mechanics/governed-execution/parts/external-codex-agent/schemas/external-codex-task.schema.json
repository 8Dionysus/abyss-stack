{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/abyss-stack/main/mechanics/governed-execution/parts/external-codex-agent/schemas/external-codex-task.schema.json",
  "title": "Bounded external Codex agent task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "correlation_id", "continuation_id", "expected_incarnation_id", "task_family", "execution_posture", "parent_task_id", "objective", "transition", "target_owner", "authority_scope", "allowed_effect_class", "allowed_paths", "immutable_inputs", "done_state", "validation_commands", "expected_artifacts", "forbidden_effects", "ambiguity_policy", "review_required", "return_owner"],
  "properties": {
    "schema_version": {"const": "abyss_stack_external_codex_task_v1"},
    "task_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "continuation_id": {"type": "string", "minLength": 1},
    "expected_incarnation_id": {"type": "string", "minLength": 1},
    "task_family": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "execution_posture": {"enum": ["bounded_execution", "independent_review", "closeout", "ambiguity_stop"]},
    "parent_task_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_status", "target_status", "approval_posture", "rollback_reentry_route"],
      "properties": {
        "from_status": {"type": "string", "minLength": 1},
        "target_status": {"type": "string", "minLength": 1},
        "review_required_status": {"type": "string", "minLength": 1},
        "approval_posture": {"type": "string", "minLength": 1},
        "rollback_reentry_route": {"type": "string", "minLength": 1}
      }
    },
    "target_owner": {"type": "string", "minLength": 1},
    "authority_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_effect_class": {"enum": ["read_only", "repo_mutation"]},
    "indirect_command_policy": {"enum": ["fail_closed", "sandbox_confined"]},
    "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}}},
    "source_evidence_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}}},
    "immutable_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_id", "local_path", "provenance"],
        "properties": {
          "input_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
          "local_path": {"type": "string", "pattern": "^/"},
          "provenance": {"$ref": "#/$defs/provenanceRef"}
        }
      }
    },
    "done_state": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "argv", "cwd"],
        "properties": {
          "command_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}}
        }
      }
    },
    "expected_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_effects": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"enum": ["commit", "push", "pull_request", "merge", "tag", "release", "publication", "service_mutation", "secret_access", "global_config_mutation"]}},
    "ambiguity_policy": {"enum": ["escalate", "stop"]},
    "review_required": {"type": "boolean"},
    "return_owner": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"execution_posture": {"const": "independent_review"}},
        "required": ["execution_posture"]
      },
      "then": {
        "properties": {
          "transition": {"required": ["review_required_status"]}
        }
      }
    }
  ],
  "$defs": {
    "provenanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_repo", "artifact_ref", "source_ref", "artifact_digest", "schema_ref", "schema_version"],
      "properties": {
        "owner_repo": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
