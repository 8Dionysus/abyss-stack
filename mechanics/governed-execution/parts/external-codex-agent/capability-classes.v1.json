{
  "$schema": "schemas/external-codex-capability-classes.schema.json",
  "schema_version": "abyss_stack_codex_capability_class_registry_v1",
  "classes": {
    "session_continuity": {
      "projection": "shared_link",
      "grantable": false,
      "entries": [
        "archived_sessions",
        "attachments",
        "auth.json",
        "history.jsonl",
        "memories",
        "memories_1.sqlite",
        "memories_1.sqlite-shm",
        "memories_1.sqlite-wal",
        "session_index.jsonl",
        "sessions"
      ]
    },
    "actor_tooling": {
      "projection": "shared_link",
      "grantable": false,
      "entries": ["skills"]
    },
    "operator_control": {
      "projection": "denied",
      "grantable": true,
      "entries": [
        "app-server-control",
        "app-server-daemon",
        "browser",
        "hooks.json",
        "plugins",
        "queues"
      ]
    }
  },
  "unknown": {
    "capability_class": "unknown",
    "projection": "denied",
    "grantable": true
  }
}
