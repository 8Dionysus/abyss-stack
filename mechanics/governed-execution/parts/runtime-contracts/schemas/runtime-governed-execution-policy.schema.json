{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/abyss-stack/main/mechanics/governed-execution/parts/runtime-contracts/schemas/runtime-governed-execution-policy.schema.json",
  "title": "abyss-stack governed execution policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_type",
    "schema_version",
    "policy_id",
    "enabled",
    "global_rules",
    "targets",
    "boundaries"
  ],
  "properties": {
    "surface_type": {
      "type": "string",
      "const": "runtime_governed_execution_policy"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "global_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_mode",
        "canonical_gate_command",
        "default_target_id",
        "require_clean_repo",
        "require_stable_base_head",
        "approval_milestones",
        "max_worktree_repairs",
        "auto_rollback_on_post_apply_failure",
        "break_glass_requires_reason",
        "log_root",
        "promotion_criteria",
        "repo_scope_expansion_gate"
      ],
      "properties": {
        "gate_mode": {
          "type": "string",
          "enum": [
            "fail_closed"
          ]
        },
        "canonical_gate_command": {
          "type": "string",
          "minLength": 1
        },
        "default_target_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 1
        },
        "require_clean_repo": {
          "type": "boolean",
          "const": true
        },
        "require_stable_base_head": {
          "type": "boolean",
          "const": true
        },
        "approval_milestones": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "plan_freeze",
              "landing"
            ]
          }
        },
        "max_worktree_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "auto_rollback_on_post_apply_failure": {
          "type": "boolean",
          "const": true
        },
        "break_glass_requires_reason": {
          "type": "boolean",
          "const": true
        },
        "log_root": {
          "type": "string",
          "minLength": 1
        },
        "promotion_criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canary_proven",
            "trusted"
          ],
          "properties": {
            "canary_proven": {
              "$ref": "#/$defs/promotionCriteria"
            },
            "trusted": {
              "$ref": "#/$defs/promotionCriteria"
            }
          }
        },
        "repo_scope_expansion_gate": {
          "$ref": "#/$defs/promotionCriteria"
        }
      }
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo_scope",
          "default_repo_root",
          "playbooks"
        ],
        "properties": {
          "repo_scope": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "default_repo_root": {
            "type": "string",
            "minLength": 1
          },
          "playbooks": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/playbookPolicy"
            }
          }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owns_runtime_permissions_only",
        "does_not_define_playbook_meaning",
        "does_not_replace_route_api_advisory_surfaces",
        "does_not_replace_langchain_api_federated_advisory_run",
        "external_targets_require_explicit_policy"
      ],
      "properties": {
        "owns_runtime_permissions_only": {
          "type": "boolean",
          "const": true
        },
        "does_not_define_playbook_meaning": {
          "type": "boolean",
          "const": true
        },
        "does_not_replace_route_api_advisory_surfaces": {
          "type": "boolean",
          "const": true
        },
        "does_not_replace_langchain_api_federated_advisory_run": {
          "type": "boolean",
          "const": true
        },
        "external_targets_require_explicit_policy": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "$defs": {
    "promotionCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_successful_runs",
        "minimum_task_classes",
        "maximum_scope_violations",
        "maximum_rollback_failures",
        "maximum_break_glass_runs",
        "maximum_post_change_validation_failures"
      ],
      "properties": {
        "minimum_successful_runs": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_task_classes": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_scope_violations": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_rollback_failures": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_break_glass_runs": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_post_change_validation_failures": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "playbookPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "execution_kind",
        "repo_scope",
        "allowed_files",
        "acceptance_commands",
        "break_glass_allowed",
        "repair_allowed",
        "trust_state",
        "task_class"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "execution_kind": {
          "type": "string",
          "enum": [
            "mutation"
          ]
        },
        "repo_scope": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 1
        },
        "allowed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "break_glass_allowed": {
          "type": "boolean"
        },
        "repair_allowed": {
          "type": "boolean"
        },
        "trust_state": {
          "type": "string",
          "enum": [
            "experimental",
            "canary_proven",
            "trusted"
          ]
        },
        "task_class": {
          "type": "string",
          "enum": [
            "docs_only",
            "policy_surface",
            "validation_tightening",
            "governed_lane",
            "generated_surface"
          ]
        },
        "evidence_since_run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
