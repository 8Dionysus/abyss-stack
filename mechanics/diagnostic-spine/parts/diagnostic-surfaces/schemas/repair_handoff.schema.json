{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8dionysus.github.io/schemas/repair_handoff_v1.schema.json",
  "title": "abyss-stack repair_handoff_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "id",
    "repo",
    "captured_at",
    "diagnostic_session_ref",
    "diagnostic_session_id",
    "diagnosis_companion_ref",
    "target",
    "target_skill",
    "target_owner_repo",
    "handoff_readiness",
    "summary",
    "checkpoint_posture",
    "validation_refs",
    "stop_conditions",
    "escalation_routes",
    "public_safe"
  ],
  "properties": {
    "schema_version": {
      "const": "repair_handoff_v1"
    },
    "artifact_kind": {
      "const": "aoa.diagnostic.repair-handoff"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "diagnostic_session_ref": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic_session_id": {
      "type": "string",
      "minLength": 1
    },
    "diagnosis_companion_ref": {
      "type": "string",
      "minLength": 1
    },
    "comparison_anchor_ref": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_session_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewed_diagnosis_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset",
        "profiles",
        "truth_goal"
      ],
      "properties": {
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "truth_goal": {
          "type": "string",
          "enum": [
            "deployed",
            "trial_proven",
            "live_available"
          ]
        }
      }
    },
    "target_skill": {
      "const": "aoa-session-self-repair"
    },
    "target_owner_repo": {
      "const": "aoa-skills"
    },
    "handoff_readiness": {
      "type": "string",
      "enum": [
        "not_needed",
        "review_required",
        "ready_for_review",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "trigger_drifts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/driftItem"
      }
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checkpoint_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_fit",
        "approval_gate",
        "rollback_marker",
        "health_check",
        "iteration_limit",
        "improvement_log_stub"
      ],
      "properties": {
        "policy_fit": {
          "type": "string",
          "minLength": 1
        },
        "approval_gate": {
          "type": "string",
          "minLength": 1
        },
        "rollback_marker": {
          "type": "string",
          "minLength": 1
        },
        "health_check": {
          "type": "string",
          "minLength": 1
        },
        "iteration_limit": {
          "type": "string",
          "minLength": 1
        },
        "improvement_log_stub": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "escalation_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "owner_repo",
          "note"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "owner_repo": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "public_safe": {
      "type": "boolean"
    }
  },
  "$defs": {
    "driftItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "severity",
        "summary"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "selector_drift",
            "source_deploy_drift",
            "host_posture_drift",
            "adaptation_staleness",
            "render_truth_drift",
            "runtime_health_drift",
            "closure_drift",
            "truth_gap",
            "noise_envelope",
            "policy_gate_block",
            "evidence_gap",
            "boundary_confusion"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "probable_causes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner_hint": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
