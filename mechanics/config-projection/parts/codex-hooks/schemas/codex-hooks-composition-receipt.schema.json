{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-of-abyss.dev/schemas/abyss-stack/codex-hooks-composition-receipt.schema.json",
  "title": "Codex hooks composition receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "fragments",
    "bindings",
    "output",
    "target_ref",
    "target_changed",
    "previous_output_digest",
    "backup_name",
    "backup_digest",
    "authority",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "abyss_codex_hooks_composition_receipt_v0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_index",
          "fragment_id",
          "owner",
          "mode",
          "source_digest"
        ],
        "properties": {
          "input_index": {
            "type": "integer",
            "minimum": 0
          },
          "fragment_id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "source_digest": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "event_count",
        "group_count",
        "handler_count"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "event_count": {
          "type": "integer",
          "minimum": 1
        },
        "group_count": {
          "type": "integer",
          "minimum": 1
        },
        "handler_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "target_ref": {
      "$ref": "#/$defs/sha256"
    },
    "target_changed": {
      "type": "boolean"
    },
    "previous_output_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "backup_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "backup_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook_semantics",
        "codex_trust",
        "runtime_health",
        "memory_use",
        "outcome",
        "benefit"
      ],
      "properties": {
        "hook_semantics": {
          "const": false
        },
        "codex_trust": {
          "const": false
        },
        "runtime_health": {
          "const": false
        },
        "memory_use": {
          "const": false
        },
        "outcome": {
          "const": false
        },
        "benefit": {
          "const": false
        }
      }
    },
    "receipt_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
