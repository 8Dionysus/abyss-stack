{
  "schema_version": "abyss_codex_hooks_fragment_v0",
  "fragment_id": "abyss-stack:agent-tool-routing:v1",
  "owner": "abyss-stack",
  "mode": "pretool-agent-routing",
  "description": "Reflect SDK-owned responsibility routing before Codex agent tools execute",
  "bindings": [
    "AOA_CODEX_AGENT_ROUTING_HOOK",
    "AOA_CODEX_AGENT_ROUTING_CONTEXT_DIR",
    "AOA_CODEX_AGENT_ROUTING_SDK_SOURCE_ROOT"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Agent|spawn_agent|(?:multi_agent_|collaboration)[A-Za-z0-9_]+|send_message|followup_task|wait_agent|list_agents|interrupt_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env AOA_AGENT_TOOL_ROUTING_CONTEXT_DIR=\"{{AOA_CODEX_AGENT_ROUTING_CONTEXT_DIR}}\" AOA_SDK_SOURCE_ROOT=\"{{AOA_CODEX_AGENT_ROUTING_SDK_SOURCE_ROOT}}\" /usr/bin/python3 \"{{AOA_CODEX_AGENT_ROUTING_HOOK}}\"",
            "timeout": 10,
            "statusMessage": "Routing Codex agent tool through AoA"
          }
        ]
      }
    ]
  }
}
