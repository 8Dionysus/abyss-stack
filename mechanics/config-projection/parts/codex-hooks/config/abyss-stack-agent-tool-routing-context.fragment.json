{
  "schema_version": "abyss_codex_hooks_fragment_v0",
  "fragment_id": "abyss-stack:agent-tool-routing-context-relay:v1",
  "owner": "abyss-stack",
  "mode": "pretool-agent-routing-context-relay",
  "description": "Materialize a session-owned typed base for the stack agent-tool adapter",
  "bindings": [
    "AOA_CODEX_AGENT_ROUTING_CONTEXT_RELAY",
    "AOA_CODEX_AGENT_ROUTING_CONTEXT_DIR"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Agent|spawn_agent|(?:multi_agent_|collaboration)[A-Za-z0-9_]+|send_message|followup_task|wait_agent|list_agents|interrupt_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env AOA_AGENT_TOOL_ROUTING_CONTEXT_DIR=\"{{AOA_CODEX_AGENT_ROUTING_CONTEXT_DIR}}\" /usr/bin/python3 \"{{AOA_CODEX_AGENT_ROUTING_CONTEXT_RELAY}}\"",
            "timeout": 3,
            "statusMessage": "Preparing typed AoA route context"
          }
        ]
      }
    ]
  }
}
