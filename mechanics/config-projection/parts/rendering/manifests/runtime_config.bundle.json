  },
  "abi_subject": {
    "path": "dist/abyss-stack-runtime-config/substrate.rendered.yml"
  },
  "artifact_subjects": [
    {
      "path": "dist/abyss-stack-runtime-config/substrate.rendered.yml",
      "role": "rendered_runtime_config"
    }
  ],
  "package": {
    "ecosystem": "compose",
    "name": "abyss-stack-runtime-config",
