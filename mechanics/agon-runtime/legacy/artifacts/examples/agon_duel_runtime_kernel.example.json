{
  "event_log_requirements": [
    "monotonic_seq",
    "prev_hash_required_after_genesis",
    "event_hash_required",
    "two_contestant_commit_receipts_before_reveal",
    "assistant_not_contestant",
    "adjudication_request_not_verdict",
    "closeout_candidate_not_closure_grant"
  ],
  "id": "abyss.runtime.agon.mechanical_duel_kernel.v0",
  "input_surfaces": [
    "Agents-of-Abyss/generated/agon_duel_kernel_model_registry.min.json",
    "Agents-of-Abyss/generated/agon_state_packet_registry.min.json",
    "Agents-of-Abyss/generated/agon_ccs_law_registry.min.json",
    "Agents-of-Abyss/generated/agon_vds_bridge_registry.min.json",
    "aoa-sdk/generated/agon_duel_kernel_sdk_bindings.min.json"
  ],
  "runtime_effect": "local_event_log_candidate_only",
  "service_activation": false,
  "state_machine": {
    "initial": "new",
    "terminal_candidates": [
      "closeout_candidate",
      "aborted",
      "quarantined"
    ],
    "transitions": [
      {
        "event": "kernel.draft_created",
        "from": "new",
        "to": "draft_created"
      },
      {
        "event": "kernel.charter_bound",
        "from": "draft_created",
        "to": "charter_bound"
      },
      {
        "event": "kernel.seats_bound",
        "from": "charter_bound",
        "to": "seats_bound"
      },
      {
        "event": "kernel.commit_phase_opened",
        "from": "seats_bound",
        "to": "commit_phase_open"
      },
      {
        "event": "kernel.sealed_commit_recorded",
        "from": "commit_phase_open",
        "to": "commit_phase_open"
      },
      {
        "event": "kernel.commit_phase_closed",
        "from": "commit_phase_open",
        "to": "commit_phase_closed"
      },
      {
        "event": "kernel.reveal_view_recorded",
        "from": "commit_phase_closed",
        "to": "reveal_phase_closed"
      },
      {
        "event": "kernel.engagement_window_opened",
        "from": "reveal_phase_closed",
        "to": "engagement_open"
      },
      {
        "event": "kernel.move_declaration_recorded",
        "from": "engagement_open",
        "to": "engagement_open"
      },
      {
        "event": "kernel.revision_statement_recorded",
        "from": "engagement_open",
        "to": "revision_window_closed"
      },
      {
        "event": "kernel.adjudication_request_recorded",
        "from": "revision_window_closed",
        "to": "adjudication_requested"
      },
      {
        "event": "kernel.closeout_candidate_recorded",
        "from": "adjudication_requested",
        "to": "closeout_candidate"
      },
      {
        "event": "kernel.aborted",
        "from": "*",
        "to": "aborted"
      },
      {
        "event": "kernel.quarantined",
        "from": "*",
        "to": "quarantined"
      }
    ]
  },
  "status": "seeded_bounded_local_dry_run",
  "stop_lines": [
    "no_live_verdict_authority",
    "no_durable_scar_write",
    "no_retention_execution",
    "no_rank_or_trust_mutation",
    "no_tree_of_sophia_promotion",
    "no_kag_promotion",
    "no_hidden_scheduler_action",
    "no_assistant_contestant_drift",
    "no_unreviewed_runtime_service_activation",
    "no_network_listener",
    "no_background_daemon",
    "no_database_migration"
  ],
  "title": "Local Mechanical Duel Runtime Kernel Candidate"
}
