{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abyss-stack.invalid/schemas/owner-source-deployment-admission-v1",
  "title": "Abyss Stack owner-source deployment admission v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "admission_kind",
    "status",
    "admission_id",
    "admission_ref",
    "owner_repo",
    "source_root",
    "source_ref",
    "source_tree",
    "destination",
    "authority_ceiling",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "abyss_stack_owner_source_deployment_admission_v1"},
    "admission_kind": {"const": "owner_source_deployment_route"},
    "status": {"const": "admitted"},
    "source_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authority_ceiling": {
      "enum": [
        "disposable-source-package-canary",
        "installed-source-package-activation"
      ]
    }
  }
}
