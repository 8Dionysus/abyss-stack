{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abyss-stack.invalid/schemas/owner-source-prepare-receipt-v1",
  "title": "Abyss Stack owner-source prepare receipt v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "operation_id",
    "owner_repo",
    "source",
    "destination",
    "release_root",
    "release_path",
    "predecessor",
    "admission",
    "atomicity",
    "dependency_posture",
    "claim_ceiling",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "abyss_stack_owner_source_prepare_receipt_v1"},
    "status": {"enum": ["prepared", "dry_run"]},
    "dependency_posture": {"const": "source_only_no_install"},
    "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
