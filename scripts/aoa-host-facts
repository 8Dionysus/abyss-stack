#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import platform
from datetime import datetime, timezone
from pathlib import Path
import shutil
import socket
import subprocess
import sys
from typing import Any


def run_command(*args: str) -> tuple[bool, str]:
    try:
        completed = subprocess.run(
            list(args),
            check=False,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        return False, ""
    if completed.returncode != 0:
        return False, completed.stderr.strip() or completed.stdout.strip()
    return True, completed.stdout.strip()


def read_os_release() -> dict[str, str]:
    data: dict[str, str] = {}
    path = Path("/etc/os-release")
    if not path.exists():
        return data

    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        data[key] = value.strip().strip('"')
    return data


def parse_lscpu() -> dict[str, str]:
    ok, output = run_command("lscpu")
    if not ok:
        return {}

    data: dict[str, str] = {}
    for line in output.splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        data[key.strip()] = value.strip()
    return data


def int_or_none(value: str | None) -> int | None:
    if value is None or value == "":
        return None
    try:
        return int(value)
    except ValueError:
        try:
            return int(float(value))
        except ValueError:
            return None


def float_or_none(value: str | None) -> float | None:
    if value is None or value == "":
        return None
    try:
        return float(value)
    except ValueError:
        return None


def read_meminfo() -> tuple[int | None, int | None]:
    mem_total = None
    swap_total = None
    path = Path("/proc/meminfo")
    if not path.exists():
        return mem_total, swap_total

    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("MemTotal:"):
            mem_total = int_or_none(line.split()[1])
        elif line.startswith("SwapTotal:"):
            swap_total = int_or_none(line.split()[1])

    if mem_total is not None:
        mem_total *= 1024
    if swap_total is not None:
        swap_total *= 1024
    return mem_total, swap_total


def read_drm() -> dict[str, Any]:
    dri = Path("/dev/dri")
    render_nodes: list[str] = []
    intel_drm_present = False

    if dri.exists():
        for path in sorted(dri.glob("renderD*")):
            render_nodes.append(path.name)

    drm_root = Path("/sys/class/drm")
    if drm_root.exists():
        for vendor_file in drm_root.glob("card*/device/vendor"):
            try:
                vendor = vendor_file.read_text(encoding="utf-8").strip().lower()
            except OSError:
                continue
            if vendor == "0x8086":
                intel_drm_present = True
                break

    return {
        "dev_dri_present": dri.exists(),
        "render_nodes": render_nodes,
        "intel_drm_present": intel_drm_present,
    }


def nearest_existing_path(path_text: str) -> str | None:
    path = Path(path_text)
    if path.exists():
        return str(path.resolve())

    current = path
    while True:
        parent = current.parent
        if current == parent:
            break
        current = parent
        if current.exists():
            return str(current.resolve())
    return None


def statvfs_bytes(path_text: str | None) -> tuple[int | None, int | None]:
    if path_text is None:
        return None, None
    try:
        if hasattr(os, "statvfs"):
            stats = os.statvfs(path_text)
            size_bytes = stats.f_frsize * stats.f_blocks
            available_bytes = stats.f_frsize * stats.f_bavail
            return size_bytes, available_bytes

        usage = shutil.disk_usage(path_text)
    except OSError:
        return None, None
    return usage.total, usage.free


def find_mount_for_path(path_text: str) -> dict[str, Any]:
    resolved_path = nearest_existing_path(path_text)
    if resolved_path is None:
        return {
            "query_path": path_text,
            "resolved_path": None,
            "mount_target": None,
            "mounted": False,
            "fstype": None,
            "size_bytes": None,
            "available_bytes": None,
        }

    ok, output = run_command(
        "findmnt",
        "-J",
        "-T",
        resolved_path,
        "-o",
        "TARGET,SOURCE,FSTYPE",
    )
    if not ok:
        size_bytes, available_bytes = statvfs_bytes(resolved_path)
        return {
            "query_path": path_text,
            "resolved_path": resolved_path,
            "mount_target": None,
            "mounted": Path(path_text).exists(),
            "fstype": None,
            "size_bytes": size_bytes,
            "available_bytes": available_bytes,
        }

    try:
        mounts = json.loads(output).get("filesystems", [])
    except json.JSONDecodeError:
        mounts = []

    mount = mounts[0] if mounts else {}
    size_bytes, available_bytes = statvfs_bytes(resolved_path)

    return {
        "query_path": path_text,
        "resolved_path": resolved_path,
        "mount_target": mount.get("target"),
        "mounted": Path(path_text).exists() or mount.get("target") == path_text,
        "fstype": mount.get("fstype"),
        "source": mount.get("source"),
        "size_bytes": size_bytes,
        "available_bytes": available_bytes,
    }


def read_lsblk_devices() -> list[dict[str, Any]]:
    ok, output = run_command(
        "lsblk",
        "-J",
        "-b",
        "-o",
        "NAME,KNAME,TYPE,SIZE,ROTA,FSTYPE,MOUNTPOINTS",
    )
    if not ok:
        return []

    try:
        payload = json.loads(output)
    except json.JSONDecodeError:
        return []

    devices: list[dict[str, Any]] = []

    def walk(items: list[dict[str, Any]]) -> None:
        for item in items:
            mountpoints = [
                mountpoint
                for mountpoint in item.get("mountpoints", []) or []
                if mountpoint
            ]
            devices.append(
                {
                    "name": item.get("name"),
                    "kname": item.get("kname"),
                    "type": item.get("type"),
                    "size_bytes": int_or_none(str(item.get("size")))
                    if item.get("size") is not None
                    else None,
                    "rotational": None
                    if item.get("rota") is None
                    else bool(int(item.get("rota"))),
                    "fstype": item.get("fstype"),
                    "mountpoints": mountpoints,
                }
            )
            children = item.get("children") or []
            if children:
                walk(children)

    walk(payload.get("blockdevices", []))
    return devices


def detect_compose_backend() -> str | None:
    if shutil.which("podman") is not None:
        ok, _ = run_command("podman", "compose", "version")
        if ok:
            return "podman compose"
    if shutil.which("podman-compose") is not None:
        return "podman-compose"
    return None


def podman_info() -> tuple[str | None, bool | None]:
    if shutil.which("podman") is None:
        return None, None

    ok, output = run_command("podman", "info", "--format", "json")
    if not ok:
        return None, None

    try:
        payload = json.loads(output)
    except json.JSONDecodeError:
        return None, None

    version = None
    rootless = None

    version_block = payload.get("Version")
    if isinstance(version_block, dict):
        version = version_block.get("Version")
    elif isinstance(version_block, str):
        version = version_block

    host_block = payload.get("Host")
    if isinstance(host_block, dict):
        security_block = host_block.get("Security")
        if isinstance(security_block, dict):
            rootless = security_block.get("Rootless")

    return version, rootless


def systemd_user_available() -> bool:
    ok, _ = run_command("systemctl", "--user", "show-environment")
    return ok


def selinux_mode() -> str | None:
    ok, output = run_command("getenforce")
    if ok and output:
        return output
    return None


def build_platform(capture_mode: str) -> dict[str, Any]:
    os_release = read_os_release()
    uname = platform.uname()
    platform_data = {
        "os_id": os_release.get("ID"),
        "os_version_id": os_release.get("VERSION_ID"),
        "os_pretty_name": os_release.get("PRETTY_NAME"),
        "kernel_release": uname.release,
        "arch": uname.machine,
    }
    if capture_mode == "private":
        platform_data["hostname"] = socket.gethostname()
    return platform_data


def build_cpu() -> dict[str, Any]:
    lscpu = parse_lscpu()
    sockets = int_or_none(lscpu.get("Socket(s)"))
    cores_per_socket = int_or_none(lscpu.get("Core(s) per socket"))
    threads_per_core = int_or_none(lscpu.get("Thread(s) per core"))
    physical_cores_estimate = None
    if sockets is not None and cores_per_socket is not None:
        physical_cores_estimate = sockets * cores_per_socket

    return {
        "vendor": lscpu.get("Vendor ID"),
        "model_name": lscpu.get("Model name"),
        "sockets": sockets,
        "cores_per_socket": cores_per_socket,
        "threads_per_core": threads_per_core,
        "physical_cores_estimate": physical_cores_estimate,
        "logical_cpus": int_or_none(lscpu.get("CPU(s)")),
        "max_mhz": float_or_none(lscpu.get("CPU max MHz")),
    }


def build_memory() -> dict[str, Any]:
    total_bytes, swap_total_bytes = read_meminfo()
    return {
        "total_bytes": total_bytes,
        "swap_total_bytes": swap_total_bytes,
    }


def build_storage(
    capture_mode: str, stack_root: str, vault_root: str
) -> dict[str, Any]:
    observed_paths = [
        find_mount_for_path("/"),
        find_mount_for_path(stack_root),
        find_mount_for_path(vault_root),
    ]

    if capture_mode == "public":
        for entry in observed_paths:
            entry.pop("source", None)

    storage = {"observed_paths": observed_paths}
    if capture_mode == "private":
        storage["devices"] = read_lsblk_devices()
    return storage


def build_runtime() -> dict[str, Any]:
    version, rootless = podman_info()
    return {
        "podman_present": shutil.which("podman") is not None,
        "podman_version": version,
        "podman_rootless": rootless,
        "compose_backend": detect_compose_backend(),
        "systemd_user_available": systemd_user_available(),
        "selinux_mode": selinux_mode(),
    }


def build_paths(stack_root: str, configs_root: str, vault_root: str) -> dict[str, Any]:
    vault_mount = find_mount_for_path(vault_root)
    return {
        "stack_root": stack_root,
        "configs_root": configs_root,
        "vault_root": vault_root,
        "stack_root_is_canonical": stack_root == "/srv/abyss-stack",
        "stack_root_exists": Path(stack_root).exists(),
        "configs_root_exists": Path(configs_root).exists(),
        "vault_root_exists": Path(vault_root).exists(),
        "vault_root_mounted": vault_mount.get("mount_target") == vault_root,
    }


def build_redaction(capture_mode: str) -> dict[str, bool]:
    return {
        "hostname_redacted": capture_mode != "private",
        "mount_sources_redacted": capture_mode != "private",
        "device_serials_redacted": True,
        "network_redacted": True,
    }


def build_artifact(
    capture_mode: str, stack_root: str, configs_root: str, vault_root: str
) -> dict[str, Any]:
    return {
        "artifact_kind": "aoa.host-facts",
        "schema_version": "1",
        "capture_mode": capture_mode,
        "captured_at": datetime.now(timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z"),
        "captured_by": "scripts/aoa-host-facts",
        "platform": build_platform(capture_mode),
        "cpu": build_cpu(),
        "memory": build_memory(),
        "acceleration": read_drm(),
        "storage": build_storage(capture_mode, stack_root, vault_root),
        "runtime": build_runtime(),
        "paths": build_paths(stack_root, configs_root, vault_root),
        "redaction": build_redaction(capture_mode),
    }


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Capture machine-readable host facts for abyss-stack."
    )
    parser.add_argument(
        "--mode",
        choices=("public", "private"),
        default="public",
        help="Capture mode. Public is commit-safe. Private is local-only.",
    )
    parser.add_argument(
        "--write",
        help="Write JSON to the supplied path instead of stdout.",
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)

    stack_root = os.environ.get("AOA_STACK_ROOT", "/srv/abyss-stack")
    configs_root = os.environ.get("AOA_CONFIGS_ROOT", f"{stack_root}/Configs")
    vault_root = os.environ.get("AOA_VAULT_ROOT", "/abyss")

    artifact = build_artifact(args.mode, stack_root, configs_root, vault_root)
    payload = json.dumps(artifact, indent=2, ensure_ascii=False) + "\n"

    if args.write:
        path = Path(args.write)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(payload, encoding="utf-8")
        print(f"wrote {path}")
        return 0

    sys.stdout.write(payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
