#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path


def slugify(text: str) -> str:
    lowered = text.strip().lower()
    lowered = re.sub(r"[^a-z0-9]+", "-", lowered)
    lowered = lowered.strip("-")
    return lowered or "candidate"


def default_title(hook_id: str) -> str:
    return f"artifact hook {hook_id}"


def read_json(path: Path) -> dict:
    try:
        loaded = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise SystemExit(f"error: file not found: {path}") from exc
    except json.JSONDecodeError as exc:
        raise SystemExit(f"error: invalid json in {path}: {exc}") from exc
    if not isinstance(loaded, dict):
        raise SystemExit(f"error: expected a JSON object in {path}")
    return loaded


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Wrap a bounded aoa-evals artifact_to_verdict_hook candidate into a private abyss-stack export artifact."
    )
    parser.add_argument("--input-file", required=True)
    parser.add_argument("--record-id")
    parser.add_argument("--title")
    parser.add_argument("--summary")
    parser.add_argument("--write", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    stack_root = Path(os.environ.get("AOA_STACK_ROOT", "/srv/abyss-stack"))
    evals_root = stack_root / "Knowledge" / "federation" / "aoa-evals"
    schema_path = evals_root / "schemas" / "artifact-to-verdict-hook.schema.json"
    trace_bridge_path = evals_root / "docs" / "TRACE_EVAL_BRIDGE.md"
    checkpoint_posture_path = evals_root / "docs" / "SELF_AGENT_CHECKPOINT_EVAL_POSTURE.md"
    recurrence_path = evals_root / "docs" / "RECURRENCE_PROOF_PROGRAM.md"
    hook_example_paths = {
        "AOA-P-0006": evals_root / "examples" / "artifact_to_verdict_hook.self-agent-checkpoint-rollout.example.json",
        "AOA-P-0008": evals_root / "examples" / "artifact_to_verdict_hook.long-horizon-model-tier-orchestra.example.json",
        "AOA-P-0009": evals_root / "examples" / "artifact_to_verdict_hook.restartable-inquiry-loop.example.json",
    }

    input_path = Path(args.input_file).resolve()
    candidate_payload = read_json(input_path)
    if candidate_payload.get("surface_type") != "artifact_to_verdict_hook":
        raise SystemExit("error: candidate payload must use surface_type artifact_to_verdict_hook")

    hook_id = candidate_payload.get("hook_id")
    if not isinstance(hook_id, str) or not hook_id:
        raise SystemExit("error: candidate payload must include hook_id")

    playbook_id = candidate_payload.get("playbook_id")
    if not isinstance(playbook_id, str) or not playbook_id:
        raise SystemExit("error: candidate payload must include playbook_id")

    captured_at = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H%M%SZ")
    title = args.title or default_title(hook_id)
    summary = args.summary or f"Bounded aoa-evals artifact hook candidate for {hook_id}."
    record_id = args.record_id or f"{timestamp}__artifact-hook__{slugify(hook_id)}"

    ref_paths = [f"local:{schema_path}", f"local:{trace_bridge_path}"]
    if playbook_id == "AOA-P-0006":
        ref_paths.append(f"local:{checkpoint_posture_path}")
    if playbook_id == "AOA-P-0009":
        ref_paths.append(f"local:{recurrence_path}")
    example_path = hook_example_paths.get(playbook_id)
    if example_path is not None:
        ref_paths.append(f"local:{example_path}")

    rendered_input = json.dumps(candidate_payload, sort_keys=True, ensure_ascii=True).encode("utf-8")
    artifact = {
        "artifact_kind": "aoa.runtime-artifact-hook-candidate",
        "schema_version": "1",
        "capture_mode": "private",
        "exported_at": captured_at,
        "exported_by": "scripts/aoa-export-artifact-hook-candidate",
        "record_id": record_id,
        "title": title,
        "summary": summary,
        "hook_id": hook_id,
        "source_input_ref": f"local:{input_path}",
        "source_input_sha256": hashlib.sha256(rendered_input).hexdigest(),
        "aoa_evals_contract_refs": ref_paths,
        "candidate_payload": candidate_payload,
    }

    rendered = json.dumps(artifact, indent=2, ensure_ascii=True) + "\n"
    if args.write:
        latest_path = stack_root / "Logs" / "eval-exports" / "latest" / "artifact-hook" / f"{hook_id}.private.json"
        archive_dir = stack_root / "Logs" / "eval-exports" / "records" / f"{timestamp}__artifact-hook__{hook_id}"
        archive_path = archive_dir / "candidate.private.json"
        latest_path.parent.mkdir(parents=True, exist_ok=True)
        archive_dir.mkdir(parents=True, exist_ok=True)
        latest_path.write_text(rendered, encoding="utf-8")
        archive_path.write_text(rendered, encoding="utf-8")

    sys.stdout.write(rendered)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
