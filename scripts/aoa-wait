#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SMOKE_SCRIPT="${SCRIPT_DIR}/aoa-smoke"

profile="${AOA_STACK_PROFILE:-core}"
remaining_args=()

while (($#)); do
  case "$1" in
    --profile)
      shift
      (($#)) || { printf 'error: missing value after --profile\n' >&2; exit 1; }
      profile="$1"
      ;;
    --profile=*)
      profile="${1#*=}"
      ;;
    *)
      remaining_args+=("$1")
      ;;
  esac
  shift || true
done

timeout_s="${AOA_WAIT_TIMEOUT_S:-120}"
interval_s="${AOA_WAIT_INTERVAL_S:-5}"
deadline=$((SECONDS + timeout_s))

while ((SECONDS < deadline)); do
  if AOA_STACK_PROFILE="$profile" "$SMOKE_SCRIPT" --profile "$profile" "${remaining_args[@]}" >/dev/null 2>&1; then
    printf 'profile %s is ready\n' "$profile"
    exit 0
  fi
  sleep "$interval_s"
done

printf 'error: timeout waiting for profile %s\n' "$profile" >&2
exit 1
