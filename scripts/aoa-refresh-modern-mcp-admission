#!/usr/bin/env bash
set -euo pipefail

STACK=/srv/AbyssOS/abyss-stack
VENV="$STACK/Services/abyss-stack-mcp/venv/bin"
INSTALL_SYSTEMD="$STACK/Configs/scripts/aoa-install-systemd"
RUNTIME_REPAIR_SERVICE="abyss-stack-mcp-runtime-repair.service"
AUTO_REPAIR_MARKER="$STACK/Secrets/Configs/abyss-stack-mcp-runtime-auto-repair.enabled"
OPERATION_LOCK="$STACK/Services/abyss-stack-mcp/.runtime-operation.lock"
SOURCE_LOCK="$STACK/Services/abyss-stack-mcp/.source-projection.lock"
RUNTIME_LOCK="$STACK/Services/abyss-stack-mcp/.runtime-provision.lock"
REPAIR_FALLBACK="$STACK/Logs/mcp/admission/runtime-repair-fallback.units"
REGISTRY=/srv/AbyssOS/.aoa/organ-access/organ-registry.v2.source.json
DEPLOYMENT="$STACK/Logs/mcp/deployments/latest.json"
TARGETS="$STACK/Configs/mcp/services/abyss-stack-mcp/src/abyss_stack_mcp/runtime-targets.v1.json"
PUBLIC_KEY="$STACK/Secrets/Configs/abyss-stack-mcp-canary-ed25519-public-key.pem"
ROOT="$STACK/Logs/mcp/fleet-admission"
RUN="$ROOT/runs/$(date -u +%Y%m%dT%H%M%SZ)"
LOCK="$ROOT/.refresh.lock"
REBASE_DECISION_REF="owner://abyss-stack/decision/ABYSS-STACK-D-0109"
REBASE_TTL_SECONDS=86400
CANARY_WORKERS="${ABYSS_MCP_CANARY_WORKERS:-3}"

organs=(
  abyss-stack abyss-machine aoa-decisions aoa-memo aoa-session-memory
  aoa-evals aoa-kag aoa-stats aoa-4pda-connector aoa-telegram-connector
  aoa-discord-connector
)

production_units=(abyss-stack-mcp-read.service)
bootstrap_units=(abyss-stack-mcp-read-bootstrap.service)
for organ in "${organs[@]:1}"; do
  production_units+=("aoa-organ-mcp-read@${organ}.service")
  bootstrap_units+=("aoa-organ-mcp-read-bootstrap@${organ}.service")
done

bootstrap_started=0
production_handoff_state="inactive"
rebase_staging=""
canary_worker_pids=()
operation_lock_fd=""
source_lock_fd=""
runtime_lock_fd=""
repair_fallback_loaded=0
repair_fallback_units=()
repair_fallback_organs=()
repair_bootstrap_units=()
repair_bootstrap_organs=()

case "$CANARY_WORKERS" in
  ''|*[!0-9]*)
    printf 'modern MCP canary worker count must be an integer from 1 to 11\n' >&2
    exit 1
    ;;
esac
if ((CANARY_WORKERS < 1 || CANARY_WORKERS > ${#organs[@]})); then
  printf 'modern MCP canary worker count must be an integer from 1 to 11\n' >&2
  exit 1
fi

cleanup_canary_workers() {
  local pid

  for pid in "${canary_worker_pids[@]}"; do
    kill -TERM -- "-${pid}" >/dev/null 2>&1 || true
  done
  for pid in "${canary_worker_pids[@]}"; do
    wait "$pid" >/dev/null 2>&1 || true
  done
  canary_worker_pids=()
}

cleanup_recovery() {
  cleanup_canary_workers
  if [[ "$production_handoff_state" == "started" ]]; then
    systemctl --user stop "${production_units[@]}" >/dev/null 2>&1 || true
  fi
  if [[ "$bootstrap_started" -eq 1 ]]; then
    systemctl --user stop "${bootstrap_units[@]}" >/dev/null 2>&1 || true
  fi
  if [[ -n "$rebase_staging" ]]; then
    rm -f -- "$rebase_staging"
  fi
  close_stack_runtime_locks
  if [[ "$production_handoff_state" != "committed" && \
        ( -e "$REPAIR_FALLBACK" || -L "$REPAIR_FALLBACK" ) ]]; then
    restore_runtime_repair_fallback || \
      printf '%s\n' \
        'modern MCP admission failed to preserve the runtime-repair fallback' \
        >&2
  fi
}

trap cleanup_recovery EXIT

active_production_count() {
  local count=0
  local unit
  for unit in "${production_units[@]}"; do
    if systemctl --user is-active --quiet "$unit"; then
      ((count += 1))
    fi
  done
  printf '%s\n' "$count"
}

active_managed_unit_count() {
  local count=0
  local unit
  for unit in "$@"; do
    if systemctl --user is-active --quiet "$unit"; then
      ((count += 1))
    fi
  done
  printf '%s\n' "$count"
}

capture_canary_pair() {
  local process_unit=$1
  local current_root=$2
  local lkg_root=$3
  local stdout_root=$4
  local organ=$5
  local lkg_record
  local current_record

  "$VENV/abyss-stack-mcp-canary" \
    --organ "$organ" \
    --process-unit "$process_unit" \
    --purpose last-known-good \
    --ttl-seconds 3600 > "$stdout_root/${organ}-lkg.json"
  "$VENV/abyss-stack-mcp-canary" \
    --organ "$organ" \
    --process-unit "$process_unit" \
    --ttl-seconds 3600 > "$stdout_root/${organ}-current.json"
  lkg_record=$(jq -er .record_path "$stdout_root/${organ}-lkg.json")
  current_record=$(jq -er .record_path "$stdout_root/${organ}-current.json")
  install -m 0600 "$lkg_record" "$lkg_root/${organ}.read.json"
  install -m 0600 "$current_record" "$current_root/${organ}.read.json"
}

wait_for_canary_worker() {
  local completed_pid=""
  local pid
  local status=0
  local remaining_pids=()

  if wait -n -p completed_pid "${canary_worker_pids[@]}"; then
    status=0
  else
    status=$?
  fi
  for pid in "${canary_worker_pids[@]}"; do
    if [[ "$pid" != "$completed_pid" ]]; then
      remaining_pids+=("$pid")
    fi
  done
  canary_worker_pids=("${remaining_pids[@]}")
  return "$status"
}

capture_canary_family() {
  local process_unit=$1
  local current_root=$2
  local lkg_root=$3
  local stdout_root=$4
  local organ
  shift 4
  local -a selected_organs=("$@")

  if ((${#selected_organs[@]} == 0)); then
    selected_organs=("${organs[@]}")
  fi

  mkdir -p "$current_root" "$lkg_root" "$stdout_root"
  chmod 0700 "$current_root" "$lkg_root" "$stdout_root"
  canary_worker_pids=()
  for organ in "${selected_organs[@]}"; do
    VENV="$VENV" setsid --wait bash -euo pipefail -c "$(declare -f capture_canary_pair)
capture_canary_pair \"\$@\"" _ \
      "$process_unit" "$current_root" "$lkg_root" "$stdout_root" "$organ" &
    canary_worker_pids+=("$!")
    if ((${#canary_worker_pids[@]} >= CANARY_WORKERS)); then
      if ! wait_for_canary_worker; then
        cleanup_canary_workers
        return 1
      fi
    fi
  done
  while ((${#canary_worker_pids[@]})); do
    if ! wait_for_canary_worker; then
      cleanup_canary_workers
      return 1
    fi
  done
}

array_contains() {
  local needle=$1
  shift
  local item

  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

bootstrap_unit_for_organ() {
  local organ=$1

  if [[ "$organ" == "abyss-stack" ]]; then
    printf '%s\n' 'abyss-stack-mcp-read-bootstrap.service'
  else
    printf 'aoa-organ-mcp-read-bootstrap@%s.service\n' "$organ"
  fi
}

publish_admission() {
  local current_root=$1
  local lkg_root=$2
  local label=$3

  "$VENV/abyss-stack-mcp-fleet-admission" \
    --registry "$REGISTRY" \
    --deployment-manifest "$DEPLOYMENT" \
    --runtime-targets "$TARGETS" \
    --current-canary-root "$current_root" \
    --lkg-canary-root "$lkg_root" \
    --canary-public-key "$PUBLIC_KEY" \
    --evidence-root "$RUN/evidence-$label" \
    --output "$RUN/organ-registry.v2.$label.json" \
    --report "$RUN/report-$label.json" \
    --publish
}

ensure_stack_runtime_ready() {
  if "$INSTALL_SYSTEMD" --verify-abyss-stack-mcp-runtime=read >/dev/null 2>&1; then
    return 0
  fi

  printf '%s\n' \
    'modern MCP admission detected a drifted abyss-stack runtime; requesting guarded reprovision' \
    >&2
  [[ -f "$AUTO_REPAIR_MARKER" && ! -L "$AUTO_REPAIR_MARKER" && \
     "$(<"$AUTO_REPAIR_MARKER")" == "enabled" ]] || {
    printf '%s\n' \
      'modern MCP automatic runtime repair is not explicitly enabled for this host' \
      >&2
    return 1
  }
  "$INSTALL_SYSTEMD" --verify-abyss-stack-mcp-repair-eligibility
  systemctl --user reset-failed "$RUNTIME_REPAIR_SERVICE" \
    >/dev/null 2>&1 || true
  systemctl --user start "$RUNTIME_REPAIR_SERVICE"
  "$INSTALL_SYSTEMD" --verify-abyss-stack-mcp-runtime=read
}

lock_stack_runtime_consumers() {
  local lock_path

  for lock_path in "$OPERATION_LOCK" "$SOURCE_LOCK" "$RUNTIME_LOCK"; do
    [[ -f "$lock_path" && ! -L "$lock_path" ]] || {
      printf 'modern MCP admission runtime lock is unavailable or unsafe: %s\n' \
        "$lock_path" >&2
      return 1
    }
  done
  exec {operation_lock_fd}< "$OPERATION_LOCK"
  /usr/bin/flock --shared "$operation_lock_fd"
  exec {source_lock_fd}< "$SOURCE_LOCK"
  /usr/bin/flock --shared "$source_lock_fd"
  exec {runtime_lock_fd}< "$RUNTIME_LOCK"
  /usr/bin/flock --shared "$runtime_lock_fd"
}

close_stack_runtime_locks() {
  if [[ -n "$runtime_lock_fd" ]]; then
    exec {runtime_lock_fd}>&-
    runtime_lock_fd=""
  fi
  if [[ -n "$source_lock_fd" ]]; then
    exec {source_lock_fd}>&-
    source_lock_fd=""
  fi
  if [[ -n "$operation_lock_fd" ]]; then
    exec {operation_lock_fd}>&-
    operation_lock_fd=""
  fi
}

load_runtime_repair_fallback() {
  local fallback_unit
  local organ
  local managed_organ

  [[ -f "$REPAIR_FALLBACK" && ! -L "$REPAIR_FALLBACK" ]] || return 1
  [[ "$(stat -c '%a' "$REPAIR_FALLBACK")" == "600" ]] || return 1
  repair_fallback_units=()
  repair_fallback_organs=()
  repair_bootstrap_units=()
  repair_bootstrap_organs=()
  while IFS= read -r fallback_unit || [[ -n "$fallback_unit" ]]; do
    [[ "$fallback_unit" == "abyss-stack-mcp-read-fallback.service" || \
       "$fallback_unit" =~ ^aoa-organ-mcp-read-fallback@[A-Za-z0-9_.-]+\.service$ ]] || \
      return 1
    if [[ "$fallback_unit" == "abyss-stack-mcp-read-fallback.service" ]]; then
      organ="abyss-stack"
    else
      organ="${fallback_unit#aoa-organ-mcp-read-fallback@}"
      organ="${organ%.service}"
    fi
    array_contains "$organ" "${organs[@]}" || return 1
    ! array_contains "$organ" "${repair_fallback_organs[@]}" || return 1
    repair_fallback_units+=("$fallback_unit")
    repair_fallback_organs+=("$organ")
  done < "$REPAIR_FALLBACK"
  ((${#repair_fallback_units[@]})) || return 1
  for managed_organ in "${organs[@]}"; do
    if ! array_contains "$managed_organ" "${repair_fallback_organs[@]}"; then
      repair_bootstrap_organs+=("$managed_organ")
      repair_bootstrap_units+=("$(bootstrap_unit_for_organ "$managed_organ")")
    fi
  done
  repair_fallback_loaded=1
}

restore_runtime_repair_fallback() {
  if [[ "$repair_fallback_loaded" -ne 1 ]]; then
    load_runtime_repair_fallback || return 1
  fi
  systemctl --user reset-failed "${repair_fallback_units[@]}" \
    >/dev/null 2>&1 || true
  systemctl --user start "${repair_fallback_units[@]}"
}

complete_runtime_repair_fallback() {
  if [[ ! -e "$REPAIR_FALLBACK" && ! -L "$REPAIR_FALLBACK" ]]; then
    return 0
  fi
  load_runtime_repair_fallback || {
    printf '%s\n' 'modern MCP runtime-repair fallback marker is unsafe' >&2
    return 1
  }
  rm -f -- "$REPAIR_FALLBACK"
  repair_fallback_loaded=0
  repair_fallback_units=()
  repair_fallback_organs=()
  repair_bootstrap_units=()
  repair_bootstrap_organs=()
}

rebase_expired_registry() {
  local now_iso
  local expiry_iso
  local predecessor_digest
  local live_digest
  local rebased="$RUN/organ-registry.v2.rebased-shadow.json"

  now_iso=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  expiry_iso=$(date -u -d "@$((now_epoch + REBASE_TTL_SECONDS))" +%Y-%m-%dT%H:%M:%SZ)
  predecessor_digest=$(sha256sum "$REGISTRY" | cut -d ' ' -f 1)
  install -m 0600 "$REGISTRY" "$RUN/organ-registry.v2.expired-predecessor.json"
  "$VENV/aoa" organs registry-rebase-expired-v2 "$REGISTRY" \
    --owner-decision-ref "$REBASE_DECISION_REF" \
    --authored-at "$now_iso" \
    --expires-at "$expiry_iso" \
    --output "$rebased"
  "$VENV/aoa" organs registry-v2-validate "$rebased"
  live_digest=$(sha256sum "$REGISTRY" | cut -d ' ' -f 1)
  if [[ "$live_digest" != "$predecessor_digest" ]]; then
    printf 'modern MCP expired-registry predecessor changed during rebase\n' >&2
    exit 1
  fi
  rebase_staging="${REGISTRY}.rebase.$$"
  install -m 0600 "$rebased" "$rebase_staging"
  mv -T -- "$rebase_staging" "$REGISTRY"
  rebase_staging=""
}

build_preflight() {
  local label=$1
  local output="$RUN/${label}-admission-automation.json"

  "$VENV/python" -I -B -m abyss_stack_mcp.admission_automation \
    --registry "$REGISTRY" \
    --deployment-manifest "$DEPLOYMENT" \
    --runtime-targets "$TARGETS" \
    --canary-root "$STACK/Logs/mcp/canaries/latest" \
    --canary-public-key "$PUBLIC_KEY" \
    --deployed-root "$STACK" \
    --output-root "$STACK/Logs/mcp/admission" \
    --keeper-inbox-root "$STACK/Logs/mcp/admission/keeper-inbox" \
    > "$output"
  jq -e '.preflight.all_eligible == true and .preflight.eligible_count == 11 and .preflight.blocked_count == 0' \
    "$output" >/dev/null
}

catalog_matches_current_canaries() {
  local catalog="$STACK/Logs/mcp/admission/managed-contours.json"
  local latest_canary
  local organ
  local observed_at
  local receipt_id

  [[ -f "$catalog" && ! -L "$catalog" ]] || return 1
  for organ in "${organs[@]}"; do
    latest_canary="$STACK/Logs/mcp/canaries/latest/${organ}.read.json"
    [[ -f "$latest_canary" && ! -L "$latest_canary" ]] || return 1
    receipt_id=$(jq -er .receipt_id "$latest_canary") || return 1
    observed_at=$(jq -er .observed_at "$latest_canary") || return 1
    jq -e \
      --arg organ "$organ" \
      --arg receipt_id "$receipt_id" \
      --arg observed_at "$observed_at" '
        [.contours[] | select(
          .organ_id == $organ
          and .contour_id == "read"
          and .canary_receipt_id == $receipt_id
          and .canary_observed_at == $observed_at
        )] | length == 1
      ' "$catalog" >/dev/null || return 1
  done
}

if [[ ! -f "$REGISTRY" || -L "$REGISTRY" ]]; then
  printf 'modern MCP admission registry is unavailable or unsafe\n' >&2
  exit 1
fi

mkdir -p "$ROOT"
chmod 0700 "$ROOT"
if [[ -e "$LOCK" || -L "$LOCK" ]]; then
  [[ -f "$LOCK" && ! -L "$LOCK" ]] || {
    printf 'modern MCP admission refresh lock is unsafe\n' >&2
    exit 1
  }
else
  (
    umask 077
    set -o noclobber
    : > "$LOCK"
  ) 2>/dev/null || true
  [[ -f "$LOCK" && ! -L "$LOCK" ]] || {
    printf 'modern MCP admission refresh lock could not be created\n' >&2
    exit 1
  }
fi
chmod 0600 "$LOCK"
exec {refresh_lock_fd}<>"$LOCK"
flock --exclusive "$refresh_lock_fd"

ensure_stack_runtime_ready
lock_stack_runtime_consumers
if [[ -e "$REPAIR_FALLBACK" || -L "$REPAIR_FALLBACK" ]]; then
  load_runtime_repair_fallback || {
    printf '%s\n' 'modern MCP runtime-repair fallback marker is unsafe' >&2
    exit 1
  }
fi

now_epoch=$(date -u +%s)
deployment_manifest_id=$(jq -er .manifest_id "$DEPLOYMENT")
minimum_expiry=$(jq -r '[.records[] | .contours[] | select(.contour_id == "read" and .registry_state == "admitted") | .currentness_expires_at | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601] | min // 0' "$REGISTRY")
registry_expiry=$(jq -r '.expires_at | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601' "$REGISTRY")
admitted_count=$(jq -r '[.records[] | .contours[] | select(.contour_id == "read" and .registry_state == "admitted")] | length' "$REGISTRY")
production_identity_count=0
deployment_identity_count=$(jq -r --arg manifest_id "$deployment_manifest_id" '[.records[] | .contours[] | select(.contour_id == "read" and .registry_state == "admitted" and .runtime_identity.deployment_manifest_digest == $manifest_id)] | length' "$REGISTRY")
current_canary_count=0
active_unit_count=0
for organ in "${organs[@]}"; do
  latest_canary="$STACK/Logs/mcp/canaries/latest/${organ}.read.json"
  unit="aoa-organ-mcp-read@${organ}.service"
  [[ "$organ" == "abyss-stack" ]] && unit="abyss-stack-mcp-read.service"
  if jq -e --arg organ "$organ" --arg unit "$unit" '
    [.records[]
      | select(.organ_id == $organ)
      | .contours[]
      | select(.contour_id == "read" and .registry_state == "admitted")
      | .runtime_identity.process_identity
      | select(startswith("systemd-user:" + $unit + ":pid:"))
    ] | length == 1
  ' "$REGISTRY" >/dev/null; then
    ((production_identity_count += 1))
  fi
  if [[ -f "$latest_canary" && ! -L "$latest_canary" ]] && jq -e \
    --arg manifest_id "$deployment_manifest_id" \
    --arg unit "$unit" '
    .deployment_manifest_id == $manifest_id
    and (.canary_route | endswith("/last-known-good") | not)
    and .process_unit_name == $unit
    and (.process_identity | startswith("systemd-user:" + $unit + ":pid:"))
    and ((.expires_at | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) > now)
  ' "$latest_canary" >/dev/null; then
    ((current_canary_count += 1))
  fi
  if systemctl --user is-active --quiet "$unit"; then
    ((active_unit_count += 1))
  fi
done
production_admission_reusable=0
if [[ "$admitted_count" -eq 11 \
      && "$production_identity_count" -eq 11 \
      && "$deployment_identity_count" -eq 11 \
      && "$current_canary_count" -eq 11 \
      && "$minimum_expiry" -gt "$now_epoch" \
      && "$registry_expiry" -gt "$now_epoch" ]] \
    && catalog_matches_current_canaries; then
  production_admission_reusable=1
fi

if [[ "$production_admission_reusable" -eq 1 \
      && "$active_unit_count" -eq 11 ]]; then
  complete_runtime_repair_fallback
  exit 0
fi

mkdir -p \
  "$RUN" \
  "$RUN/evidence-bootstrap" \
  "$RUN/evidence-fallback" \
  "$RUN/evidence-production"
chmod 0700 \
  "$ROOT" \
  "$ROOT/runs" \
  "$RUN" \
  "$RUN/evidence-bootstrap" \
  "$RUN/evidence-fallback" \
  "$RUN/evidence-production"

if [[ "$registry_expiry" -le "$now_epoch" ]]; then
  rebase_expired_registry
fi

active_unit_count=$(active_production_count)
if [[ "$active_unit_count" -ne 11 ]]; then
  if [[ "$production_admission_reusable" -eq 1 ]]; then
    systemctl --user reset-failed "${production_units[@]}"
  elif [[ "$repair_fallback_loaded" -eq 1 ]]; then
    restore_runtime_repair_fallback
    [[ "$(active_managed_unit_count "${repair_fallback_units[@]}")" -eq \
       "${#repair_fallback_units[@]}" ]] || {
      printf 'modern MCP repair fallback did not remain exact during validation\n' >&2
      exit 1
    }
    if ((${#repair_bootstrap_units[@]})); then
      systemctl --user reset-failed \
        "${repair_bootstrap_units[@]}" \
        "${production_units[@]}"
      bootstrap_started=1
      systemctl --user start "${repair_bootstrap_units[@]}"
      [[ "$(active_managed_unit_count "${repair_bootstrap_units[@]}")" -eq \
         "${#repair_bootstrap_units[@]}" ]] || {
        printf 'modern MCP repair bootstrap did not fill the missing endpoint set\n' >&2
        exit 1
      }
      [[ "$(active_managed_unit_count "${repair_fallback_units[@]}")" -eq \
         "${#repair_fallback_units[@]}" ]] || {
        printf 'modern MCP repair fallback was displaced before production handoff\n' >&2
        exit 1
      }
    fi
    capture_canary_family \
      fallback \
      "$RUN/fallback-current" \
      "$RUN/fallback-lkg" \
      "$RUN/fallback-stdout" \
      "${repair_fallback_organs[@]}"
    if ((${#repair_bootstrap_organs[@]})); then
      capture_canary_family \
        bootstrap \
        "$RUN/fallback-current" \
        "$RUN/fallback-lkg" \
        "$RUN/fallback-stdout" \
        "${repair_bootstrap_organs[@]}"
    fi
    publish_admission "$RUN/fallback-current" "$RUN/fallback-lkg" fallback
    build_preflight fallback
    if ((${#repair_bootstrap_units[@]})); then
      systemctl --user stop "${repair_bootstrap_units[@]}"
      bootstrap_started=0
    fi
  else
    systemctl --user reset-failed "${bootstrap_units[@]}" "${production_units[@]}"
    bootstrap_started=1
    systemctl --user start "${bootstrap_units[@]}"
    [[ "$(active_production_count)" -eq 0 ]] || {
      printf 'modern MCP bootstrap recovery did not isolate production units\n' >&2
      exit 1
    }
    capture_canary_family \
      bootstrap \
      "$RUN/bootstrap-current" \
      "$RUN/bootstrap-lkg" \
      "$RUN/bootstrap-stdout"
    publish_admission "$RUN/bootstrap-current" "$RUN/bootstrap-lkg" bootstrap
    build_preflight bootstrap
    systemctl --user stop "${bootstrap_units[@]}"
    bootstrap_started=0
  fi
  production_handoff_state="started"
  systemctl --user start "${production_units[@]}"
  [[ "$(active_production_count)" -eq 11 ]] || {
    printf 'modern MCP production handoff did not start the exact fleet\n' >&2
    exit 1
  }
fi

capture_canary_family \
  production \
  "$RUN/production-current" \
  "$RUN/production-lkg" \
  "$RUN/production-stdout"
publish_admission "$RUN/production-current" "$RUN/production-lkg" production
build_preflight production

"$VENV/aoa" organs registry-v2-validate "$REGISTRY"
ln -sfn "runs/${RUN##*/}/report-production.json" "$ROOT/latest-report.json"
production_handoff_state="committed"
complete_runtime_repair_fallback
