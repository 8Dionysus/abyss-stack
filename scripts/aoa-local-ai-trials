def utc_now() -> str:
    return (
        datetime.now(timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z")
    )


def write_json(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")


def write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text.rstrip() + "\n", encoding="utf-8")


def write_text_exact(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def append_jsonl(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(payload, ensure_ascii=True) + "\n")


def run_phase_aware_skill_dispatch(
    *,
    phase: str,
    repo_root: Path,
    log_path: Path,
    intent_text: str,
    mutation_surface: str = "none",
    closeout_path: Path | None = None,
) -> dict[str, Any]:
    report: dict[str, Any] = {
        "artifact_kind": "aoa.local-ai-trial.skill-dispatch-report",
        "program_id": PROGRAM_ID,
        "phase": phase,
        "repo_root": str(repo_root.resolve()),
        "intent_text": intent_text,
        "mutation_surface": mutation_surface,
        "executed_at": utc_now(),
    }
    aoa_bin = shutil.which("aoa")
    if aoa_bin is None:
        final_report = {**report, "status": "failed", "reason": "missing `aoa` command in PATH"}
        write_json(log_path, final_report)
        print(f"[skills:{phase}] failed: missing `aoa` command in PATH")
        return final_report
    if not AOA_SDK_ROOT.exists():
        final_report = {
            **report,
            "status": "failed",
            "reason": f"missing aoa-sdk root: {AOA_SDK_ROOT}",
        }
        write_json(log_path, final_report)
        print(f"[skills:{phase}] failed: missing aoa-sdk root {AOA_SDK_ROOT}")
        return final_report

    command = [
        aoa_bin,
        "skills",
        "dispatch",
        str(repo_root.resolve()),
        "--phase",
        phase,
        "--intent-text",
        intent_text,
        "--mutation-surface",
        mutation_surface,
        "--root",
        str(AOA_SDK_ROOT),
        "--json",
    ]
    if closeout_path is not None:
        command.extend(["--closeout-path", str(closeout_path.resolve())])
    try:
        completed = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=AOA_SKILL_DISPATCH_TIMEOUT_S,
        )
    except subprocess.TimeoutExpired as exc:
        final_report = {
            **report,
            "status": "failed",
            "reason": "aoa skills dispatch timed out",
            "command": command,
            "timeout_s": AOA_SKILL_DISPATCH_TIMEOUT_S,
            "stdout": coerce_subprocess_text(exc.stdout),
            "stderr": coerce_subprocess_text(exc.stderr),
        }
        write_json(log_path, final_report)
        print(f"[skills:{phase}] failed: aoa skills dispatch timed out")
        return final_report

    if completed.returncode != 0:
        final_report = {
            **report,
            "status": "failed",
            "reason": "aoa skills dispatch returned a non-zero exit code",
            "command": command,
            "exit_code": completed.returncode,
            "stdout": completed.stdout,
            "stderr": completed.stderr,
        }
        write_json(log_path, final_report)
        print(f"[skills:{phase}] failed: non-zero exit code {completed.returncode}")
        return final_report

    try:
        dispatch_payload = json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        final_report = {
            **report,
            "status": "failed",
            "reason": f"invalid JSON from aoa skills dispatch: {exc}",
            "command": command,
            "stdout": completed.stdout,
            "stderr": completed.stderr,
        }
        write_json(log_path, final_report)
        print(f"[skills:{phase}] failed: invalid JSON from aoa skills dispatch")
        return final_report

    final_report = {
        **report,
        "status": "dispatched",
        "command": command,
        "dispatch_report": dispatch_payload,
        "stdout": completed.stdout,
    }
    write_json(log_path, final_report)
    activate_now = [item["skill_name"] for item in dispatch_payload.get("activate_now", [])]
    must_confirm = [item["skill_name"] for item in dispatch_payload.get("must_confirm", [])]
    blocked = dispatch_payload.get("blocked_actions", [])
    print(
        f"[skills:{phase}] activate_now={activate_now or ['none']} "
        f"must_confirm={must_confirm or ['none']} blocked={blocked or ['none']}"
    )
    return final_report


def absolute(path: str | Path) -> str:
    return str(Path(path).resolve())


def repo_path(repo: str, relative: str) -> str:
    return absolute(Path("/srv") / repo / relative)


def stack_path(relative: str) -> str:
    return absolute(STACK_ROOT / relative)


def configs_path(relative: str) -> str:
    return absolute(CONFIGS_ROOT / relative)


def route_endpoint(path: str) -> str:
    return f"http://127.0.0.1:5402{path}"


def langchain_endpoint(path: str) -> str:
    return f"{LANGCHAIN_BASE_URL}{path}"


def default_log_root_for(program_id: str) -> Path:
    return STACK_ROOT / "Logs" / "local-ai-trials" / program_id


def default_mirror_root_for(program_id: str) -> Path:
    return Path("/srv/Dionysus/reports/local-ai-trials") / program_id


def configure_program_runtime(*, program_id: str, run_url: str) -> None:
    global PROGRAM_ID, LOG_ROOT_DEFAULT, MIRROR_ROOT_DEFAULT, LANGCHAIN_RUN_URL, LANGCHAIN_BASE_URL
    PROGRAM_ID = program_id
    LOG_ROOT_DEFAULT = default_log_root_for(program_id)
    MIRROR_ROOT_DEFAULT = default_mirror_root_for(program_id)
    LANGCHAIN_RUN_URL = run_url
    LANGCHAIN_BASE_URL = run_url.rsplit("/", 1)[0]


def bool_word(value: bool) -> str:
    return "true" if value else "false"


def make_truth_status(
    *,
    source_authored: bool,
    deployed: bool,
    trial_proven: bool,
    live_available: bool,
    notes: list[str] | None = None,
) -> dict[str, Any]:
    return {
        "source_authored": bool(source_authored),
        "deployed": bool(deployed),
        "trial_proven": bool(trial_proven),
        "live_available": bool(live_available),
        "notes": notes or [],
    }


def normalize_truth_status(
    payload: Any,
    *,
    fallback: dict[str, Any],
) -> dict[str, Any]:
    if not isinstance(payload, dict):
        return fallback

    return make_truth_status(
        source_authored=bool(payload.get("source_authored")),
        deployed=bool(payload.get("deployed")),
        trial_proven=bool(payload.get("trial_proven")),
        live_available=bool(payload.get("live_available")),
        notes=[str(item) for item in payload.get("notes") or []],
    )


def infer_case_truth_status(
    case: dict[str, Any],
    *,
    status: str | None,
) -> dict[str, Any]:
    runtime = case.get("runtime_selection") or {}
    runtime_path = str(runtime.get("path") or "")
    source_refs = [str(item) for item in case.get("source_refs") or []]
    targets_deployed_runtime = (
        runtime_path.startswith("langchain-api")
        or runtime_path.startswith("route-api")
        or "langchain-api" in runtime_path
        or "route-api" in runtime_path
        or any(ref.startswith("/srv/abyss-stack/") for ref in source_refs)
    )
    trial_proven = status == "pass"
    live_available = trial_proven and targets_deployed_runtime

    notes = [
        "source_authored tracks the canonical trial contract in the source-owned runner.",
        "deployed tracks whether this case targets an operator-visible surface under /srv/abyss-stack.",
    ]
    if trial_proven:
        notes.append("trial_proven is backed by a passing case packet.")
    else:
        notes.append("No passing packet exists for this case yet, so trial_proven stays false.")
    if live_available:
        notes.append("live_available is true only because this case passed against a deployed runtime path.")
    elif targets_deployed_runtime:
        notes.append("This case targets the deployed runtime, but live availability is not yet proven by a passing packet.")
    else:
        notes.append("This case stays source-authored or worktree-local and should not be read as a live runtime claim.")

    return make_truth_status(
        source_authored=True,
        deployed=targets_deployed_runtime,
        trial_proven=trial_proven,
        live_available=live_available,
        notes=notes,
    )


def resolve_case_truth_status(
    case: dict[str, Any],
    result_summary: dict[str, Any] | None,
) -> dict[str, Any]:
    status = None
    if result_summary is not None:
        status = str(result_summary.get("status") or "planned")
    fallback = infer_case_truth_status(case, status=status)
    if result_summary is None:
        return fallback
    return normalize_truth_status(result_summary.get("truth_status"), fallback=fallback)


def program_wave_truth_status(*, gate_result: str) -> dict[str, Any]:
    deployed_runner = (SCRIPTS_ROOT / "aoa-local-ai-trials").exists()
    trial_proven = gate_result == "pass"
    live_available = trial_proven and deployed_runner
    notes = [
        "Wave-level source_authored refers to the canonical aoa-local-ai-trials contract.",
        "Wave-level deployed refers to the operator-visible runner under /srv/abyss-stack/Configs/scripts/aoa-local-ai-trials.",
    ]
    if trial_proven:
        notes.append("trial_proven is backed by a passing wave gate.")
    else:
        notes.append("No passing wave gate exists yet, so trial_proven stays false.")
    if live_available:
        notes.append("live_available is true only when the passing wave also maps to the deployed runner surface.")
    elif deployed_runner:
        notes.append("The deployed runner exists, but live availability is not yet backed by a passing wave gate.")
    else:
        notes.append("The source runner exists, but the deployed Configs mirror does not yet expose the same runner surface.")
    return make_truth_status(
        source_authored=True,
        deployed=deployed_runner,
        trial_proven=trial_proven,
        live_available=live_available,
        notes=notes,
    )


def truth_status_lines(truth_status: dict[str, Any]) -> list[str]:
    lines = [
        f"- source_authored: `{bool_word(bool(truth_status.get('source_authored')))}`",
        f"- deployed: `{bool_word(bool(truth_status.get('deployed')))}`",
        f"- trial_proven: `{bool_word(bool(truth_status.get('trial_proven')))}`",
        f"- live_available: `{bool_word(bool(truth_status.get('live_available')))}`",
    ]
    for note in truth_status.get("notes") or []:
        lines.append(f"- note: {note}")
    return lines


def truth_status_compact(truth_status: dict[str, Any]) -> str:
    return ", ".join(
        [
            f"source_authored={bool_word(bool(truth_status.get('source_authored')))}",
            f"deployed={bool_word(bool(truth_status.get('deployed')))}",
            f"trial_proven={bool_word(bool(truth_status.get('trial_proven')))}",
            f"live_available={bool_word(bool(truth_status.get('live_available')))}",
        ]
    )


def case_dir(log_root: Path, wave_id: str, case_id: str) -> Path:
    return log_root / "waves" / wave_id / case_id


def case_report_name(wave_id: str, case_id: str) -> str:
    return f"{DATE_STAMP}.{PROGRAM_ID}.{wave_id}.{case_id}.md"


def wave_index_name(wave_id: str) -> str:
    meta = WAVE_METADATA[wave_id]
    return f"{wave_id}-{meta['slug']}-index"


def format_command(parts: list[str]) -> str:
    return shlex.join(parts)


def coerce_subprocess_text(value: str | bytes | None) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return value


def run_command(parts: list[str], *, cwd: Path | None = None, timeout_s: float | None = None) -> dict[str, Any]:
    started = time.perf_counter()
    started_at = utc_now()
    try:
        proc = subprocess.run(
            parts,
            cwd=str(cwd) if cwd else None,
            text=True,
            capture_output=True,
            timeout=timeout_s,
            check=False,
        )
        timed_out = False
        exit_code = proc.returncode
        stdout = proc.stdout
        stderr = proc.stderr
    except subprocess.TimeoutExpired as exc:
        timed_out = True
        exit_code = 124
        stdout = coerce_subprocess_text(exc.stdout)
        stderr = coerce_subprocess_text(exc.stderr)
    finished_at = utc_now()
    elapsed_s = round(time.perf_counter() - started, 3)
    return {
        "command": parts,
        "display": format_command(parts),
        "cwd": str(cwd) if cwd else None,
        "started_at": started_at,
        "finished_at": finished_at,
        "elapsed_s": elapsed_s,
        "exit_code": exit_code,
        "timed_out": timed_out,
        "stdout": stdout,
        "stderr": stderr,
    }


def persist_command_result(case_root: Path, label: str, result: dict[str, Any]) -> dict[str, Any]:
    safe = label.replace("/", "-")
    out_path = case_root / "artifacts" / f"{safe}.stdout.txt"
    err_path = case_root / "artifacts" / f"{safe}.stderr.txt"
    meta_path = case_root / "artifacts" / f"{safe}.command.json"

    write_text(out_path, result["stdout"])
    write_text(err_path, result["stderr"])
    meta_payload = {
        "command": result["command"],
        "display": result["display"],
        "cwd": result["cwd"],
        "started_at": result["started_at"],
        "finished_at": result["finished_at"],
        "elapsed_s": result["elapsed_s"],
        "exit_code": result["exit_code"],
        "timed_out": result["timed_out"],
        "stdout_path": str(out_path),
        "stderr_path": str(err_path),
    }
    write_json(meta_path, meta_payload)
    return {
        "display": result["display"],
        "cwd": result["cwd"],
        "elapsed_s": result["elapsed_s"],
        "exit_code": result["exit_code"],
        "timed_out": result["timed_out"],
        "stdout_path": str(out_path),
        "stderr_path": str(err_path),
        "command_meta": str(meta_path),
    }


def http_get(url: str, *, timeout_s: float) -> dict[str, Any]:
    started = time.perf_counter()
    started_at = utc_now()
    headers: dict[str, str] = {}
    status_code: int | None = None
    body = ""
    error: str | None = None
    try:
        req = urllib.request.Request(url=url, method="GET")
        with urllib.request.urlopen(req, timeout=timeout_s) as resp:
            body = resp.read().decode("utf-8", errors="ignore")
            status_code = resp.status
            headers = dict(resp.headers.items())
    except urllib.error.HTTPError as exc:
        status_code = exc.code
        headers = dict(exc.headers.items()) if exc.headers else {}
        body = exc.read().decode("utf-8", errors="ignore")
        error = f"http_error {exc.code}"
    except Exception as exc:
        error = f"{type(exc).__name__}: {exc}"
    finished_at = utc_now()
    elapsed_s = round(time.perf_counter() - started, 3)
    return {
        "url": url,
        "display": f"GET {url}",
        "started_at": started_at,
        "finished_at": finished_at,
        "elapsed_s": elapsed_s,
        "status_code": status_code,
        "headers": headers,
        "body": body,
        "error": error,
        "ok": error is None and status_code == 200,
    }


def persist_http_result(case_root: Path, label: str, result: dict[str, Any]) -> dict[str, Any]:
    safe = label.replace("/", "-")
    body_path = case_root / "artifacts" / f"{safe}.http-body.txt"
    meta_path = case_root / "artifacts" / f"{safe}.http.json"

    write_text(body_path, result.get("body", ""))
    meta_payload = {
        "method": "GET",
        "url": result["url"],
        "display": result["display"],
        "started_at": result["started_at"],
        "finished_at": result["finished_at"],
        "elapsed_s": result["elapsed_s"],
        "status_code": result["status_code"],
        "headers": result.get("headers") or {},
        "ok": result["ok"],
        "error": result.get("error"),
        "body_path": str(body_path),
    }
    write_json(meta_path, meta_payload)
    return {
        "display": result["display"],
        "url": result["url"],
        "elapsed_s": result["elapsed_s"],
        "status_code": result["status_code"],
        "ok": result["ok"],
        "error": result.get("error"),
        "body_path": str(body_path),
        "meta_path": str(meta_path),
    }


def preview_json_value(
    value: Any,
    *,
    max_keys: int = 8,
    max_items: int = 3,
    max_string: int = 180,
    depth: int = 0,
    max_depth: int = 3,
) -> Any:
    if depth >= max_depth:
        if isinstance(value, (dict, list)):
            return f"<{type(value).__name__} truncated>"
        if isinstance(value, str) and len(value) > max_string:
            return value[:max_string].rstrip() + "..."
        return value

    if isinstance(value, dict):
        preview: dict[str, Any] = {}
        keys = list(value.keys())
        for key in keys[:max_keys]:
            preview[key] = preview_json_value(
                value[key],
                max_keys=max_keys,
                max_items=max_items,
                max_string=max_string,
                depth=depth + 1,
                max_depth=max_depth,
            )
        if len(keys) > max_keys:
            preview["__truncated_keys__"] = len(keys) - max_keys
        return preview

    if isinstance(value, list):
        preview_items = [
            preview_json_value(
                item,
                max_keys=max_keys,
                max_items=max_items,
                max_string=max_string,
                depth=depth + 1,
                max_depth=max_depth,
            )
            for item in value[:max_items]
        ]
        if len(value) > max_items:
            preview_items.append(f"<{len(value) - max_items} more items>")
        return preview_items

    if isinstance(value, str) and len(value) > max_string:
        return value[:max_string].rstrip() + "..."
    return value


def compact_prompt_slice(text: str, *, char_limit: int = 1400) -> str:
    try:
        parsed = json.loads(text)
    except json.JSONDecodeError:
        return compact_excerpt_for_prompt(text, non_empty_limit=12, char_limit=char_limit)

    rendered = json.dumps(preview_json_value(parsed), indent=2, ensure_ascii=True)
    if len(rendered) <= char_limit:
        return rendered
    rendered = rendered[:char_limit].rstrip()
    if "\n" in rendered:
        rendered = rendered.rsplit("\n", 1)[0]
    return rendered


def report_frontmatter(case: dict[str, Any], verdict: str, truth_status: dict[str, Any]) -> str:
    runtime = case.get("runtime_selection") or RUNTIME_SELECTION_DEFAULT
    lines = [
        "---",
        f"program_id: {PROGRAM_ID}",
        f"wave_id: {case['wave_id']}",
        f"case_id: {case['case_id']}",
        "repo_scope:",
    ]
    lines.extend(f"  - {item}" for item in case["repo_scope"])
    lines.extend(
        [
            f"task_family: {case['task_family']}",
            f"mutation_allowed: {str(case['mutation_allowed']).lower()}",
            "runtime_selection:",
            f"  preset: {runtime.get('preset') if runtime.get('preset') is not None else 'null'}",
            f"  profile: {runtime.get('profile') if runtime.get('profile') is not None else 'null'}",
            f"  path: {runtime.get('path') if runtime.get('path') is not None else 'null'}",
            f"model: {MODEL}",
            f"verdict: {verdict}",
            "truth_status:",
            f"  source_authored: {bool_word(bool(truth_status.get('source_authored')))}",
            f"  deployed: {bool_word(bool(truth_status.get('deployed')))}",
            f"  trial_proven: {bool_word(bool(truth_status.get('trial_proven')))}",
            f"  live_available: {bool_word(bool(truth_status.get('live_available')))}",
            "---",
        ]
    )
    return "\n".join(lines)


def render_report(
    case: dict[str, Any],
    run_manifest: dict[str, Any],
    result_summary: dict[str, Any],
    *,
    log_root: Path,
) -> str:
    verdict = result_summary["status"]
    truth_status = resolve_case_truth_status(case, result_summary)
    case_root = case_dir(log_root, case["wave_id"], case["case_id"])
    evidence_links = [
        f"- [case.spec.json]({case_root / 'case.spec.json'})",
        f"- [run.manifest.json]({case_root / 'run.manifest.json'})",
        f"- [result.summary.json]({case_root / 'result.summary.json'})",
    ]
    for ref in run_manifest.get("artifact_refs", []):
        evidence_links.append(f"- [artifact]({ref})")

    command_lines: list[str] = []
    for item in run_manifest.get("commands", []):
        command_lines.append(f"- `{item['display']}`")
        if item.get("stdout_path"):
            command_lines.append(f"  stdout: [{Path(item['stdout_path']).name}]({item['stdout_path']})")
        if item.get("stderr_path"):
            command_lines.append(f"  stderr: [{Path(item['stderr_path']).name}]({item['stderr_path']})")

    if not command_lines:
        command_lines.append("- No runtime command captured for this case.")

    failures = result_summary.get("observed", {}).get("failures") or ["None."]
    failure_lines = "\n".join(f"- {item}" for item in failures)

    follow_up = result_summary.get("next_action") or "No additional follow-up recorded."

    return "\n\n".join(
        [
            report_frontmatter(case, verdict, truth_status),
            f"# {case['title']}",
            "## Goal\n"
            + case.get("goal", "Run the frozen case under the local pilot reporting contract."),
            "## Inputs\n"
            + "\n".join(f"- {item}" for item in case.get("inputs", [])),
            "## Expected Result\n"
            + "\n".join(f"- {item}" for item in case.get("expected_report_lines", [])),
            "## Actual Result\n"
            + "\n".join(f"- {item}" for item in result_summary.get("observed", {}).get("highlights", [])),
            "## Truth Status\n" + "\n".join(truth_status_lines(truth_status)),
            "## Evidence\n"
            + "\n".join(evidence_links + ["", "Commands:"] + command_lines),
            "## Boundary Check\n"
            + result_summary["boundary_check"]["notes"],
            "## Verdict\n"
            + result_summary["reviewer_decision"]["notes"],
            "## Failures\n" + failure_lines,
            "## Follow-up\n" + follow_up,
        ]
    )


def render_wave_index_md(index_payload: dict[str, Any]) -> str:
    truth_status = normalize_truth_status(
        index_payload.get("truth_status"),
        fallback=program_wave_truth_status(
            gate_result=str(index_payload.get("gate_result") or "not-run")
        ),
    )
    lines = [
        f"# {index_payload['wave_id']} {index_payload['wave_title']}",
        "",
        index_payload.get("wave_summary", ""),
        "",
        f"- Gate result: `{index_payload['gate_result']}`",
        f"- Cases: `{index_payload['case_count']}`",
        f"- Status counts: `{json.dumps(index_payload['status_counts'], ensure_ascii=True)}`",
        f"- Next action: {index_payload['next_action']}",
        "",
        "## Truth Status",
        *truth_status_lines(truth_status),
        "",
        "## Cases",
    ]
    for case in index_payload["cases"]:
        status = case["status"]
        summary = case.get("summary", "")
        report_link = case.get("report_md")
        if report_link:
            lines.append(f"- `{case['case_id']}`: `{status}` [{Path(report_link).name}]({report_link})")
        else:
            lines.append(f"- `{case['case_id']}`: `{status}`")
        if summary:
            lines.append(f"  {summary}")
        if case.get("truth_status"):
            lines.append(f"  truth_status: {truth_status_compact(case['truth_status'])}")
    if index_payload.get("gate_detail"):
        lines.extend(["", "## Gate Detail", "```json", json.dumps(index_payload["gate_detail"], indent=2, ensure_ascii=True), "```"])
    return "\n".join(lines)


def wave_closeout_base_name(wave_id: str) -> str:
    return f"{wave_id}-closeout"


def wave_closeout_session_ref(wave_id: str) -> str:
    return f"session:abyss-stack:{PROGRAM_ID}:{wave_id}:closeout"


def wave_closeout_id(wave_id: str) -> str:
    return f"{PROGRAM_ID}-{wave_id}-closeout"


def runtime_wave_closeout_event_id(wave_id: str) -> str:
    return f"evt-runtime-wave-closeout-{PROGRAM_ID}-{wave_id}"


def runtime_wave_closeout_run_ref(wave_id: str) -> str:
    return f"run:abyss-stack:aoa-local-ai-trials:{PROGRAM_ID}:{wave_id}:closeout"


def runtime_wave_closeout_receipt(
    *,
    wave_id: str,
    index_payload: dict[str, Any],
    closeout_json_path: Path,
    closeout_md_path: Path,
    index_md_path: Path,
    closeout_submit_status_path: Path,
    status_payload: dict[str, Any],
) -> dict[str, Any]:
    reviewed_handoff_status = str(status_payload.get("status") or "unknown")
    truth_status = index_payload.get("truth_status")
    if not isinstance(truth_status, dict):
        truth_status = {}
    return {
        "event_kind": "runtime_wave_closeout_receipt",
        "event_id": runtime_wave_closeout_event_id(wave_id),
        "observed_at": utc_now(),
        "run_ref": runtime_wave_closeout_run_ref(wave_id),
        "session_ref": wave_closeout_session_ref(wave_id),
        "actor_ref": "abyss-stack:aoa-local-ai-trials",
        "object_ref": {
            "repo": "abyss-stack",
            "kind": "runtime_wave_closeout",
            "id": f"{PROGRAM_ID}:{wave_id}",
            "version": "runtime",
        },
        "evidence_refs": [
            {"kind": "wave_closeout_json", "ref": str(closeout_json_path)},
            {"kind": "wave_closeout_md", "ref": str(closeout_md_path)},
            {"kind": "wave_index_md", "ref": str(index_md_path)},
            {"kind": "closeout_submit_status", "ref": str(closeout_submit_status_path)},
        ],
        "payload": {
            "program_id": PROGRAM_ID,
            "wave_id": wave_id,
            "closeout_id": wave_closeout_id(wave_id),
            "gate_result": str(index_payload.get("gate_result") or "not-run"),
            "case_count": int(index_payload.get("case_count") or 0),
            "status_counts": index_payload.get("status_counts", {}),
            "next_action": index_payload.get("next_action", "unspecified"),
            "truth_status": truth_status,
            "terminal_gate": str(index_payload.get("gate_result") or "")
            in TERMINAL_WAVE_GATE_RESULTS,
            "reviewed_closeout_handoff_status": reviewed_handoff_status,
            "reviewed_closeout_audit_only": bool(status_payload.get("audit_only")),
            "reviewed_closeout_request_path": status_payload.get("request_path"),
            "reviewed_closeout_manifest_path": status_payload.get("manifest_path"),
            "reviewed_closeout_queued_manifest_path": status_payload.get(
                "queued_manifest_path"
            ),
            "reviewed_closeout_queue_depth": status_payload.get("queue_depth"),
            "reviewed_closeout_reason": status_payload.get("reason"),
        },
    }


def publish_runtime_wave_closeout_receipt(
    *,
    wave_id: str,
    index_payload: dict[str, Any],
    closeout_json_path: Path,
    closeout_md_path: Path,
    index_md_path: Path,
    closeout_submit_status_path: Path,
    status_payload: dict[str, Any],
) -> Path:
    receipt = runtime_wave_closeout_receipt(
        wave_id=wave_id,
        index_payload=index_payload,
        closeout_json_path=closeout_json_path,
        closeout_md_path=closeout_md_path,
        index_md_path=index_md_path,
        closeout_submit_status_path=closeout_submit_status_path,
        status_payload=status_payload,
    )
    append_jsonl(RUNTIME_WAVE_CLOSEOUT_RECEIPT_LOG, receipt)
    write_json(log_root := closeout_submit_status_path.with_suffix(".receipt.json"), receipt)
    return log_root


def write_wave_surfaces(
    *,
    log_root: Path,
    mirror_root: Path,
    wave_id: str,
    index_payload: dict[str, Any],
    submit_closeout: bool = False,
) -> None:
    index_base = wave_index_name(wave_id)
    index_json_path = log_root / f"{index_base}.json"
    index_md_path = log_root / f"{index_base}.md"
    mirror_index_md_path = mirror_root / f"{index_base}.md"
    index_md = render_wave_index_md(index_payload)

    write_json(index_json_path, index_payload)
    write_text(index_md_path, index_md)
    write_text(mirror_index_md_path, index_md)

    closeout_base = wave_closeout_base_name(wave_id)
    closeout_json_path = log_root / f"{closeout_base}.json"
    closeout_md_path = log_root / f"{closeout_base}.md"
    closeout_submit_status_path = log_root / f"{closeout_base}.submit.json"
    mirror_closeout_md_path = mirror_root / f"{closeout_base}.md"

    write_json(closeout_json_path, index_payload)
    write_text(closeout_md_path, index_md)
    write_text(mirror_closeout_md_path, index_md)

    if not submit_closeout:
        return

    gate_result = str(index_payload.get("gate_result") or "not-run")
    status_payload: dict[str, Any] = {
        "artifact_kind": "aoa.local-ai-trial.wave-closeout-submit",
        "program_id": PROGRAM_ID,
        "wave_id": wave_id,
        "closeout_id": wave_closeout_id(wave_id),
        "session_ref": wave_closeout_session_ref(wave_id),
        "attempted_at": utc_now(),
        "gate_result": gate_result,
        "reviewed_artifact_path": str(closeout_md_path),
        "audit_refs": [str(closeout_json_path), str(index_md_path)],
    }
    if gate_result not in TERMINAL_WAVE_GATE_RESULTS:
        final_status_payload = {
            **status_payload,
            "status": "skipped",
            "reason": f"gate_result {gate_result!r} is not terminal",
        }
        write_json(closeout_submit_status_path, final_status_payload)
        publish_runtime_wave_closeout_receipt(
            wave_id=wave_id,
            index_payload=index_payload,
            closeout_json_path=closeout_json_path,
            closeout_md_path=closeout_md_path,
            index_md_path=index_md_path,
            closeout_submit_status_path=closeout_submit_status_path,
            status_payload=final_status_payload,
        )
        return

    aoa_bin = shutil.which("aoa")
    if aoa_bin is None:
        final_status_payload = {
            **status_payload,
            "status": "failed",
            "reason": "missing `aoa` command in PATH",
        }
        write_json(closeout_submit_status_path, final_status_payload)
        publish_runtime_wave_closeout_receipt(
            wave_id=wave_id,
            index_payload=index_payload,
            closeout_json_path=closeout_json_path,
            closeout_md_path=closeout_md_path,
            index_md_path=index_md_path,
            closeout_submit_status_path=closeout_submit_status_path,
            status_payload=final_status_payload,
        )
        return
    if not AOA_SDK_ROOT.exists():
        final_status_payload = {
            **status_payload,
            "status": "failed",
            "reason": f"missing aoa-sdk root: {AOA_SDK_ROOT}",
        }
        write_json(closeout_submit_status_path, final_status_payload)
        publish_runtime_wave_closeout_receipt(
            wave_id=wave_id,
            index_payload=index_payload,
            closeout_json_path=closeout_json_path,
            closeout_md_path=closeout_md_path,
            index_md_path=index_md_path,
            closeout_submit_status_path=closeout_submit_status_path,
            status_payload=final_status_payload,
        )
        return

    command = [
        aoa_bin,
        "closeout",
        "submit-reviewed",
        str(closeout_md_path),
        "--session-ref",
        wave_closeout_session_ref(wave_id),
        "--audit-ref",
        str(closeout_json_path),
        "--audit-ref",
        str(index_md_path),
        "--closeout-id",
        wave_closeout_id(wave_id),
        "--trigger",
        AOA_CLOSEOUT_TRIGGER,
        "--allow-empty",
        "--overwrite",
        "--root",
        str(AOA_SDK_ROOT),
        "--json",
    ]
    try:
        completed = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=120,
        )
    except subprocess.TimeoutExpired as exc:
        final_status_payload = {
            **status_payload,
            "status": "failed",
            "reason": "aoa closeout submit-reviewed timed out",
            "command": command,
            "timeout_s": 120,
            "stdout": coerce_subprocess_text(exc.stdout),
            "stderr": coerce_subprocess_text(exc.stderr),
        }
        write_json(closeout_submit_status_path, final_status_payload)
        publish_runtime_wave_closeout_receipt(
            wave_id=wave_id,
            index_payload=index_payload,
            closeout_json_path=closeout_json_path,
            closeout_md_path=closeout_md_path,
            index_md_path=index_md_path,
            closeout_submit_status_path=closeout_submit_status_path,
            status_payload=final_status_payload,
        )
        return

    if completed.returncode != 0:
        final_status_payload = {
            **status_payload,
            "status": "failed",
            "reason": "aoa closeout submit-reviewed returned a non-zero exit code",
            "command": command,
            "exit_code": completed.returncode,
            "stdout": completed.stdout,
            "stderr": completed.stderr,
        }
        write_json(closeout_submit_status_path, final_status_payload)
        publish_runtime_wave_closeout_receipt(
            wave_id=wave_id,
            index_payload=index_payload,
            closeout_json_path=closeout_json_path,
            closeout_md_path=closeout_md_path,
            index_md_path=index_md_path,
            closeout_submit_status_path=closeout_submit_status_path,
            status_payload=final_status_payload,
        )
        return

    try:
        submit_payload = json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        final_status_payload = {
            **status_payload,
            "status": "failed",
            "reason": f"invalid JSON from aoa closeout submit-reviewed: {exc}",
            "command": command,
            "exit_code": completed.returncode,
            "stdout": completed.stdout,
            "stderr": completed.stderr,
        }
        write_json(closeout_submit_status_path, final_status_payload)
        publish_runtime_wave_closeout_receipt(
            wave_id=wave_id,
            index_payload=index_payload,
            closeout_json_path=closeout_json_path,
            closeout_md_path=closeout_md_path,
            index_md_path=index_md_path,
            closeout_submit_status_path=closeout_submit_status_path,
            status_payload=final_status_payload,
        )
        return

    build_report = submit_payload.get("build_report") or {}
    enqueue_report = build_report.get("enqueue_report") or {}
    final_status_payload = {
        **status_payload,
        "status": "submitted",
        "command": command,
        "audit_only": bool(submit_payload.get("audit_only")),
        "request_path": submit_payload.get("request_path"),
        "manifest_path": build_report.get("manifest_path"),
        "queued_manifest_path": enqueue_report.get("queued_manifest_path"),
        "queue_depth": enqueue_report.get("queue_depth"),
        "stdout": completed.stdout,
    }
    write_json(closeout_submit_status_path, final_status_payload)
    publish_runtime_wave_closeout_receipt(
        wave_id=wave_id,
        index_payload=index_payload,
        closeout_json_path=closeout_json_path,
        closeout_md_path=closeout_md_path,
        index_md_path=index_md_path,
        closeout_submit_status_path=closeout_submit_status_path,
        status_payload=final_status_payload,
    )


def contract_paths(log_root: Path) -> dict[str, Path]:
    return {
        "case.spec.schema.json": log_root / "contracts" / "case.spec.schema.json",
        "run.manifest.schema.json": log_root / "contracts" / "run.manifest.schema.json",
        "result.summary.schema.json": log_root / "contracts" / "result.summary.schema.json",
        "wave-index.schema.json": log_root / "contracts" / "wave-index.schema.json",
    }


def base_case(
    *,
    wave_id: str,
    case_id: str,
    title: str,
    repo_scope: list[str],
    task_family: str,
    source_refs: list[str],
    expected_result: dict[str, Any],
    goal: str,
    inputs: list[str],
    expected_report_lines: list[str],
    allowed_tools: list[str],
    observed_actions: list[dict[str, Any]] | None = None,
    notes: list[str] | None = None,
    runtime_selection: dict[str, Any] | None = None,
    scoring: dict[str, Any] | None = None,
    acceptance_checks: list[str] | None = None,
    mutation_policy: dict[str, Any] | None = None,
    mutation_allowed: bool = False,
) -> dict[str, Any]:
    return {
        "artifact_kind": "aoa.local-ai-trial.case-spec",
        "program_id": PROGRAM_ID,
        "wave_id": wave_id,
        "case_id": case_id,
        "title": title,
        "repo_scope": repo_scope,
        "task_family": task_family,
        "mutation_allowed": mutation_allowed,
        "mutation_policy": mutation_policy or {"mode": "forbidden"},
        "runtime_selection": runtime_selection or RUNTIME_SELECTION_DEFAULT,
        "allowed_tools": allowed_tools,
        "source_refs": source_refs,
        "observed_actions": observed_actions or [],
        "expected_result": expected_result,
        "scoring": scoring or {},
        "acceptance_checks": acceptance_checks or [],
        "goal": goal,
        "inputs": inputs,
        "expected_report_lines": expected_report_lines,
        "notes": notes or [],
    }


