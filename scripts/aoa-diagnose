#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/aoa-lib.sh
source "${SCRIPT_DIR}/aoa-lib.sh"

truth_goal="live_available"
against_value=""
write_path=""
write_latest=0
write_last_good_ref=0
write_reviewed_diagnosis_ref=0
reviewer="${AOA_DIAG_REVIEWER:-codex}"
diagnostic_id=""
session_refs=()
reviewed_diagnosis_refs=()
selector_args=()

while (($#)); do
  case "$1" in
    --truth-goal)
      shift
      (($#)) || aoa_die "missing value after --truth-goal"
      truth_goal="$1"
      ;;
    --truth-goal=*)
      truth_goal="${1#*=}"
      ;;
    --against)
      shift
      (($#)) || aoa_die "missing value after --against"
      against_value="$1"
      ;;
    --against=*)
      against_value="${1#*=}"
      ;;
    --with-session-ref)
      shift
      (($#)) || aoa_die "missing value after --with-session-ref"
      session_refs+=("$1")
      ;;
    --with-session-ref=*)
      session_refs+=("${1#*=}")
      ;;
    --with-reviewed-diagnosis-ref)
      shift
      (($#)) || aoa_die "missing value after --with-reviewed-diagnosis-ref"
      reviewed_diagnosis_refs+=("$1")
      ;;
    --with-reviewed-diagnosis-ref=*)
      reviewed_diagnosis_refs+=("${1#*=}")
      ;;
    --write)
      shift
      (($#)) || aoa_die "missing value after --write"
      write_path="$1"
      ;;
    --write=*)
      write_path="${1#*=}"
      ;;
    --write-latest)
      write_latest=1
      ;;
    --write-last-good-ref)
      write_last_good_ref=1
      ;;
    --write-reviewed-diagnosis-ref)
      write_reviewed_diagnosis_ref=1
      ;;
    --reviewer)
      shift
      (($#)) || aoa_die "missing value after --reviewer"
      reviewer="$1"
      ;;
    --reviewer=*)
      reviewer="${1#*=}"
      ;;
    --diagnostic-id)
      shift
      (($#)) || aoa_die "missing value after --diagnostic-id"
      diagnostic_id="$1"
      ;;
    --diagnostic-id=*)
      diagnostic_id="${1#*=}"
      ;;
    *)
      selector_args+=("$1")
      ;;
  esac
  shift || true
done

aoa_parse_profile_args "${selector_args[@]}"
if ((${#AOA_FORWARD_ARGS[@]} > 0)); then
  aoa_die "unknown argument(s): ${AOA_FORWARD_ARGS[*]}"
fi
aoa_resolve_modules

export AOA_DIAG_RESOLVED_PRESETS="${AOA_STACK_PRESET}"
AOA_DIAG_RESOLVED_PROFILES="$(aoa_join_csv "${AOA_PROFILE_NAMES[@]}")"
AOA_DIAG_RESOLVED_MODULES="$(aoa_join_csv "${AOA_PROFILE_MODULE_NAMES[@]}")"
export AOA_DIAG_RESOLVED_PROFILES
export AOA_DIAG_RESOLVED_MODULES

backend_args=(
  --truth-goal "$truth_goal"
)

if [[ -n "$against_value" ]]; then
  backend_args+=(--against "$against_value")
fi
if [[ -n "$write_path" ]]; then
  backend_args+=(--write "$write_path")
fi
if ((write_latest)); then
  backend_args+=(--write-latest)
fi
if ((write_last_good_ref)); then
  backend_args+=(--write-last-good-ref)
fi
if ((write_reviewed_diagnosis_ref)); then
  backend_args+=(--write-reviewed-diagnosis-ref)
fi
if [[ -n "$reviewer" ]]; then
  backend_args+=(--reviewer "$reviewer")
fi
if [[ -n "$diagnostic_id" ]]; then
  backend_args+=(--diagnostic-id "$diagnostic_id")
fi

session_ref=""
for session_ref in "${session_refs[@]}"; do
  backend_args+=(--with-session-ref "$session_ref")
done

reviewed_diagnosis_ref=""
for reviewed_diagnosis_ref in "${reviewed_diagnosis_refs[@]}"; do
  backend_args+=(--with-reviewed-diagnosis-ref "$reviewed_diagnosis_ref")
done

exec python "${SCRIPT_DIR}/../mechanics/diagnostic-spine/parts/diagnose-wrapper/aoa_diagnose.py" "${backend_args[@]}"
