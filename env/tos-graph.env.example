# Public-safe example only
# Live values belong under ${AOA_STACK_ROOT}/Secrets/Configs/tos-graph.env

# Optional runtime overrides for the preview-first tos-graph helper.
# Keep canonical ToS authority in Tree-of-Sophia and keep writeback disabled
# unless a reviewed mutation lane explicitly enables it.
TOS_GRAPH_NEO4J_URI=bolt://neo4j:7687
TOS_GRAPH_NEO4J_USER=neo4j
# Optional explicit override. When absent, tos-graph can fall back to
# NEO4J_AUTH from the mounted runtime stack env.
TOS_GRAPH_NEO4J_PASSWORD=CHANGE_ME
TOS_GRAPH_NEO4J_DATABASE=neo4j
TOS_GRAPH_ROUTE_DEFAULT=friedrich-nietzsche/thus-spoke-zarathustra/prologue-1
