# Public-safe example only
# Live values belong under ${AOA_STACK_ROOT}/Secrets/Configs/langchain-api.env

# Add only names and obviously fake placeholders here.
LANGCHAIN_API_SECRET=CHANGE_ME
AOA_INTERNAL_TOKEN=CHANGE_ME
AOA_FEDERATED_RUN_ENABLED=false
AOA_ROUTE_API_BASE_URL=http://route-api:5402

# Canonical chat defaults stay on llama.cpp unless a separate reviewed lane says otherwise.
# Override these only when langchain-api should target another OpenAI-compatible text backend.
LC_BASE_URL=http://llama-cpp:8080/v1
LC_API_KEY=EMPTY
LC_MODEL=qwen3.5:9b
LC_OPENAI_LITERAL_COMPLETIONS=false
LC_OPENAI_CHAT_TEMPLATE_ENABLE_THINKING=
