{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa.invalid/abyss-stack/reference-platform/schema.v1.json",
  "title": "AoA Host Facts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "capture_mode",
    "captured_at",
    "captured_by",
    "platform",
    "runtime",
    "paths"
  ],
  "properties": {
    "artifact_kind": {
      "const": "aoa.host-facts"
    },
    "schema_version": {
      "const": "1"
    },
    "capture_mode": {
      "enum": [
        "public",
        "private"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "captured_by": {
      "const": "scripts/aoa-host-facts"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_id",
        "os_version_id",
        "os_pretty_name",
        "kernel_release",
        "arch"
      ],
      "properties": {
        "os_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "os_version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "os_pretty_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "kernel_release": {
          "type": [
            "string",
            "null"
          ]
        },
        "arch": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostname": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "sockets": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cores_per_socket": {
          "type": [
            "integer",
            "null"
          ]
        },
        "threads_per_core": {
          "type": [
            "integer",
            "null"
          ]
        },
        "physical_cores_estimate": {
          "type": [
            "integer",
            "null"
          ]
        },
        "logical_cpus": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_mhz": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "swap_total_bytes": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "acceleration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dev_dri_present": {
          "type": "boolean"
        },
        "render_nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intel_drm_present": {
          "type": "boolean"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "query_path",
              "mounted"
            ],
            "properties": {
              "query_path": {
                "type": "string"
              },
              "resolved_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mount_target": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mounted": {
                "type": "boolean"
              },
              "fstype": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "size_bytes": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "available_bytes": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "size_bytes"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kname": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": "string"
              },
              "size_bytes": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "rotational": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "fstype": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mountpoints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "podman_present",
        "podman_rootless",
        "compose_backend",
        "systemd_user_available",
        "selinux_mode"
      ],
      "properties": {
        "podman_present": {
          "type": "boolean"
        },
        "podman_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "podman_rootless": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "compose_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "systemd_user_available": {
          "type": "boolean"
        },
        "selinux_mode": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stack_root",
        "configs_root",
        "vault_root",
        "stack_root_is_canonical",
        "stack_root_exists",
        "configs_root_exists",
        "vault_root_exists",
        "vault_root_mounted"
      ],
      "properties": {
        "stack_root": {
          "type": "string"
        },
        "configs_root": {
          "type": "string"
        },
        "vault_root": {
          "type": "string"
        },
        "stack_root_is_canonical": {
          "type": "boolean"
        },
        "stack_root_exists": {
          "type": "boolean"
        },
        "configs_root_exists": {
          "type": "boolean"
        },
        "vault_root_exists": {
          "type": "boolean"
        },
        "vault_root_mounted": {
          "type": "boolean"
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostname_redacted": {
          "type": "boolean"
        },
        "mount_sources_redacted": {
          "type": "boolean"
        },
        "device_serials_redacted": {
          "type": "boolean"
        },
        "network_redacted": {
          "type": "boolean"
        }
      }
    }
  }
}
