{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-abyss.dev/schemas/kag-cache-pair-current-observation.schema.json",
  "title": "Current OS Abyss KAG cache pair observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abyss_mcp_kag_cache_pair_observation_v1"},
    "observation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "wire_version": {"const": "2026-07-28"},
    "python_sdk": {"enum": [{"commit": "6f69a3758ebf2ee55ce050f58b470ce11af71133", "version": "2.0.0"}, {"commit": "0921d94a74db900dccd2d534842aa7b6160542d2", "version": "2.1.1"}]},
    "source_revisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "abyss_stack": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "aoa_kag": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "required": ["abyss_stack", "aoa_kag"]
    },
    "cache": {"const": {"scope": "private", "ttl_ms": 30000, "within_ttl_repeat_server_fetches": 1}},
    "subscription": {"const": {"events_consumed": 2, "tools_list_changed_honored": true}},
    "checks": {"const": {"explicit_refresh_replaces_stale_entry": true, "no_subscription_no_replay": true, "stale_catalog_cannot_authorize_removed_tool": true, "subscription_addition_invalidation": true, "subscription_removal_revocation": true, "ttl_expiry_refetch": true}},
    "inventories": {"const": {"after_explicit_refresh": ["kag_discover"], "after_subscription_add": ["kag_discover", "kag_transient_probe"], "after_subscription_remove": ["kag_discover"], "after_ttl_expiry": ["kag_discover", "kag_stale_probe"], "initial": ["kag_discover"], "stale_after_removal": ["kag_discover", "kag_stale_probe"], "stale_before_expiry": ["kag_discover"]}},
    "stable_registration_unchanged": {"const": true},
    "raw_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "0600"},
        "ref": {"type": "string", "pattern": "^local://"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["mode", "ref", "sha256"]
    },
    "verdict": {"const": "cache_pair_passed"},
    "claim_limits": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}}
  },
  "required": ["schema_version", "observation_id", "observed_at", "finished_at", "wire_version", "python_sdk", "source_revisions", "cache", "subscription", "checks", "inventories", "stable_registration_unchanged", "raw_receipt", "verdict", "claim_limits"]
}
