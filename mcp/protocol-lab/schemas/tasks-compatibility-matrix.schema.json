{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-abyss.dev/schemas/tasks-compatibility-matrix.schema.json",
  "title": "OS Abyss MCP Tasks implementation compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abyss_mcp_tasks_compatibility_matrix_v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "protocol_version": {"const": "2026-07-28"},
    "extension_id": {"const": "io.modelcontextprotocol/tasks"},
    "extension_maturity": {"const": "experimental"},
    "core_read_migration_independent": {"const": true},
    "production_tasks_allowed": {"const": false},
    "reference_pair": {
      "const": {
        "consumer_id": "rust-rmcp",
        "version": "3.1.2",
        "verdict": "wire_pass",
        "evidence_ref": "mcp/protocol-lab/fixtures/rmcp-3.1.2-tasks-adapter-pair-20260808.json"
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/consumer"}
    },
    "known_risks": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 12}}
  },
  "required": ["schema_version", "observed_at", "expires_at", "protocol_version", "extension_id", "extension_maturity", "core_read_migration_independent", "production_tasks_allowed", "reference_pair", "consumers", "known_risks"],
  "$defs": {
    "feature_state": {
      "enum": ["wire_pass", "wire_absent", "wire_blocked", "upstream_test_pass", "source_present_unpaired", "source_absent", "unproved", "not_applicable"]
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "advertisement": {"$ref": "#/$defs/feature_state"},
        "create_task": {"$ref": "#/$defs/feature_state"},
        "tasks_get": {"$ref": "#/$defs/feature_state"},
        "tasks_update": {"$ref": "#/$defs/feature_state"},
        "tasks_cancel": {"$ref": "#/$defs/feature_state"},
        "input_required": {"$ref": "#/$defs/feature_state"},
        "cancellation": {"$ref": "#/$defs/feature_state"},
        "notifications": {"$ref": "#/$defs/feature_state"},
        "restart_recovery": {"$ref": "#/$defs/feature_state"},
        "auth_binding": {"$ref": "#/$defs/feature_state"},
        "ttl_behavior": {"$ref": "#/$defs/feature_state"}
      },
      "required": ["advertisement", "create_task", "tasks_get", "tasks_update", "tasks_cancel", "input_required", "cancellation", "notifications", "restart_recovery", "auth_binding", "ttl_behavior"]
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consumer_id": {"type": "string", "minLength": 3},
        "kind": {"type": "string", "minLength": 3},
        "version": {"type": "string", "minLength": 1},
        "release_status": {"enum": ["stable", "unreleased"]},
        "source_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "artifact_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "core_2026_07_28": {"enum": ["wire_pass", "conformance_pass", "source_supported", "not_applicable"]},
        "features": {"$ref": "#/$defs/features"},
        "evidence_level": {"type": "string", "minLength": 3},
        "verdict": {"enum": ["ineligible", "blocked", "eligible_for_isolated_reference_pilots", "source_supported_unpaired", "reference_only"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "removal_conditions": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 12}}
      },
      "required": ["consumer_id", "kind", "version", "release_status", "source_revision", "artifact_digest", "core_2026_07_28", "features", "evidence_level", "verdict", "evidence_refs", "removal_conditions"]
    }
  }
}
