{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-abyss.dev/schemas/kag-handle-pair-current-observation.schema.json",
  "title": "Current OS Abyss KAG handle pair observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abyss_mcp_kag_handle_pair_observation_v1"},
    "observation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "wire_version": {"const": "2026-07-28"},
    "python_sdk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "version": {"type": "string", "pattern": "^2\\.[0-9]+\\.[0-9]+$"},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "required": ["commit", "version"],
      "allOf": [
        {
          "if": {"properties": {"version": {"const": "2.1.1"}}, "required": ["version"]},
          "then": {"required": ["artifact_digest"]}
        }
      ]
    },
    "source_revisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "abyss_stack": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "aoa_kag": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "required": ["abyss_stack", "aoa_kag"]
    },
    "handle_contract": {"const": {"bearer_verified_each_request": true, "opaque": true, "plaintext_observed_on_wire": false, "principal_binding": ["client_id", "issuer", "subject"], "raw_tokens_recorded": false, "ttl_seconds": 5.0}},
    "handle_checks": {"const": {"cross_request_replay": "denied", "expiry": "denied", "key_retirement_revocation": "denied", "principal_isolation": "denied", "same_request_replay": "allowed_read_only_idempotent", "same_request_result_unchanged": true, "tamper": "denied", "valid_round_trip": "passed"}},
    "rejection_shape": {"const": {"code": -32602, "data": {"reason": "invalid_request_state"}, "message": "Invalid or expired requestState"}},
    "owner_canary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "freshness_state": {"enum": ["current", "canonical_only"]},
        "owner": {"const": "abyss-stack"},
        "projection_exact_state": {"const": "current"},
        "schema_version": {"const": "aoa-kag-mcp-capabilities-v1"},
        "canonical_source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_source_digest": {"type": "string", "oneOf": [{"const": ""}, {"pattern": "^[0-9a-f]{64}$"}]}
      },
      "required": ["freshness_state", "owner", "projection_exact_state", "schema_version"]
    },
    "stable_registration_unchanged": {"const": true},
    "raw_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "0600"},
        "ref": {"type": "string", "pattern": "^local://"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["mode", "ref", "sha256"]
    },
    "verdict": {"const": "handle_pair_passed"},
    "claim_limits": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}}
  },
  "required": ["schema_version", "observation_id", "observed_at", "finished_at", "wire_version", "python_sdk", "source_revisions", "handle_contract", "handle_checks", "rejection_shape", "owner_canary", "stable_registration_unchanged", "raw_receipt", "verdict", "claim_limits"]
}
