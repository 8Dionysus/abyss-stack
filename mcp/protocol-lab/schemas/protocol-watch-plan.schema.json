{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-abyss.dev/schemas/protocol-watch-plan.schema.json",
  "title": "OS Abyss MCP protocol watch plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abyss_mcp_protocol_watch_plan_v1"},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "ttl_lead_seconds": {"type": "integer", "minimum": 60, "maximum": 604800},
    "ttl_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "pointer": {"type": "string", "pattern": "^/"}
      },
      "required": ["path", "pointer"]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input"}
    },
    "retention": {"$ref": "#/$defs/retention"},
    "claim_limits": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 3}
    }
  },
  "required": ["schema_version", "plan_id", "ttl_lead_seconds", "ttl_source", "inputs", "claim_limits"],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "kind": {"enum": ["file", "tree", "executable", "https_json"]},
        "path": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "command": {"type": "string", "minLength": 1},
        "probe_argv": {
          "type": "array",
          "items": {"type": "string"}
        },
        "feature_argv": {
          "type": "array",
          "items": {"type": "string"}
        },
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "select": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^/"}
        },
        "required": {"type": "boolean"}
      },
      "required": ["input_id", "kind", "required"],
      "allOf": [
        {"if": {"properties": {"kind": {"const": "file"}}}, "then": {"required": ["path"]}},
        {"if": {"properties": {"kind": {"const": "tree"}}}, "then": {"required": ["paths"]}},
        {"if": {"properties": {"kind": {"const": "executable"}}}, "then": {"required": ["command", "probe_argv", "feature_argv"]}},
        {"if": {"properties": {"kind": {"const": "https_json"}}}, "then": {"required": ["url", "select"]}}
      ]
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_successful_runs": {"type": "integer", "minimum": 0},
        "max_successful_bytes": {"type": "integer", "minimum": 0},
        "max_successful_age_seconds": {"type": "integer", "minimum": 0},
        "max_failed_runs": {"type": "integer", "minimum": 0},
        "max_failed_bytes": {"type": "integer", "minimum": 0},
        "max_failed_age_seconds": {"type": "integer", "minimum": 0},
        "retain_failed_diagnostics": {"type": "integer", "minimum": 0},
        "max_observations": {"type": "integer", "minimum": 0},
        "max_observation_bytes": {"type": "integer", "minimum": 0},
        "max_observation_age_seconds": {"type": "integer", "minimum": 0},
        "disposable_roots": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "diagnostic_roots": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "cache_roots": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "receipt_archive_root": {"type": "string", "minLength": 1},
        "pin_file": {"type": "string", "minLength": 1}
      }
    }
  }
}
