{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-abyss.dev/schemas/protocol-watch-run-verdict.schema.json",
  "title": "OS Abyss MCP protocol watcher public-safe run verdict",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abyss_mcp_protocol_watch_run_verdict_v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "verdict": {"const": "compatible_for_lab_and_read_canary"},
    "facts": {
      "const": {
        "auth_schema_trace_limits_passed": true,
        "cache_refresh_and_removal_revocation_passed": true,
        "client_extension_capability_absent": true,
        "frozen_core_conformance_passed": true,
        "modern_cancellation_propagated": true,
        "production_cutover_allowed": false,
        "request_state_isolation_passed": true,
        "stable_modern_codex_lab_passed": true,
        "stable_post_rollback_canary_passed": true
      }
    },
    "receipt_digests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {"$ref": "#/$defs/digest"},
        "cache": {"$ref": "#/$defs/digest"},
        "codex": {"$ref": "#/$defs/digest"},
        "conformance": {"$ref": "#/$defs/digest"},
        "handle": {"$ref": "#/$defs/digest"},
        "rollback": {"$ref": "#/$defs/digest"}
      },
      "required": ["adapter", "cache", "codex", "conformance", "handle", "rollback"]
    },
    "claim_limits": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 3}}
  },
  "required": ["schema_version", "observed_at", "verdict", "facts", "receipt_digests", "claim_limits"],
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
