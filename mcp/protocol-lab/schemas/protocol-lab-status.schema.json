{
  "$id": "https://abyss-stack.local/schemas/mcp-protocol-lab-status.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "abyss_mcp_protocol_lab_status_v1"
    },
    "evaluated_at": {
      "format": "date-time",
      "type": "string"
    },
    "evidence_expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "matrix_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "observation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "status_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "production_protocol": {
      "const": "2025-11-25"
    },
    "next_protocol": {
      "const": "2026-07-28"
    },
    "next_release_status": {
      "enum": [
        "release_candidate",
        "final"
      ]
    },
    "migration_allowed": {
      "type": "boolean"
    },
    "read_only_pilot_allowed": {
      "type": "boolean"
    },
    "tasks_extension_allowed": {
      "type": "boolean"
    },
    "effectful_migration_allowed": {
      "const": false
    },
    "stable_registration_retained": {
      "const": true
    },
    "authority_move_combined": {
      "const": false
    },
    "gate_counts": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "minimum": 0,
          "type": "integer"
        },
        "blocked": {
          "minimum": 0,
          "type": "integer"
        },
        "pending": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "blocked",
        "pending"
      ],
      "type": "object"
    },
    "passed_gate_ids": {
      "items": {
        "pattern": "^P1-[0-9]{2}$",
        "type": "string"
      },
      "type": "array"
    },
    "remaining_gate_ids": {
      "items": {
        "pattern": "^P1-[0-9]{2}$",
        "type": "string"
      },
      "type": "array"
    },
    "reason_codes": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "next_action": {
      "minLength": 3,
      "type": "string"
    },
    "claim_limits": {
      "items": {
        "minLength": 3,
        "type": "string"
      },
      "minItems": 5,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "evaluated_at",
    "evidence_expires_at",
    "matrix_digest",
    "observation_digest",
    "status_digest",
    "production_protocol",
    "next_protocol",
    "next_release_status",
    "migration_allowed",
    "read_only_pilot_allowed",
    "tasks_extension_allowed",
    "effectful_migration_allowed",
    "stable_registration_retained",
    "authority_move_combined",
    "gate_counts",
    "passed_gate_ids",
    "remaining_gate_ids",
    "reason_codes",
    "next_action",
    "claim_limits"
  ],
  "title": "OS Abyss MCP protocol lab status",
  "type": "object"
}
