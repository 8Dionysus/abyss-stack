{
  "$id": "https://abyss-stack.local/schemas/mcp-protocol-lab-status.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abyss_mcp_protocol_lab_status_v2"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "evidence_expires_at": {"type": "string", "format": "date-time"},
    "matrix_digest": {"$ref": "#/$defs/digest"},
    "observation_digest": {"$ref": "#/$defs/digest"},
    "codex_lab_observation_digest": {"$ref": "#/$defs/digest"},
    "stable_rollback_observation_digest": {"$ref": "#/$defs/digest"},
    "tasks_matrix_digest": {"$ref": "#/$defs/digest"},
    "tasks_pilot_digest": {"$ref": "#/$defs/digest"},
    "rmcp_tasks_pair_digest": {"$ref": "#/$defs/digest"},
    "inspector_tasks_blocker_digest": {"$ref": "#/$defs/digest"},
    "live_modern_fleet_digest": {"$ref": "#/$defs/digest"},
    "codex_tasks_production_pair_digest": {"$ref": "#/$defs/digest"},
    "tasks_evidence_expires_at": {"type": "string", "format": "date-time"},
    "status_digest": {"$ref": "#/$defs/digest"},
    "production_protocol": {"const": "2026-07-28"},
    "next_protocol": {"const": "2026-07-28"},
    "next_release_status": {"const": "final"},
    "read_only_pilot_allowed": {"type": "boolean"},
    "read_only_pilot_completed": {"type": "boolean"},
    "core_read_migration_allowed": {"type": "boolean"},
    "tasks_extension_allowed": {"type": "boolean"},
    "tasks_extension_maturity": {"const": "experimental"},
    "tasks_reference_consumer": {"const": "rust-rmcp-3.1.2"},
    "tasks_reference_pair_passed": {"const": true},
    "tasks_inspector_strict_pair_blocked": {"const": true},
    "tasks_codex_consumer_eligible": {"type": "boolean"},
    "tasks_production_enabled": {"const": true},
    "tasks_notifications_proven": {"const": false},
    "tasks_blockers": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "candidate_protocol_ready": {"const": true},
    "internal_effect_protocol_ready": {"const": true},
    "candidate_migration_allowed": {"const": false},
    "internal_effect_migration_allowed": {"const": false},
    "external_effect_migration_allowed": {"const": false},
    "stable_registration_retained": {"const": true},
    "authority_move_combined": {"const": false},
    "gate_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0}
      },
      "required": ["passed", "blocked", "pending"]
    },
    "passed_gate_ids": {"$ref": "#/$defs/gate_ids"},
    "remaining_gate_ids": {"$ref": "#/$defs/gate_ids"},
    "remaining_core_gate_ids": {"$ref": "#/$defs/gate_ids"},
    "remaining_tasks_gate_ids": {"$ref": "#/$defs/gate_ids"},
    "production_cutover_blockers": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
      "minItems": 0,
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "next_action": {"type": "string", "minLength": 3},
    "claim_limits": {"type": "array", "items": {"type": "string", "minLength": 3}, "minItems": 5}
  },
  "required": [
    "schema_version", "evaluated_at", "evidence_expires_at", "matrix_digest",
    "observation_digest", "codex_lab_observation_digest",
    "stable_rollback_observation_digest", "tasks_matrix_digest",
    "tasks_pilot_digest", "rmcp_tasks_pair_digest",
    "inspector_tasks_blocker_digest", "live_modern_fleet_digest",
    "codex_tasks_production_pair_digest", "tasks_evidence_expires_at", "status_digest",
    "production_protocol", "next_protocol", "next_release_status",
    "read_only_pilot_allowed", "read_only_pilot_completed",
    "core_read_migration_allowed", "tasks_extension_allowed",
    "tasks_extension_maturity", "tasks_reference_consumer",
    "tasks_reference_pair_passed", "tasks_inspector_strict_pair_blocked",
    "tasks_codex_consumer_eligible", "tasks_production_enabled",
    "tasks_notifications_proven", "tasks_blockers", "candidate_protocol_ready",
    "internal_effect_protocol_ready",
    "candidate_migration_allowed", "internal_effect_migration_allowed",
    "external_effect_migration_allowed", "stable_registration_retained",
    "authority_move_combined", "gate_counts", "passed_gate_ids",
    "remaining_gate_ids", "remaining_core_gate_ids",
    "remaining_tasks_gate_ids", "production_cutover_blockers",
    "reason_codes", "next_action", "claim_limits"
  ],
  "title": "OS Abyss MCP protocol lab status",
  "type": "object",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gate_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^P1-[0-9]{2}$"},
      "uniqueItems": true
    }
  }
}
