{
  "$defs": {
    "ExposureRollbackBinding": {
      "additionalProperties": false,
      "properties": {
        "primitive_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Primitive Id",
          "type": "string"
        },
        "rollback_route": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Rollback Route",
          "type": "string"
        },
        "tool_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Tool Id",
          "type": "string"
        }
      },
      "required": [
        "tool_id",
        "primitive_id",
        "rollback_route"
      ],
      "title": "ExposureRollbackBinding",
      "type": "object"
    }
  },
  "$id": "https://8dionysus.github.io/schemas/abyss-stack-mcp/progressive-exposure-materialization-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "allowed"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "baseline_admission_ref": {
            "const": "receipt://d0/baseline-ready"
          }
        },
        "required": [
          "baseline_admission_ref"
        ]
      }
    }
  ],
  "properties": {
    "activation_authorized": {
      "const": false,
      "default": false,
      "title": "Activation Authorized",
      "type": "boolean"
    },
    "baseline_admission_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Admission Ref"
    },
    "contains_secrets": {
      "const": false,
      "default": false,
      "title": "Contains Secrets",
      "type": "boolean"
    },
    "decision": {
      "enum": [
        "allowed",
        "denied"
      ],
      "title": "Decision",
      "type": "string"
    },
    "execution_authorized": {
      "const": false,
      "default": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "instruction_authority": {
      "const": "none",
      "default": "none",
      "title": "Instruction Authority",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "receipt_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "rollback_bindings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExposureRollbackBinding"
      },
      "title": "Rollback Bindings",
      "type": "array"
    },
    "schema_version": {
      "const": "abyss_stack_exposure_materialization_receipt_v1",
      "default": "abyss_stack_exposure_materialization_receipt_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "visible_bytes": {
      "minimum": 0,
      "title": "Visible Bytes",
      "type": "integer"
    },
    "visible_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visible Tokens"
    },
    "visible_tool_ids": {
      "default": [],
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Visible Tool Ids",
      "type": "array"
    }
  },
  "required": [
    "receipt_id",
    "request_id",
    "plan_id",
    "decision",
    "observed_at",
    "expires_at",
    "snapshot_id",
    "source_digest",
    "visible_bytes"
  ],
  "title": "ExposureMaterializationReceipt",
  "type": "object"
}
