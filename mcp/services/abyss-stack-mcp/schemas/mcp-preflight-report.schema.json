{
  "$defs": {
    "PreflightCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Check Id",
          "type": "string"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ref"
        },
        "expected_identity": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Identity"
        },
        "observed_identity": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Identity"
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "status": {
          "enum": [
            "passed",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "status"
      ],
      "title": "PreflightCheck",
      "type": "object"
    }
  },
  "$id": "https://8dionysus.github.io/schemas/abyss-stack-mcp/mcp-preflight-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/PreflightCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "contains_secrets": {
      "const": false,
      "default": false,
      "title": "Contains Secrets",
      "type": "boolean"
    },
    "contour_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Contour Id",
      "type": "string"
    },
    "eligible_to_start": {
      "title": "Eligible To Start",
      "type": "boolean"
    },
    "next_safe_step": {
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Next Safe Step",
      "type": "string"
    },
    "organ_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Organ Id",
      "type": "string"
    },
    "owner_acceptance_inferred": {
      "const": false,
      "default": false,
      "title": "Owner Acceptance Inferred",
      "type": "boolean"
    },
    "policy_family": {
      "enum": [
        "read",
        "candidate",
        "internal_effect",
        "external_effect"
      ],
      "title": "Policy Family",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "registry_admission_inferred": {
      "const": false,
      "default": false,
      "title": "Registry Admission Inferred",
      "type": "boolean"
    },
    "report_id": {
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Report Id",
      "type": "string"
    },
    "restart_loop_allowed": {
      "const": false,
      "default": false,
      "title": "Restart Loop Allowed",
      "type": "boolean"
    },
    "schema_version": {
      "const": "abyss_mcp_preflight_report_v1",
      "default": "abyss_mcp_preflight_report_v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "organ_id",
    "contour_id",
    "policy_family",
    "checked_at",
    "eligible_to_start",
    "checks",
    "reason_codes",
    "next_safe_step"
  ],
  "title": "MCPPreflightReport",
  "type": "object"
}
