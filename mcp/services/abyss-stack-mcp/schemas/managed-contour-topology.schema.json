      "required": [
        "binding_id",
        "organ_id",
        "contour_id",
        "service_id",
        "unit_name",
        "unit_path",
        "endpoint_ref",
        "protocol_version",
        "credential_path",
        "auth_manifest_path",
        "auth_manifest_key",
        "executable_path",
        "executable_resolved_path",
        "executable_digest",
        "schema_paths",
        "schema_bundle_digest",
        "owner_validator_path",
        "owner_validator_digest",
        "required_environment",
        "unit_credential_binding"
      ],
      "title": "ManagedContourTopologyEntry",
      "type": "object"
    }
  },
  "$id": "https://8dionysus.github.io/schemas/abyss-stack-mcp/managed-contour-topology.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contours": {
      "items": {
        "$ref": "#/$defs/ManagedContourTopologyEntry"
      },
      "minItems": 1,
      "title": "Contours",
      "type": "array"
    },
    "schema_version": {
      "const": "abyss_mcp_managed_contour_topology_v1",
      "default": "abyss_mcp_managed_contour_topology_v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "contours"
  ],
  "title": "ManagedContourTopology",
  "type": "object"
}
