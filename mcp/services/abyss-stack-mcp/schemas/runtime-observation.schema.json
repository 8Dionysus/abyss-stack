              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptance Ref"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "accepted_at": {
          "anyOf": [
            {
              "format": "date-time",
