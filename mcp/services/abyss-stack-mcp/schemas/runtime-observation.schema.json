{
  "$defs": {
    "CanaryObservation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "succeeded": {
                "const": true
              }
            },
            "required": [
              "succeeded"
            ]
          },
          "then": {
            "properties": {
              "canary_ref": {
                "type": "string"
              },
              "evidence": {
                "properties": {
                  "evidence_refs": {
                    "minItems": 1
                  }
                }
              },
              "result_grounded": {
                "const": true
              }
            },
            "required": [
              "result_grounded",
              "canary_ref",
              "evidence"
            ]
          }
        }
      ],
      "properties": {
        "canary_ref": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canary Ref"
        },
        "canary_route": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Canary Route",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/LinkEvidence"
        },
        "result_grounded": {
          "title": "Result Grounded",
          "type": "boolean"
        },
        "succeeded": {
          "title": "Succeeded",
          "type": "boolean"
        }
      },
      "required": [
        "succeeded",
        "result_grounded",
        "canary_route",
        "evidence"
      ],
      "title": "CanaryObservation",
      "type": "object"
    },
    "CentralProofObservation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "passed"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "evaluated_at": {
                "format": "date-time",
                "type": "string"
              },
              "evidence": {
                "properties": {
                  "evidence_refs": {
                    "minItems": 1
                  },
                  "state": {
                    "enum": [
                      "exact",
                      "compatible_drift"
                    ]
                  }
                }
              },
              "proof_ref": {
                "type": "string"
              },
              "proved_canary_ref": {
                "type": "string"
              },
              "proved_consumer_registration_ref": {
                "type": "string"
              },
              "proved_deploy_revision": {
                "type": "string"
              },
              "proved_deploy_tree_digest": {
                "type": "string"
              },
              "proved_package_digest": {
                "type": "string"
              },
              "proved_process_identity": {
                "type": "string"
              },
              "proved_server_schema_digest": {
                "type": "string"
              },
              "proved_source_revision": {
                "type": "string"
              },
              "proved_source_tree_digest": {
                "type": "string"
              }
            },
            "required": [
              "proof_ref",
              "evaluated_at",
              "proved_source_revision",
              "proved_source_tree_digest",
              "proved_package_digest",
              "proved_deploy_revision",
              "proved_deploy_tree_digest",
              "proved_process_identity",
              "proved_server_schema_digest",
              "proved_consumer_registration_ref",
              "proved_canary_ref",
              "evidence"
            ]
          }
        }
      ],
      "properties": {
        "evaluated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated At"
        },
        "evidence": {
          "$ref": "#/$defs/LinkEvidence"
        },
        "proof_ref": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proof Ref"
        },
        "proved_canary_ref": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proved Canary Ref"
        },
        "proved_consumer_registration_ref": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proved Consumer Registration Ref"
        },
        "proved_deploy_revision": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proved Deploy Revision"
        },
        "proved_deploy_tree_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proved Deploy Tree Digest"
        },
        "proved_package_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proved Package Digest"
        },
        "proved_process_identity": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proved Process Identity"
        },
        "proved_server_schema_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proved Server Schema Digest"
        },
        "proved_source_revision": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proved Source Revision"
        },
        "proved_source_tree_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proved Source Tree Digest"
        },
        "verdict": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "evidence"
      ],
      "title": "CentralProofObservation",
      "type": "object"
    },
    "ConsumerObservation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "registered": {
                "const": true
              }
            },
            "required": [
              "registered"
            ]
          },
          "then": {
            "properties": {
              "observed_protocol_versions": {
                "minItems": 1
              },
              "observed_schema_digest": {
                "type": "string"
              }
            },
            "required": [
              "observed_schema_digest",
              "observed_protocol_versions"
            ]
          }
        }
      ],
      "properties": {
        "consumer_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Consumer Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/LinkEvidence"
        },
        "observed_protocol_versions": {
          "default": [],
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Observed Protocol Versions",
          "type": "array"
        },
        "observed_schema_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Schema Digest"
        },
        "registered": {
          "title": "Registered",
          "type": "boolean"
        },
        "registration_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Registration Ref",
          "type": "string"
        }
      },
      "required": [
        "consumer_id",
        "registration_ref",
        "registered",
        "evidence"
      ],
      "title": "ConsumerObservation",
      "type": "object"
    },
    "DeployIdentity": {
      "additionalProperties": false,
      "properties": {
        "deployed_at": {
          "format": "date-time",
          "title": "Deployed At",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/LinkEvidence"
        },
        "manifest_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Manifest Ref",
          "type": "string"
        },
        "revision": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Revision",
          "type": "string"
        },
        "tree_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Tree Digest",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "tree_digest",
        "manifest_ref",
        "deployed_at",
        "evidence"
      ],
      "title": "DeployIdentity",
      "type": "object"
    },
    "EndpointObservation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "ready": {
                "const": true
              }
            },
            "required": [
              "ready"
            ]
          },
          "then": {
            "properties": {
              "server_schema_digest": {
                "type": "string"
              }
            },
            "required": [
              "server_schema_digest"
            ]
          }
        }
      ],
      "properties": {
        "endpoint_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Endpoint Ref",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/LinkEvidence"
        },
        "protocol_versions": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Protocol Versions",
          "type": "array"
        },
        "ready": {
          "title": "Ready",
          "type": "boolean"
        },
        "server_schema_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Schema Digest"
        },
        "transport": {
          "enum": [
            "stdio",
            "streamable-http"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "endpoint_ref",
        "protocol_versions",
        "ready",
        "evidence"
      ],
      "title": "EndpointObservation",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Evidence Ref",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "owner": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Owner",
          "type": "string"
        },
        "revision": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "evidence_ref",
        "revision",
        "observed_at"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FreshnessObservation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "exact",
                  "compatible_drift"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              },
              "provider_watermark": {
                "type": "string"
              }
            },
            "required": [
              "provider_watermark",
              "evidence_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "compatible_drift",
                  "stale_readable",
                  "blocked",
                  "unknown",
                  "rollback_required"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason_codes": {
                "minItems": 1
              }
            },
            "required": [
              "reason_codes"
            ]
          }
        }
      ],
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provider_watermark": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Watermark"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "state": {
          "enum": [
            "exact",
            "compatible_drift",
            "stale_readable",
            "blocked",
            "unknown",
            "rollback_required"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "observed_at",
        "expires_at",
        "evidence_refs"
      ],
      "title": "FreshnessObservation",
      "type": "object"
    },
    "LinkEvidence": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "exact",
                  "compatible_drift"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "compatible_drift",
                  "stale_readable",
                  "blocked",
                  "unknown",
                  "rollback_required"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason_codes": {
                "minItems": 1
              }
            },
            "required": [
              "reason_codes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "rollback_required"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "state": {
          "enum": [
            "exact",
            "compatible_drift",
            "stale_readable",
            "blocked",
            "unknown",
            "rollback_required"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "observed_at",
        "evidence_refs"
      ],
      "title": "LinkEvidence",
      "type": "object"
    },
