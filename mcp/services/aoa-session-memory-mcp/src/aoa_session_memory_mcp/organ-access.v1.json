          "idempotency": "read_only",
          "maximum_blast_radius": "bounded existence and projection-freshness checks for supplied refs",
          "annotations_are_security_enforcement": false,
          "rollback_route": null
        },
        {
          "primitive_id": "inspect-entity-usage",
          "kind": "tool",
