          "input_schema_ref": "owner://aoa-session-memory/mcp/aoa_session_retrieve/input",
          "output_schema_ref": "owner://aoa-session-memory/mcp/evidence-route-packet",
          "approval_required": false,
          "idempotency": "read_only",
          "maximum_blast_radius": "one bounded retrieval recipe with resolvable evidence refs",
          "annotations_are_security_enforcement": false,
          "rollback_route": null
        },
        {
          "primitive_id": "assemble-evidence-packet",
          "kind": "tool",
          "mcp_name": "aoa_session_evidence_packet",
          "effect_class": "derive",
          "policy_family": "read",
          "input_schema_ref": "owner://aoa-session-memory/mcp/aoa_session_evidence_packet/input",
          "output_schema_ref": "owner://aoa-session-memory/mcp/evidence-route-packet",
          "approval_required": false,
          "idempotency": "read_only",
          "maximum_blast_radius": "one bounded intent packet over supplied anchors and refs",
          "annotations_are_security_enforcement": false,
          "rollback_route": null
        },
        {
          "primitive_id": "check-evidence-freshness",
          "kind": "tool",
          "mcp_name": "aoa_session_freshness_check",
          "effect_class": "validate",
          "policy_family": "read",
          "input_schema_ref": "owner://aoa-session-memory/mcp/aoa_session_freshness_check/input",
          "output_schema_ref": "owner://aoa-session-memory/mcp/freshness-packet",
