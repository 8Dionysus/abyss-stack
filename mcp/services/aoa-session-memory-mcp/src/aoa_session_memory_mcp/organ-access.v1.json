      "policy_family": "read",
      "credential_class": "session-memory-read",
      "primitives": [
        {
          "primitive_id": "plan-literal-route",
          "kind": "tool",
          "mcp_name": "aoa_session_literal_query_plan",
          "effect_class": "derive",
          "policy_family": "read",
          "input_schema_ref": "owner://aoa-session-memory/mcp/aoa_session_literal_query_plan/input",
          "output_schema_ref": "owner://aoa-session-memory/mcp/evidence-route-packet",
          "approval_required": false,
          "idempotency": "read_only",
          "maximum_blast_radius": "one bounded route plan without archive mutation",
          "annotations_are_security_enforcement": false,
          "rollback_route": null
        },
        {
          "primitive_id": "search-session-evidence",
          "kind": "tool",
          "mcp_name": "aoa_session_search",
          "effect_class": "derive",
          "policy_family": "read",
          "input_schema_ref": "owner://aoa-session-memory/mcp/aoa_session_search/input",
          "output_schema_ref": "owner://aoa-session-memory/mcp/evidence-route-packet",
          "approval_required": false,
          "idempotency": "read_only",
          "maximum_blast_radius": "one bounded projection search with explicit result budget",
          "annotations_are_security_enforcement": false,
          "rollback_route": null
        },
        {
          "primitive_id": "retrieve-session-evidence",
          "kind": "tool",
          "mcp_name": "aoa_session_retrieve",
          "effect_class": "derive",
