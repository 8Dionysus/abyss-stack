      "owner_payload_schema_ref": "owner://aoa-session-memory/mcp/evidence-route-packet",
      "task_intent_terms": ["session", "evidence", "compaction", "error", "receipt", "decision", "tool-use"],
      "eval_refs": ["eval://aoa-organ-access-admission-integrity"]
    }
