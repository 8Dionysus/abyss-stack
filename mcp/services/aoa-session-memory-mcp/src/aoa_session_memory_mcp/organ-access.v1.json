          "annotations_are_security_enforcement": false,
          "rollback_route": null
        },
        {
          "primitive_id": "open-session-index",
          "kind": "resource_template",
          "mcp_name": "aoa-session-memory://session/{session}/index",
          "effect_class": "observe",
          "policy_family": "read",
          "input_schema_ref": "owner://aoa-session-memory/mcp/session-resource/session",
          "output_schema_ref": "owner://aoa-session-memory/schema/session-index",
          "approval_required": false,
          "idempotency": "read_only",
          "maximum_blast_radius": "one bounded session index without raw transcript hydration",
          "annotations_are_security_enforcement": false,
          "rollback_route": null
        },
        {
          "primitive_id": "open-session-rehydrate",
          "kind": "resource_template",
          "mcp_name": "aoa-session-memory://session/{session}/rehydrate",
          "effect_class": "derive",
          "policy_family": "read",
          "input_schema_ref": "owner://aoa-session-memory/mcp/session-resource/session",
          "output_schema_ref": "owner://aoa-session-memory/mcp/evidence-route-packet",
          "approval_required": false,
          "idempotency": "read_only",
          "maximum_blast_radius": "one bounded rehydration packet with raw and segment refs",
          "annotations_are_security_enforcement": false,
          "rollback_route": null
