  "access_strategy": {
    "tools_for": ["query planning", "bounded search", "typed retrieval", "freshness validation"],
    "resource_templates_for": ["known-session brief", "manifest", "index", "rehydration packet"],
    "bulk_index_loading_allowed": false,
    "raw_transcript_default_allowed": false
  },
  "contains_secrets": false,
  "admission_asserted": false,
  "registry_mutation_authorized": false,
  "effect_activation_authorized": false
}
