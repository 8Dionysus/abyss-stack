{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abyss.local/schemas/aoa-session-memory/organ-access-v1.json",
  "title": "AoA session-memory owner access manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "organ_id",
    "owner_decision_ref",
    "capabilities",
    "access_strategy",
    "contains_secrets",
    "admission_asserted",
    "registry_mutation_authorized",
    "effect_activation_authorized"
  ],
  "properties": {
    "schema_version": {"const": "aoa_session_memory_organ_access_v1"},
    "organ_id": {"const": "aoa-session-memory"},
    "owner_decision_ref": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "access_strategy": {"$ref": "#/$defs/access_strategy"},
    "contains_secrets": {"const": false},
    "admission_asserted": {"const": false},
    "registry_mutation_authorized": {"const": false},
    "effect_activation_authorized": {"const": false}
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "string_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitive_id",
        "kind",
        "mcp_name",
        "effect_class",
        "policy_family",
        "input_schema_ref",
        "output_schema_ref",
        "approval_required",
        "idempotency",
        "maximum_blast_radius",
        "annotations_are_security_enforcement",
        "rollback_route"
      ],
      "properties": {
        "primitive_id": {"$ref": "#/$defs/non_empty_string"},
        "kind": {"enum": ["tool", "resource_template"]},
        "mcp_name": {"$ref": "#/$defs/non_empty_string"},
        "effect_class": {"enum": ["observe", "derive", "validate"]},
        "policy_family": {"const": "read"},
        "input_schema_ref": {"$ref": "#/$defs/non_empty_string"},
        "output_schema_ref": {"$ref": "#/$defs/non_empty_string"},
        "approval_required": {"const": false},
        "idempotency": {"const": "read_only"},
        "maximum_blast_radius": {"$ref": "#/$defs/non_empty_string"},
        "annotations_are_security_enforcement": {"const": false},
        "rollback_route": {"type": "null"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "summary",
        "policy_family",
        "credential_class",
        "primitives",
        "owner_payload_schema_ref",
        "task_intent_terms",
        "eval_refs"
      ],
      "properties": {
        "capability_id": {"const": "session-evidence-read"},
        "summary": {"$ref": "#/$defs/non_empty_string"},
        "policy_family": {"const": "read"},
        "credential_class": {"const": "session-memory-read"},
        "primitives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/primitive"}
        },
        "owner_payload_schema_ref": {"$ref": "#/$defs/non_empty_string"},
        "task_intent_terms": {"$ref": "#/$defs/string_list"},
        "eval_refs": {"$ref": "#/$defs/string_list"}
      }
    },
    "access_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools_for",
        "resource_templates_for",
        "bulk_index_loading_allowed",
        "raw_transcript_default_allowed"
      ],
      "properties": {
        "tools_for": {"$ref": "#/$defs/string_list"},
        "resource_templates_for": {"$ref": "#/$defs/string_list"},
        "bulk_index_loading_allowed": {"const": false},
        "raw_transcript_default_allowed": {"const": false}
      }
    }
  }
}
